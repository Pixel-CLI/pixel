#!/bin/sh
# SPDX-FileCopyrightText: The Pixel contributors
# SPDX-License-Identifier: MIT

# A cheap local compile proves the candidate builds before the remote mutation
# gate spends a runner on it. Mutation coverage is then proved off this machine:
# the gate
# script bundles the committed diff to the gate host (PIXEL_MUTANTS_GATE_HOST,
# default a2) where the campaign runs against a warm target/, and the push is
# blocked on the remote verdict. Nothing mutant-related compiles or runs
# locally; CI's Mutants in diff remains the required merge gate.
set -eu

repo=$(git rev-parse --show-toplevel) || exit 0

# Fetch before any expensive validation. The fetched head is the base both the
# review gate and the mutation gate must judge against; a local `main` may be
# stale even when its name still resolves.
if ! git fetch --quiet origin HEAD 2>/dev/null; then
    echo "pre-push: could not fetch origin's current default; refusing to verify"
    exit 1
fi
tip=$(git rev-parse --verify --quiet FETCH_HEAD) || {
    echo "pre-push: could not resolve origin's fetched default; refusing to verify"
    exit 1
}
if [ "$(git merge-base HEAD FETCH_HEAD)" != "$tip" ]; then
    echo "pre-push: HEAD is not rebased on the fetched origin default:"
    echo "  git fetch origin HEAD && git rebase FETCH_HEAD"
    exit 1
fi

# A Rust source change gets an immediate local baseline. This stops a compile
# failure from being reported later as a mutation baseline failure; docs and
# scripts retain their fast push path.
if git diff --name-only "$tip...HEAD" | grep -Eq '^crates/.*\.rs$'; then
    if ! cargo check --all-targets; then
        echo "pre-push: cargo check --all-targets failed; fix the baseline before the mutation gate" >&2
        exit 1
    fi
fi

PIXEL_MUTANTS_BASE="$tip" "$repo/scripts/mutants-remote-gate.sh"

# review-gate: the branch must sit on the freshest remote default and the
# deterministic review must hold no BLOCKER or CONCERN finding. Skipped when
# the installed pixel predates the command.
if command -v pixel >/dev/null 2>&1 && pixel review-gate --help >/dev/null 2>&1; then
    if [ "$(git merge-base HEAD FETCH_HEAD)" != "$tip" ]; then
        echo "pre-push: HEAD is not rebased on the fetched origin default:"
        echo "  git fetch origin HEAD && git rebase FETCH_HEAD"
        exit 1
    fi
    if ! pixel review-gate . --fail-on concern; then
        echo "pre-push: review-gate findings at CONCERN or above — fix them, or push --no-verify"
        exit 1
    fi
fi
