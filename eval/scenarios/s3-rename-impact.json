{
  "id": "s3-rename-impact",
  "kind": "rename-impact",
  "prompt": "If we rename bounded_output, what breaks?",
  "must": [
    {"pattern": "pixel-setup/src/doctor\\.rs", "points": 4, "why": "all references live in one file"},
    {"pattern": "shell_path_check_within", "points": 2, "why": "the sole production caller"},
    {"pattern": "3030|bounded_output_times_out", "points": 2, "why": "the test call site and its name"},
    {"pattern": "1585", "points": 1, "why": "definition line"},
    {"pattern": "1675", "points": 1, "why": "production call line"},
    {"pattern": "mutants::skip|timing-equivalent", "points": 1, "why": "the attribute/comment that travels with it"},
    {"pattern": "private|no `pub`|not `pub`|not pub", "points": 1, "why": "no cross-crate blast radius"}
  ],
  "never": [
    {"pattern": "pixel-(recall|daemon|git|proto|rank)/src[^\n]{0,60}bounded_output", "penalty": 2, "why": "no other crate references it at HEAD"}
  ]
}
