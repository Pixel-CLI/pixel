{
  "id": "s1-hook-install",
  "kind": "how-does-X-work",
  "prompt": "How does pixel decide which hook entries to write into ~/.claude/settings.json during install?",
  "must": [
    {"pattern": "pixel-setup/src/routing\\.rs", "points": 3, "why": "mechanism location"},
    {"pattern": "configure_scoped", "points": 3, "why": "the function that writes the entries"},
    {"pattern": "session-start", "points": 1, "why": "lifecycle verb written for claude"},
    {"pattern": "prompt-submit", "points": 1, "why": "lifecycle verb written for claude"},
    {"pattern": "post-compaction", "points": 1, "why": "lifecycle verb written for claude"},
    {"pattern": "metrics", "points": 1, "why": "claude-only Bash relay"},
    {"pattern": "remove_pixel_hooks", "points": 2, "why": "dedupe/replace-not-stack story"},
    {"pattern": "LifecycleOnly", "points": 2, "why": "global scope is lifecycle-only, no guard"},
    {"pattern": "settings\\.local\\.json", "points": 1, "why": "the PreToolUse guard is repo-local"},
    {"pattern": "HOOK_TIMEOUT|\"timeout\"[: ]+10", "points": 1, "why": "entry shape"}
  ],
  "never": [
    {"pattern": "PreToolUse guard to `?~/.claude/settings\\.json", "penalty": 2, "why": "the global install never writes the guard to the home file"}
  ]
}
