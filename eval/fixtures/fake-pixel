#!/usr/bin/env python3
"""Offline stand-in for the pixel binary run.sh drives (PIXEL_BIN).

Covers exactly the calls the harness makes, with the side effects that
matter to arm isolation, and logs each call to $FAKE_PIXEL_LOG:

  --version                        a fixed version line
  build-index --history <dir>      creates <dir>/.pixel
  prepare-repo --no-daemon <dir>   adds the graph file
  install --repo <wt>              the repo-local install: a Claude guard in
                                   .claude/settings.local.json, a Codex
                                   session-start + composed-guard hooks.json,
                                   the AGENTS.md block, an AGENTS.md backup
                                   (run.sh must delete it) and one line
                                   appended to the shared info/exclude
                                   (run.sh must restore it)
  daemon stop <dir>                no-op
  search-content ...               one `path:line` hit
"""
import json
import os
import subprocess
import sys
from pathlib import Path

BEGIN, END = "<!-- pixel:warp-retrieval:begin -->", "<!-- pixel:warp-retrieval:end -->"


def main():
    argv = sys.argv[1:]
    log = os.environ.get("FAKE_PIXEL_LOG")
    if log:
        with open(log, "a") as f:
            f.write(json.dumps(argv) + "\n")
    if argv[:1] == ["--version"]:
        print("pixel 0.0.0-fixture")
    elif argv[:1] == ["build-index"]:
        root = Path(argv[-1])
        (root / ".pixel").mkdir(exist_ok=True)
        (root / ".pixel/state.json").write_text('{"fixture": true}\n')
    elif argv[:1] == ["prepare-repo"]:
        (Path(argv[-1]) / ".pixel/graph.v2.db").write_text("graph\n")
    elif argv[:2] == ["install", "--repo"]:
        wt = Path(argv[2])
        me = os.path.abspath(sys.argv[0])
        (wt / ".claude").mkdir(exist_ok=True)
        (wt / ".claude/settings.local.json").write_text(json.dumps({"hooks": {"PreToolUse": [
            {"matcher": "Bash|Read|Grep", "hooks": [{"type": "command", "command": f"'{me}' run-hook guard --provider claude"}]}]}}))
        (wt / ".codex").mkdir(exist_ok=True)
        (wt / ".codex/hooks.json").write_text(json.dumps({"hooks": {
            "SessionStart": [{"hooks": [{"type": "command", "command": f"'{me}' run-hook session-start --provider codex"}]}],
            "PreToolUse": [{"hooks": [{"type": "command", "command": f"'{me}' run-hook composed-guard --provider codex"}]}]}}))
        agents = wt / "AGENTS.md"
        text = agents.read_text() if agents.exists() else ""
        (wt / "AGENTS.md.pixel-bak.1-0").write_text(text)
        if BEGIN not in text:
            agents.write_text(text + f"\n{BEGIN}\nRetrieval starts with Pixel.\n{END}\n")
        exclude = subprocess.run(["git", "-C", str(wt), "rev-parse", "--path-format=absolute", "--git-path", "info/exclude"],
                                 capture_output=True, text=True, check=True).stdout.strip()
        Path(exclude).parent.mkdir(parents=True, exist_ok=True)
        with open(exclude, "a") as f:
            f.write("/.claude/settings.local.json\n")
    elif argv[:1] == ["search-content"]:
        print("src/lib.rs:3:pub const NEEDLE: u32 = 1;")


if __name__ == "__main__":
    main()
