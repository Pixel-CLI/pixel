"""Quote matching Markdown/reStructuredText sections for explanatory questions. Source navigation is left to code
packs. Rank by prompt overlap, keep the top two sections, omit already quoted rows and mark excerpt truncation.
Read-only and deterministic (score, path, line). Issues #906, #1200, #1234."""
import json
import math
import re
import subprocess
import sys
from pathlib import Path

STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "the", "and", "how", "is", "a", "of", "it",
        "defined", "define", "number", "returns", "return", "set", "get", "use", "used", "make", "could", "there",
        "keep", "keeps", "change", "changes", "behaves", "behave", "when", "should", "would", "about", "have", "for",
        "its", "are", "not", "you", "can", "any", "all", "but", "was", "has", "our", "your", "into", "than"}
GENERIC = {"file", "files", "code", "line", "thing", "error", "work", "works", "time", "name", "value"}
SKIP = re.compile(r"(^|/)(CHANGELOG|HISTORY|LICENSE|NOTICE|CODE_OF_CONDUCT|node_modules|vendor|website|bench)", re.I)
MAX_FILES, MAX_BYTES, MIN_WORDS, SHOWN, WINDOW, BODY_LINES, LINE_CHARS = 60, 400_000, 2, 2, 40, 80, 160


def stem(word):
    word = word.lower()
    for suffix in ("ing", "es", "s"):
        if len(word) > 4 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def words(text):
    return {stem(w) for w in re.findall(r"[A-Za-z]{3,}", text) if w.lower() not in STOP | GENERIC}


RST_RULE = re.compile(r"""^([=\-~^*+#"'`:.])\1{2,}\s*$""")


def sections(lines, path=""):
    """``[(start, end, heading)]`` (1-based, inclusive) of the heading sections of a Markdown file, or of a
    reStructuredText one, whose titles are underlined (``Title`` then ``=====`` at least as long)."""
    if path.endswith(".rst"):
        heads = [(i + 1, line.strip()) for i, line in enumerate(lines[:-1])
                 if line.strip() and not RST_RULE.match(line) and RST_RULE.match(lines[i + 1])
                 and len(lines[i + 1].rstrip()) >= len(line.rstrip())]
    else:
        heads = [(i + 1, line.lstrip("# ").strip()) for i, line in enumerate(lines)
                 if re.match(r"#{1,4} \S", line)]
    out = []
    for k, (start, title) in enumerate(heads):
        end = heads[k + 1][0] - 1 if k + 1 < len(heads) else len(lines)
        out.append((start, end, title))
    return out


def source_question(req):
    """A source-navigation intent vetoes docs; weak kinds can still ask about code."""
    kind = req.get("kind")
    if kind in ("lookup", "tests", "impact", None):
        return True
    if kind in ("overview", "config"):
        return False
    return bool(re.search(r"\b(?:constants?|callers?|callees?)\b|\b[a-z][a-z0-9]*(?:_[a-z0-9]+)+\b",
                          req["prompt"], re.I))


def quoted_lines(brief):
    """Numbered source rows already quoted, with their header's file and bounds."""
    held, current = {}, None
    for line in brief.splitlines():
        if line.startswith("### "):
            current = re.match(r"^### ([\w@+./-]+):(\d+)(?:-(\d+))?(?:[ —:]|$)", line)
        elif current and (row := re.match(r"^(\d+)\|", line)):
            n = int(row[1])
            if int(current[2]) <= n <= int(current[3] or current[2]):
                held.setdefault(current[1], set()).add(n)
    return held


def novel_ranges(first, last, held):
    """Consecutive ranges not already quoted; each excerpt stops before a held row."""
    ranges, start = [], None
    for n in range(first, last + 2):
        if n <= last and n not in held:
            if start is None:
                start = n
        elif start is not None:
            ranges.append((start, n - 1))
            start = None
    return ranges


def main():
    req = json.load(sys.stdin)
    if source_question(req):
        return
    root, prompt = req["repo_root"], req["prompt"]
    want = words(prompt)
    if len(want) < MIN_WORDS:
        return
    tracked = subprocess.run(["git", "-C", root, "ls-files", "-z", "--", "*.md", "*.mdx", "*.rst"], capture_output=True,
                             text=True, timeout=10).stdout.split("\0")
    paths = sorted(p for p in tracked if p and not SKIP.search(p) and (p.count("/") <= 2))[:MAX_FILES]
    docs = []   # (path, start, end, title, words of the heading and its first paragraph)
    for path in paths:
        file = Path(root) / path
        try:
            if file.stat().st_size > MAX_BYTES:
                continue
            lines = file.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for start, end, title in sections(lines, path):
            head = " ".join([title] + [l for l in lines[start:start + 12] if l.strip()][:4])
            docs.append((path, start, end, title, words(head)))
    # A word that heads most sections (the project's own name) says little: weigh by how few sections carry it.
    df = {}
    for *_, ws in docs:
        for w in ws:
            df[w] = df.get(w, 0) + 1
    weight = {w: math.log((len(docs) + 1) / df[w]) for w in want if w in df}
    found = []
    for path, start, end, title, ws in docs:
        hits = want & ws
        if len(hits) >= MIN_WORDS:
            score = sum(weight[w] for w in hits)
            found.append((-round(score, 3), path, start, end, title))
    found.sort()
    shown = 0
    held = quoted_lines(req.get("brief", ""))
    for _, path, start, end, title in found:
        if shown >= SHOWN:
            break
        lines = (Path(root) / path).read_text(errors="replace").splitlines()
        first = max(1, start - 0)
        last = min(len(lines), end, start + BODY_LINES + WINDOW)
        ranges = novel_ranges(first, last, held.get(path, set()))
        for lo, hi in ranges:
            print(f"### {path}:{lo}-{hi} — {title} (documentation section)")
            for i in range(lo, hi + 1):
                line = lines[i - 1]
                text = line if len(line) <= LINE_CHARS else line[:LINE_CHARS] + " … [truncated]"
                print(f"{i}| {text}")
            held.setdefault(path, set()).update(range(lo, hi + 1))
        if ranges and last < end:
            print(f"excerpt truncated: section continues after line {last} (ends at {end})")
        shown += 1


main()
