"""cand-j-callers: 'where is X defined, who calls it, which tests cover it' needs the callers, not the callees.
X is the identifier-shaped word of the question that the symbol graph resolves to a function. The probe shows the
callers (their body when short, else the window around the call) and the call sites of those callers, the tests
among the callers, the test helpers named after X (`X_raw`), and the tests that set what X reads: the ALLCAPS
environment names in its body and doc comment, looked up in the test files. Unrelated test blocks of the brief
are dropped. Needs `pixel` (PIXEL_BIN, else PATH) and its daemon. Read-only, deterministic, no network."""
import ast
import json
import os
import re
import selectors
import stat
import subprocess
import sys
import time
from pathlib import Path

TESTPATH = re.compile(r'(^|/)(tests?|__tests__|spec|testdata)/|[._-](test|spec)s?\.\w+$|(^|/)test_\w+\.\w+$|_tests?\.\w+$')
SRC = re.compile(r'\.(rs|py|js|jsx|ts|tsx|go|java|kt|c|h|cc|cpp|hpp|rb|php|swift|cs|scala|sh|lua)$')
DECL = re.compile(r'^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+|unsafe\s+|const\s+|extern\s+"[^"]*"\s+|static\s+|export\s+|default\s+)*(?:fn|def|function|func)\s+([A-Za-z_]\w*)|^\s*(?:[A-Za-z_]\w*!)\(\s*([A-Za-z_]\w*)\s*,\s*(?:\||move\s*\||\{|fn\b)|^\s*(?:test|it|describe)\(\s*[\'"`]([^\'"`]+)')
IDENT = re.compile(r'`([A-Za-z_]\w*)(?:\(\))?`|\b([a-z][a-z0-9]*(?:_[a-z0-9]+)+)\b|\b([a-z]+[A-Z][A-Za-z0-9]*)\b|\b([A-Z][a-z0-9]+(?:[A-Z][a-z0-9]*)+)\b')
ENV = re.compile(r'\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\b')
BODY_CAP, SITE_CONTEXT, MAX_CALLERS, MAX_SITES, MAX_TESTS, MAX_FILES = 40, 8, 6, 3, 3, 4000
MAX_FILE_BYTES = 300_000
SEMANTIC_CAP_BYTES = 6_500
MAX_SOURCE_FILES = 1_200
MAX_SOURCE_BYTES = 12 * 1024 * 1024
MAX_TRACKED_LIST_BYTES = 4 * 1024 * 1024
MAX_SOURCE_SCAN_MS = 1_000
MAX_EXPORT_CACHE_ENTRIES = 8_192


def pixel(root, *args):
    exe = os.environ.get('PIXEL_BIN') or 'pixel'
    try:
        return subprocess.run([exe, *args, '--metrics', 'off'], cwd=root, capture_output=True, text=True, timeout=8).stdout
    except (OSError, subprocess.SubprocessError):
        return ''


def jpixel(root, *args):
    try:
        return json.loads(pixel(root, *args, '--json') or '{}')
    except ValueError:
        return {}


def read(root, path):
    directory_fd = None
    file_fd = None
    try:
        relative = Path(path)
        nofollow = getattr(os, 'O_NOFOLLOW', None)
        if nofollow is None or relative.is_absolute() or not relative.parts or any(
            part in ('', '.', '..') for part in relative.parts
        ):
            return []
        directory_fd = os.open(Path(root).resolve(), os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
        for part in relative.parts[:-1]:
            next_fd = os.open(
                part,
                os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | nofollow,
                dir_fd=directory_fd,
            )
            os.close(directory_fd)
            directory_fd = next_fd
        file_fd = os.open(
            relative.parts[-1],
            os.O_RDONLY | nofollow | getattr(os, 'O_NONBLOCK', 0),
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE_BYTES:
            return []
        chunks, total = [], 0
        while total <= MAX_FILE_BYTES:
            chunk = os.read(file_fd, MAX_FILE_BYTES + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > MAX_FILE_BYTES:
            return []
        return b''.join(chunks).decode(errors='replace').splitlines()
    except (OSError, RuntimeError):
        return []
    finally:
        if file_fd is not None:
            os.close(file_fd)
        if directory_fd is not None:
            os.close(directory_fd)


def edges(root, uid, role):
    out, offset = [], 0
    while offset <= 100:
        data = jpixel(root, 'who-calls', '--role', role, '--offset', str(offset), uid, '.')
        got = data.get('edges', [])
        out += got
        if len(got) < data.get('edge_limit', 20):
            break
        offset += len(got)
    return out


def resolve(root, prompt, brief):
    """The function the question names: the first identifier-shaped word that the graph resolves to a function."""
    seen = []
    for m in IDENT.finditer(prompt):
        word = next(g for g in m.groups() if g)
        if word not in seen:
            seen.append(word)
    shown = set(re.findall(r'^### (\S+?):\d+-\d+', brief, re.M))
    for word in seen:
        rows = [s for s in jpixel(root, 'find-symbol', word, '.').get('symbols', []) if s.get('kind') in ('function', 'method') and s.get('name') == word]
        if rows:
            rows.sort(key=lambda s: (s['path'] not in shown, s['path'], s['start_line']))
            return rows[0]
    return None


def unit_around(lines, n, cap):
    """The declaration around line ``n`` (1-based): ``(first, last)`` or ``None`` when none is within reach."""
    start = None
    for i in range(n - 1, max(-1, n - 80), -1):
        if DECL.match(lines[i]):
            start = i
            break
    if start is None:
        return None
    s = start
    while s > 0 and re.match(r'\s*(//|#\[|#\s|/\*|\*|@)', lines[s - 1]):
        s -= 1
    depth, seen, end = 0, False, None
    for j in range(start, min(len(lines), start + 300)):
        for ch in re.sub(r'"(\\.|[^"\\])*"|\'(\\.|[^\'\\])\'|//.*$', '', lines[j]):
            if ch == '{':
                depth, seen = depth + 1, True
            elif ch == '}':
                depth -= 1
        if seen and depth <= 0:
            end = j
            break
    if end is None or end < n - 1:
        return None
    return s + 1, min(end + 1, s + cap)


def tracked_source(root, prompt=''):
    """Read one bounded snapshot, prioritizing tracked paths matching query terms."""
    deadline = time.monotonic() + MAX_SOURCE_SCAN_MS / 1000
    partial = False
    process = None
    output = bytearray()
    try:
        process = subprocess.Popen(['git', 'ls-files', '-z'], cwd=root, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL)
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if not selector.select(min(0.05, max(0.0, deadline - time.monotonic()))):
                    if process.poll() is not None:
                        break
                    continue
                chunk = os.read(process.stdout.fileno(), min(64 * 1024, MAX_TRACKED_LIST_BYTES + 1 - len(output)))
                if not chunk:
                    break
                output.extend(chunk)
                if len(output) > MAX_TRACKED_LIST_BYTES:
                    partial = True
                    process.kill()
                    break
            if time.monotonic() >= deadline:
                partial = True
                process.kill()
        try:
            process.wait(timeout=0.05)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
            partial = True
        process.stdout.close()
        if process.returncode not in (0, None):
            partial = True
    except (OSError, subprocess.SubprocessError, ValueError):
        if process is not None:
            if process.poll() is None:
                process.kill()
                process.wait()
            if process.stdout is not None:
                process.stdout.close()
        return {}, True

    complete_output = bytes(output).rsplit(b'\0', 1)[0]
    paths = [p for p in complete_output.decode(errors='replace').split('\0') if p]
    source_paths = [p for p in paths if SRC.search(p) or re.search(r'(^|/)(?:tsconfig|jsconfig)[^/]*\.json$', p)]
    query_terms = set(re.findall(r'[a-z]+', re.sub(r'([a-z0-9])([A-Z])', r'\1 \2', prompt).lower()))
    query_terms -= {'a', 'an', 'and', 'are', 'as', 'at', 'be', 'by', 'can', 'change', 'for', 'from', 'how', 'i',
                    'if', 'in', 'is', 'it', 'me', 'of', 'on', 'or', 'the', 'this', 'to', 'what', 'which', 'who',
                    'call', 'calls', 'calling', 'caller', 'callers', 'function', 'functions', 'module', 'modules',
                    'code', 'parts', 'show', 'locate', 'where', 'fresh', 'new', 'create', 'creates', 'created',
                    'generate', 'generated', 'generator'}
    if query_terms:
        source_paths.sort(key=lambda path: (-len(query_terms & set(re.findall(
            r'[a-z]+', re.sub(r'([a-z0-9])([A-Z])', r'\1 \2', path).lower()
        ))), path))
    if len(source_paths) > MAX_SOURCE_FILES:
        source_paths = source_paths[:MAX_SOURCE_FILES]
        partial = True
    texts, total_bytes = {}, 0
    for path in source_paths:
        if time.monotonic() >= deadline:
            partial = True
            break
        lines = read(root, path)
        size = sum(len(line.encode('utf-8')) + 1 for line in lines)
        if total_bytes + size > MAX_SOURCE_BYTES:
            partial = True
            break
        texts[path] = lines
        total_bytes += size
    if len(source_paths) > len(texts):
        partial = True
    return texts, partial


SOURCE_EXTENSIONS = ('.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs', '.mts', '.cts', '.rs', '.py', '.go', '.rb')
IMPORT_BLOCK = re.compile(r'\bimport\s*\{([^}]+)\}\s*from\s*([\'\"])([^\'\"]+)\2', re.S)


def module_candidates(path, texts):
    """Resolve a source module to already tracked files; never probe outside the snapshot."""
    path = Path(path).as_posix()
    options = [path]
    if not Path(path).suffix:
        options.extend(path + ext for ext in SOURCE_EXTENSIONS)
        options.extend(f'{path}/index{ext}' for ext in SOURCE_EXTENSIONS)
    return [candidate for candidate in dict.fromkeys(options) if candidate in texts]


def resolve_module_import(importer, specifier, texts):
    """Resolve relative imports and configured TypeScript path aliases within the snapshot."""
    if specifier.startswith('.'):
        path = os.path.normpath(os.path.join(os.path.dirname(importer), specifier))
        return module_candidates(path, texts)
    found = []
    for config_path, config_lines in texts.items():
        if not re.search(r'(^|/)(?:tsconfig|jsconfig)[^/]*\.json$', config_path):
            continue
        try:
            config = json.loads('\n'.join(config_lines))
        except (ValueError, TypeError):
            continue
        options = config.get('compilerOptions', {})
        aliases = options.get('paths', {})
        base = os.path.normpath(os.path.join(os.path.dirname(config_path), options.get('baseUrl', '.')))
        for pattern, replacements in aliases.items():
            if '*' in pattern:
                before, after = pattern.split('*', 1)
                if not specifier.startswith(before) or not specifier.endswith(after):
                    continue
                middle = specifier[len(before):len(specifier)-len(after) if after else None]
            elif specifier == pattern:
                middle = None
            else:
                continue
            for replacement in replacements:
                target = replacement.replace('*', middle or '')
                candidate = os.path.normpath(os.path.join(base, target))
                found.extend(module_candidates(candidate, texts))
    return list(dict.fromkeys(found))


def module_exports_name(path, exported_name, factory_path, texts, factory_name, seen=None, cache=None):
    """Follow source export statements until the exact tracked factory file is proven."""
    if seen is None:
        # Cache only a completed root walk; a recursive cycle hit is local to
        # its current stack and must not poison another import's result.
        key = (path, exported_name, factory_path, factory_name)
        if cache is not None and key in cache:
            return cache[key]
        result = module_exports_name(path, exported_name, factory_path, texts, factory_name,
                                     set(), cache)
        if cache is not None and len(cache) < MAX_EXPORT_CACHE_ENTRIES:
            cache[key] = result
        return result
    if path == factory_path:
        source = '\n'.join(texts.get(path, []))
        code = javascript_code_mask(source)
        direct = exported_name == factory_name and re.search(
            r'\bexport\s+(?:const|let|var|function|class)\s+' + re.escape(factory_name) + r'\b', code)
        for match in re.finditer(r'\bexport\s*\{([^}]+)\}', code, re.S):
            if re.match(r'\s*from\b', code[match.end():]):
                continue
            for entry in match.group(1).split(','):
                names = re.split(r'\s+as\s+', entry.strip())
                local, public = names[0].strip(), names[-1].strip()
                if local == factory_name and public == exported_name:
                    return True
        return bool(direct)
    state = (path, exported_name)
    if state in seen or path not in texts:
        return False
    seen.add(state)
    source = '\n'.join(texts[path])
    code = javascript_code_mask(source)
    for match in re.finditer(r'\bexport\s*\{([^}]+)\}\s*from\b', code, re.S):
        specifier = re.match(r'\s*([\'\"])([^\'\"]+)\1', source[match.end():])
        if not specifier:
            continue
        for entry in match.group(1).split(','):
            parts = re.split(r'\s+as\s+', entry.strip())
            source_name = parts[0].strip()
            public_name = parts[-1].strip()
            if public_name == exported_name:
                for target in resolve_module_import(path, specifier.group(2), texts):
                    if module_exports_name(target, source_name, factory_path, texts, factory_name, seen, cache):
                        return True
    for match in re.finditer(r'\bexport\s*\*\s*from\b', code):
        specifier = re.match(r'\s*([\'\"])([^\'\"]+)\1', source[match.end():])
        if not specifier:
            continue
        for target in resolve_module_import(path, specifier.group(2), texts):
            if module_exports_name(target, exported_name, factory_path, texts, factory_name, seen, cache):
                return True
    return False


def imported_local_names(path, lines, factory_name, factory_path, texts, masked_source=None, export_cache=None):
    """Return local import names whose module export resolves to the unique factory."""
    source = '\n'.join(lines)
    code = javascript_code_mask(source) if masked_source is None else masked_source
    aliases, import_spans = set(), []
    for match in IMPORT_BLOCK.finditer(source):
        code_import = re.match(r'import\s*\{([^}]+)\}\s*from\s*', code[match.start():])
        if not code_import:
            continue
        import_spans.append(match.span())
        targets = resolve_module_import(path, match.group(3), texts)
        entries = [entry.strip() for entry in code_import.group(1).split(',')]
        for entry in entries:
            names = re.split(r'\s+as\s+', entry)
            imported = names[0].strip()
            local = names[-1].strip()
            if any(module_exports_name(target, imported, factory_path, texts, factory_name,
                                       cache=export_cache) for target in targets):
                aliases.add(local)
    if not aliases:
        return set()
    for start, end in sorted(import_spans, reverse=True):
        source = source[:start] + ' ' * (end - start) + source[end:]
    for alias in tuple(aliases):
        if re.search(r'\b(?:const|let|var|function|class)\s+' + re.escape(alias) + r'\b', source):
            aliases.remove(alias)
    return aliases


def javascript_code_mask(source):
    """Blank JS comments and strings while preserving offsets and line breaks."""
    out = list(source)
    state, i, n = 'code', 0, len(source)
    while i < n:
        if state == 'code':
            if source.startswith('//', i):
                state = 'line'
                out[i] = out[i + 1] = ' '
                i += 2
                continue
            if source.startswith('/*', i):
                state = 'block'
                out[i] = out[i + 1] = ' '
                i += 2
                continue
            if source[i] in ('"', "'", '`'):
                state = source[i]
                out[i] = ' '
                i += 1
                continue
        elif state == 'line':
            if source[i] == '\n':
                state = 'code'
            else:
                out[i] = ' '
        elif state == 'block':
            if source.startswith('*/', i):
                out[i] = out[i + 1] = ' '
                i += 2
                state = 'code'
                continue
            if source[i] != '\n':
                out[i] = ' '
        else:
            if source[i] == '\\':
                out[i] = ' '
                if i + 1 < n and source[i + 1] != '\n':
                    out[i + 1] = ' '
                i += 2
                continue
            if source[i] == state:
                state = 'code'
            elif source[i] != '\n':
                out[i] = ' '
        i += 1
    return ''.join(out)


def javascript_braces(mask):
    stack, matches = [], {}
    for pos, char in enumerate(mask):
        if char == '{':
            stack.append(pos)
        elif char == '}' and stack:
            matches[stack.pop()] = pos
    return matches


def top_level(mask, position):
    depth = 0
    for char in mask[:position]:
        if char == '{':
            depth += 1
        elif char == '}':
            depth = max(0, depth - 1)
    return depth == 0


def assigned_functions(source, receiver):
    """Return direct top-level receiver.method=function bodies with exact object ownership."""
    mask = javascript_code_mask(source)
    braces = javascript_braces(mask)
    pattern = re.compile(r'\b' + re.escape(receiver) + r'\s*\.\s*([A-Za-z_$][\w$]*)\s*=\s*(?:' +
                         re.escape(receiver) + r'\s*\.\s*[A-Za-z_$][\w$]*\s*=\s*)?function\b')
    out = []
    for match in pattern.finditer(mask):
        if not top_level(mask, match.start()):
            continue
        opening = mask.find('{', match.end())
        closing = braces.get(opening)
        if opening < 0 or closing is None:
            continue
        out.append((match.group(1), match.start(), closing + 1, mask[opening + 1:closing]))
    return mask, out


def proven_getter_functions(source, receiver, queried_method):
    """Return getter bodies only when a local helper defines them on that exact receiver."""
    mask = javascript_code_mask(source)
    helper_pattern = re.compile(r'\bfunction\s+([A-Za-z_$][\w$]*)\s*\(\s*([A-Za-z_$][\w$]*)\s*,\s*'
                                r'([A-Za-z_$][\w$]*)\s*,\s*([A-Za-z_$][\w$]*)\s*\)\s*\{')
    helpers = []
    braces = javascript_braces(mask)
    for match in helper_pattern.finditer(mask):
        if not top_level(mask, match.start()):
            continue
        opening = mask.find('{', match.end() - 1)
        closing = braces.get(opening)
        if opening < 0 or closing is None:
            continue
        obj, name, getter = match.group(2), match.group(3), match.group(4)
        body = mask[opening + 1:closing]
        defines_receiver = re.search(r'Object\s*\.\s*defineProperty\s*\(\s*' + re.escape(obj) +
                                     r'\s*,\s*' + re.escape(name) + r'\s*,\s*\{[\s\S]*?\bget\s*:\s*' +
                                     re.escape(getter) + r'\b', body)
        if defines_receiver:
            helpers.append((match.group(1), obj, name, getter))
    out = []
    for helper, _obj, _name, _getter in helpers:
        call = re.compile(r'\b' + re.escape(helper) + r'\s*\(\s*' + re.escape(receiver) +
                          r'\s*,\s*([\'\"])([A-Za-z_$][\w$]*)\1\s*,\s*function\b')
        for match in call.finditer(source):
            code_call = re.match(r'\b' + re.escape(helper) + r'\s*\(\s*' + re.escape(receiver) + r'\s*,\s*',
                                 mask[match.start():])
            if not code_call or not top_level(mask, match.start()) or match.group(2) == queried_method:
                continue
            opening = mask.find('{', match.end())
            closing = braces.get(opening)
            if opening >= 0 and closing is not None and re.search(
                r'\bthis\s*\.\s*' + re.escape(queried_method) + r'\s*\(', mask[opening + 1:closing]
            ):
                out.append((match.group(2), match.start(), closing + 1))
    return out


def export_name_edges(texts):
    """Parse supported named re-exports once into a lexical rename graph."""
    edges = {}
    identifier = re.compile(r'[A-Za-z_$][\w$]*\Z')
    named_export = re.compile(r'\bexport\s*\{([^}]+)\}', re.S)
    for path, source in texts.items():
        if Path(path).suffix.lower() not in ('.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts'):
            continue
        if 'export' not in source:
            continue
        # Parse raw text here: comments and strings may add false edges, but
        # this candidate closure is a superset filter only. The later importer
        # and module-export checks remain responsible for proof.
        for match in named_export.finditer(source):
            for entry in match.group(1).split(','):
                names = re.split(r'\s+as\s+', entry.strip())
                source_name, public_name = names[0].strip(), names[-1].strip()
                if identifier.fullmatch(source_name) and identifier.fullmatch(public_name):
                    edges.setdefault(source_name, set()).add(public_name)
    return edges


def export_name_candidates(factory_name, edges):
    """Return a lexical superset; final module provenance is checked later."""
    reachable, pending = {factory_name}, [factory_name]
    while pending:
        source_name = pending.pop()
        for public_name in edges.get(source_name, ()):
            if public_name not in reachable:
                reachable.add(public_name)
                pending.append(public_name)
    return reachable


def semantic_caller_blocks(prompt, texts, partial=False):
    """Recover explicit source-level caller shapes when the graph has no resolvable name."""
    intent = bool(re.search(r'(?i)\b(who|which|what|where|modules?|parts?|code|callers?|calls?|invoke|uses?)\b', prompt))
    words = set(re.findall(r'[a-z]+', prompt.lower()))
    if 'requestcontext' in words:
        words.update({'request', 'context'})
    if 'pushed' in words:
        words.add('push')
    requested_context_aliases = set(re.findall(r'\b([A-Z][A-Za-z0-9]*Context)\s*\.\s*push\b', prompt))
    blocks, seen = [], set()

    def emit(path, lines, lo, hi, label):
        lo, hi = max(1, lo), min(len(lines), hi)
        key = (path, lo, hi)
        if not lines or lo > hi or key in seen:
            return
        seen.add(key)
        suffix = ' (bounded source scan; additional candidates may be omitted)' if partial else ''
        block = [f'### {path}:{lo}-{hi} — {label}{suffix}']
        block.extend(f'{n}| {lines[n - 1][:200]}' for n in range(lo, hi + 1))
        blocks.append('\n'.join(block))

    # A factory must both have an ID-shaped name and use a random/UUID source,
    # or use one inside its short definition. Call sites are ranked higher when
    # they assign the result to an object's ID.
    if intent and words & {'id', 'ids', 'identifier', 'identifiers', 'uuid'} and words & {
            'generate', 'generated', 'generator', 'create', 'created', 'creates', 'random', 'new'
    }:
        declarations, factories = {}, []
        for path, lines in texts.items():
            if TESTPATH.search(path):
                continue
            for i, line in enumerate(lines):
                m = re.search(r'\b([A-Za-z_$][\w$]*(?:Id|ID|Uuid|UUID|Identifier))\s*(?:=|\()', line)
                if not m:
                    continue
                name = m.group(1)
                declaration = re.search(r'\b(?:const|let|var|function|fn|def)\s+' + re.escape(name) + r'\b', line)
                if not declaration:
                    continue
                name_parts = {part.lower() for part in re.findall(r'[A-Z]+(?=[A-Z][a-z]|\b)|[A-Z]?[a-z]+|[0-9]+', name)}
                if not name_parts & {'id', 'identifier', 'uuid'}:
                    continue
                declarations.setdefault(name, []).append((path, i + 1))
                if not line.rstrip().endswith('{') and '=>' in line:
                    body = line
                else:
                    body_rows, depth, started = [], 0, False
                    for row in lines[i:min(len(lines), i + 40)]:
                        body_rows.append(row)
                        depth += row.count('{') - row.count('}')
                        started |= '{' in row
                        if started and depth <= 0:
                            break
                    body = '\n'.join(body_rows)
                primitive_generator = bool(re.search(r'\b(?:nanoid|uuid4?|randomUUID)\b|(?:crypto|Math)\.random\s*\(', body, re.I))
                if not primitive_generator:
                    continue
                factories.append((name, path, i + 1, min(len(lines), i + 9)))
        topic_words = words - {
            'a', 'an', 'and', 'are', 'as', 'at', 'be', 'by', 'can', 'change', 'for', 'from', 'how', 'i',
            'if', 'in', 'is', 'it', 'me', 'of', 'on', 'or', 'the', 'this', 'to', 'what', 'which', 'who',
            'id', 'ids', 'identifier', 'identifiers', 'uuid', 'generate', 'generated', 'generator', 'create',
            'created', 'random', 'new', 'module', 'modules', 'call', 'calls',
        }
        ranked_factories = []
        factory_by_name = {}
        source_by_path = {path: '\n'.join(lines) for path, lines in texts.items()}
        masks_by_path = {}
        export_cache = {}
        name_edges = export_name_edges(source_by_path)

        def masked_source(path, source):
            if path not in masks_by_path:
                masks_by_path[path] = javascript_code_mask(source)
            return masks_by_path[path]

        for name, path, lo, hi in factories:
            factory_by_name.setdefault(name, (path, lo, hi, []))
        for name in list(factory_by_name):
            if len(declarations.get(name, [])) != 1:
                del factory_by_name[name]
        for name, (path, lo, hi, refs) in factory_by_name.items():
            candidate_names = export_name_candidates(name, name_edges)
            candidate_pattern = re.compile(r'(?<![\w$])(?:' + '|'.join(
                re.escape(candidate) for candidate in sorted(candidate_names, key=len, reverse=True)
            ) + r')(?![\w$])')
            for caller_path, lines in texts.items():
                if TESTPATH.search(caller_path):
                    continue
                caller_source = source_by_path[caller_path]
                # The lexical closure keeps renamed-barrel consumers eligible,
                # while avoiding masks/import resolution for unrelated files.
                # Actual module binding remains proven below.
                if not candidate_pattern.search(caller_source):
                    continue
                caller_mask = masked_source(caller_path, caller_source)
                scan_lines = (caller_mask.splitlines()
                              if Path(caller_path).suffix.lower() in ('.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts')
                              else lines)
                local_names = {name} if caller_path == path else imported_local_names(
                    caller_path, lines, name, path, texts, caller_mask, export_cache)
                for local_name in local_names:
                    call_pattern = re.compile(r'\b' + re.escape(local_name) + r'\s*\(')
                    for i, line in enumerate(scan_lines):
                        if caller_path == path and lo <= i + 1 <= hi:
                            continue
                        for _match in call_pattern.finditer(line):
                            escaped = re.escape(local_name)
                            strong = bool(re.search(r'\bid\s*:\s*(?:[^,;]*?\|\|\s*)?' + escaped + r'\s*\(|\.id\s*=\s*' + escaped + r'\s*\(', line))
                            context_words = set(re.findall(r'[a-z]+', (caller_path + ' ' + line).lower()))
                            score = (4 if strong else 0) + len(topic_words & context_words)
                            refs.append((score, caller_path, i))
        for name, (path, lo, hi, refs) in factory_by_name.items():
            score = max((row[0] for row in refs), default=0)
            ranked_factories.append((score, name, path, lo, hi, refs))
        ranked_factories.sort(key=lambda row: (-row[0], row[2], row[3]))
        for score, name, path, lo, hi, refs in ranked_factories[:2]:
            if topic_words and score == 0:
                continue
            emit(path, texts[path], lo, hi, f'ID factory {name}')
            for _, caller_path, i in sorted(refs, key=lambda row: (-row[0], row[1], row[2]))[:6]:
                lines = texts[caller_path]
                emit(caller_path, lines, max(1, i), min(len(lines), i + 4), f'calls {name}')

    # Resolve a dotted member alias only within methods assigned to the same
    # top-level receiver; `this.member` elsewhere in the file proves nothing.
    member = re.search(r'\b([A-Za-z_$][\w$]*)\.([A-Za-z_$][\w$]*)\b', prompt)
    if intent and member:
        receiver, method = member.groups()
        only_lib = bool(re.search(r'(?i)\blib\b', prompt))
        for path, lines in texts.items():
            if TESTPATH.search(path) or (only_lib and not path.startswith('lib/')):
                continue
            source = '\n'.join(lines)
            mask, definitions = assigned_functions(source, receiver)
            matching = [row for row in definitions if row[0] == method]
            if not matching:
                continue
            line_at = lambda offset: source.count('\n', 0, offset) + 1
            for _name, start, end, _body in matching[:1]:
                emit(path, lines, line_at(start), min(line_at(end), line_at(start) + 23),
                     f'{receiver}.{method} definition on the same receiver')
            for child, start, end, body in definitions:
                if child != method and re.search(r'\bthis\s*\.\s*' + re.escape(method) + r'\s*\(', body):
                    emit(path, lines, line_at(start), min(line_at(end), line_at(start) + 23),
                         f'{receiver}.{child} calls this.{method} on the same receiver')
            for child, start, end in proven_getter_functions(source, receiver, method):
                emit(path, lines, line_at(start), min(line_at(end), line_at(start) + 23),
                     f'{receiver}.{child} getter calls this.{method} on the proven receiver')

    # Python frameworks sometimes use a semantically named context class and
    # a local factory receiver instead of a direct constructor call.
    if intent and {'request', 'context', 'push'} <= words:
        for path, lines in texts.items():
            if not path.endswith('.py') or TESTPATH.search(path):
                continue
            classes = []
            for i, line in enumerate(lines):
                indent = len(line) - len(line.lstrip())
                cm = re.match(r'\s*class\s+([A-Za-z_]\w*)\b', line)
                if cm:
                    while classes and classes[-1][0] >= indent:
                        classes.pop()
                    classes.append((indent, cm.group(1), i))
                    continue
                dm = re.match(r'\s*def\s+push\s*\(', line)
                if not dm:
                    continue
                owner = next((row for row in reversed(classes) if row[0] < indent), None)
                if not owner:
                    continue
                start = owner[2]
                class_end = next((j for j in range(start + 1, len(lines))
                                  if re.match(r'^class\s+[A-Za-z_]\w*', lines[j])), len(lines))
                class_doc = '\n'.join(lines[start:min(class_end, start + 45)])
                if not (re.search(r'(?i)request\s+context', class_doc) or 'context' in owner[1].lower()):
                    continue
                merged = re.search(r'(?i)merged with.{0,40}RequestContext|request context', class_doc)
                if merged and owner[1] != '_AppCtxGlobals':
                    emit(path, lines, start + 1, min(class_end, start + 34), f'{owner[1]} class documents request-context identity')
                sig = i
                while sig < len(lines) - 1 and not lines[sig].rstrip().endswith(':'):
                    sig += 1
                end = sig + 1
                while end < len(lines) and (not lines[end].strip() or len(lines[end]) - len(lines[end].lstrip()) > indent):
                    end += 1
                emit(path, lines, i + 1, min(end, i + 26), f'{owner[1]}.push request-context method')
                for j in range(start + 1, class_end):
                    caller = re.match(r'\s*def\s+([A-Za-z_]\w*)\s*\(', lines[j])
                    if not caller or caller.group(1) == 'push':
                        continue
                    caller_indent = len(lines[j]) - len(lines[j].lstrip())
                    caller_end = j + 1
                    while caller_end < class_end and (
                        not lines[caller_end].strip()
                        or len(lines[caller_end]) - len(lines[caller_end].lstrip()) > caller_indent
                    ):
                        caller_end += 1
                    if re.search(r'\bself\s*\.\s*push\s*\(', '\n'.join(lines[j:caller_end])):
                        emit(path, lines, j + 1, min(caller_end, j + 12),
                             f'{owner[1]}.{caller.group(1)} calls self.push')
            # Keep the caller tied to the receiver returned by a request-context factory.
            for i, line in enumerate(lines):
                cm = re.match(r'\s*def\s+([A-Za-z_]\w*)\s*\(', line)
                if not cm:
                    continue
                indent = len(line) - len(line.lstrip())
                sig = i
                while sig < len(lines) - 1 and not lines[sig].rstrip().endswith(':'):
                    sig += 1
                end = sig + 1
                while end < len(lines) and (not lines[end].strip() or len(lines[end]) - len(lines[end].lstrip()) > indent):
                    end += 1
                body = lines[i:end]
                text = '\n'.join(body)
                if cm.group(1) == 'request_context' and re.search(r'->\s*\w*Context', line):
                    ret = next((j for j, row in enumerate(body) if re.search(r'return\s+\w*Context\.', row)), None)
                    if ret is not None:
                        emit(path, lines, i + 1, min(i + 12, end), 'request-context factory returns context type')
                        emit(path, lines, i + ret + 1, min(i + ret + 2, end), 'request-context factory constructs returned context')
                aliases = set(re.findall(r'\b([A-Za-z_]\w*)\s*=\s*self\.request_context\s*\(', text))
                for alias in aliases:
                    for j, body_line in enumerate(body):
                        if re.search(r'\b' + re.escape(alias) + r'\.push\s*\(', body_line):
                            emit(path, lines, i + j + 1, min(end, i + j + 9), f'{cm.group(1)} pushes request-context receiver {alias}')
            if requested_context_aliases:
                merged_classes = set()
                for _class_indent, class_name, class_start in classes:
                    class_end = next((j for j in range(class_start + 1, len(lines))
                                      if re.match(r'^class\s+[A-Za-z_]\w*', lines[j])), len(lines))
                    class_doc = '\n'.join(lines[class_start:min(class_end, class_start + 45)])
                    if any(re.search(r'(?i)merged with.{0,40}\b' + re.escape(alias) + r'\b', class_doc)
                           for alias in requested_context_aliases):
                        merged_classes.add(class_name)
                try:
                    module = ast.parse('\n'.join(lines))
                except SyntaxError:
                    module = None
                if module is not None:
                    for node in module.body:
                        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) or node.name != '__getattr__':
                            continue
                        for child in ast.walk(node):
                            if not isinstance(child, ast.If):
                                continue
                            test = child.test
                            if not (isinstance(test, ast.Compare) and isinstance(test.left, ast.Name)
                                    and test.left.id == 'name' and len(test.ops) == 1
                                    and isinstance(test.ops[0], ast.Eq) and len(test.comparators) == 1
                                    and isinstance(test.comparators[0], ast.Constant)):
                                continue
                            alias = test.comparators[0].value
                            if alias not in requested_context_aliases:
                                continue
                            target = next((statement.value.id for statement in child.body
                                           if isinstance(statement, ast.Return)
                                           and isinstance(statement.value, ast.Name)), None)
                            if target in merged_classes:
                                emit(path, lines, node.lineno, min(node.end_lineno or node.lineno, node.lineno + 12),
                                     f'{alias} alias resolves to merged {target}')

    output = []
    size = 0
    for block in blocks:
        if size + len(block.encode()) + 1 > SEMANTIC_CAP_BYTES:
            break
        output.append(block)
        size += len(block.encode()) + 1
    return '\n'.join(output)


def wants_semantic_callers(prompt):
    words = set(re.findall(r'[a-z]+', prompt.lower()))
    if 'requestcontext' in words:
        words.update({'request', 'context'})
    if 'pushed' in words:
        words.add('push')
    caller_intent = bool(re.search(r'(?i)\b(which|who|what|show|locate)\b', prompt) and re.search(
        r'(?i)\b(call|calls|calling|callers?|modules?|parts?|code|consumers?|entry points?|invoke|uses?)\b', prompt))
    member = re.search(r'\b[A-Za-z_$][\w$]*\.[A-Za-z_$][\w$]*\b', prompt)
    id_factory = bool(words & {'id', 'ids', 'identifier', 'identifiers', 'uuid'}) and bool(words & {
        'generate', 'generated', 'generator', 'create', 'created', 'creates', 'random', 'new'
    })
    request_push = {'request', 'context', 'push'} <= words
    return caller_intent and (member is not None or id_factory or request_push)


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req['repo_root'], req['prompt'], req.get('brief', '')
    sym = resolve(root, prompt, brief)
    semantic = ''
    if not sym:
        if wants_semantic_callers(prompt):
            texts, partial = tracked_source(root, prompt)
            semantic = semantic_caller_blocks(prompt, texts, partial)
        if semantic:
            print(semantic)
        return
    out, emitted = [], []

    def emit(path, a, b, label):
        lines = read(root, path)
        a, b = max(1, a), min(len(lines), b)
        if any(p == path and x <= a and b <= y for p, x, y in emitted) or a > b:
            return
        emitted.append((path, a, b))
        out.append(f'### {path}:{a}-{b} — {label}')
        out.extend(f'{n}| {lines[n - 1][:200]}' for n in range(a, b + 1))

    dlines = read(root, sym['path'])
    top = sym['start_line']
    if top < 1 or sym['end_line'] > len(dlines):
        return
    while top > 1 and re.match(r'\s*(//|#|/\*|\*|@)', dlines[top - 2]):
        top -= 1
    envs = sorted(set(ENV.findall('\n'.join(dlines[top - 1:sym['end_line']]))))
    callers = sorted(edges(root, sym['uid'], 'callers'), key=lambda e: (e['symbol']['path'], e['symbol']['start_line']))
    for edge in callers[:MAX_CALLERS]:
        c = edge['symbol']
        site = edge.get('site_line') or c['start_line']
        label = 'a test that calls' if TESTPATH.search(c['path']) else 'calls'
        if c['end_line'] - c['start_line'] + 1 <= BODY_CAP:
            emit(c['path'], c['start_line'], c['end_line'], f"{c['name']} {label} {sym['name']}")
        else:
            emit(c['path'], site - SITE_CONTEXT, site + SITE_CONTEXT, f"{c['name']} {label} {sym['name']}")
        for up in sorted(edges(root, c['uid'], 'callers'), key=lambda e: (e['symbol']['path'], e['symbol']['start_line']))[:MAX_SITES]:
            u = up['symbol']
            usite = up.get('site_line') or u['start_line']
            ulines = read(root, u['path'])
            if u['start_line'] >= usite - 1:
                emit(u['path'], u['start_line'], usite + 1, f"{u['name']} calls {c['name']}")
            else:
                emit(u['path'], u['start_line'], u['start_line'] + 1, f"{u['name']} (declaration)")
                emit(u['path'], usite - 1, usite + 1, f"{u['name']} calls {c['name']}")
    helper = re.compile(r'\bfn\s+(' + re.escape(sym['name']) + r'_\w+|\w+_' + re.escape(sym['name']) + r')\b|\bdef\s+(' + re.escape(sym['name']) + r'_\w+)')
    files = sorted(f for f in subprocess.run(['git', 'ls-files', '-z'], cwd=root, capture_output=True, text=True).stdout.split('\0') if f and SRC.search(f))[:MAX_FILES]
    texts = {f: read(root, f) for f in files}
    for f in files:
        for i, line in enumerate(texts[f]):
            if helper.search(line):
                span = unit_around(texts[f], i + 1, 22)
                if span:
                    emit(f, span[0], span[1], f"{helper.search(line).group(1) or helper.search(line).group(2)} (helper named after {sym['name']})")
                break
    callee_files = sorted({e['symbol']['path'] for e in edges(root, sym['uid'], 'callees')} - {sym['path']})
    for f in callee_files[:MAX_FILES]:
        if TESTPATH.search(f):
            continue
        lines = texts.get(f) or read(root, f)
        for i, line in enumerate(lines):
            if re.match(r'\s*(#\[test\]|def test_|(it|test)\()', line):
                span = unit_around(lines, i + 2 if line.lstrip().startswith('#[') else i + 1, 22)
                if span:
                    emit(f, span[0], span[1], f'a unit test beside {Path(f).name}, which {sym["name"]} calls into')
                break
    found = 0
    for token in envs:
        for f in files:
            if not TESTPATH.search(f) or found >= MAX_TESTS:
                continue
            for i, line in enumerate(texts[f]):
                if token in line:
                    span = unit_around(texts[f], i + 1, 30)
                    if span:
                        emit(f, span[0], span[1], f'a test that sets {token}')
                        found += 1
                    break
    if not out:
        return
    drops = []
    for m in re.finditer(r'^### (\S+?:\d+-\d+) — (.*\(test\).*|.*\(a test of .*)$', brief, re.M):
        start = m.end()
        nxt = brief.find('\n### ', start)
        body = brief[start: nxt if nxt != -1 else len(brief)]
        if sym['name'] not in body and not any(t in body for t in envs):
            drops.append(re.escape(m.group(1)))
    for m in re.finditer(r'^### (tests matching [^\n]*)$', brief, re.M):
        nxt = brief.find('\n### ', m.end())
        if sym['name'] not in brief[m.end(): nxt if nxt != -1 else len(brief)]:
            drops.append(re.escape(m.group(1)))
    for m in re.finditer(r'^### (\S+?:\d+-\d+) — (\w+) definition \((?:method|function|variant|struct)\)$', brief, re.M):
        if m.group(2) != sym['name']:
            drops.append(re.escape(m.group(1)))
    if drops:
        print('drop: ^(?:' + '|'.join(drops) + ')')
    print('\n'.join(out))
    if semantic:
        print(semantic)


if __name__ == '__main__':
    main()
