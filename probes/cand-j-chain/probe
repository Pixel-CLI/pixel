"""cand-j-chain: 'trace how A turns into a T, from an entry through ...' is answered by the call chain between two
symbols the question names, not by the callees of one of them. The entry is the function-shaped word after
'from' (else the first word that resolves to a function), the target is the type-shaped word that resolves to a
type; the target's constructors are the functions of its file whose signature returns it. `pixel call-path` gives
the shortest chain from the entry to a constructor. Each hop is shown at its call site (its whole body when short),
the other callees of the entry that take the target in their signature are shown at their head, and, at each hop,
the callees whose names carry the question's words (generic words weigh nothing) follow, two levels deep. The
brief's own flow blocks are replaced. Needs `pixel` (PIXEL_BIN, else PATH) and its daemon; prints nothing
without a chain. Read-only, deterministic, no network.

The brief runs the Rust step of the same name (crates/pixel/src/execution_brief/steps/cand_j_chain.rs) and does not start
this script; it stays as the oracle that scripts/bench/step-parity.py compares the step with."""
import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

TYPE_KINDS = {'struct', 'class', 'enum', 'trait', 'interface', 'type', 'type_alias'}
FUNC_KINDS = {'function', 'method'}
FRAME = ('trac', 'comm', 'line', 'becom', 'valu', 'from', 'thro', 'main', 'what', 'whic', 'wher', 'does', 'argu',
         'happ', 'code', 'file', 'data', 'into', 'goes', 'flow', 'work', 'step')
BODY_CAP, FAR_CAP, HOP_CAP, HEAD_CAP, MAX_RANKED, BYTES = 180, 100, 100, 230, 4, 26_000
MAX_FILE_BYTES = 300_000
SIG_RETURNS = re.compile(r'->|:\s*[A-Z]\w*\s*[{=]|\bnew\b|__init__|constructor')


def pixel(root, *args):
    exe = os.environ.get('PIXEL_BIN') or 'pixel'
    try:
        return subprocess.run([exe, *args, '--metrics', 'off'], cwd=root, capture_output=True, text=True, timeout=8).stdout
    except (OSError, subprocess.SubprocessError):
        return ''


def jpixel(root, *args):
    try:
        return json.loads(pixel(root, *args, '--json') or '{}')
    except ValueError:
        return {}


def read(root, path):
    directory_fd = None
    file_fd = None
    try:
        relative = Path(path)
        nofollow = getattr(os, 'O_NOFOLLOW', None)
        if nofollow is None or relative.is_absolute() or not relative.parts or any(
            part in ('', '.', '..') for part in relative.parts
        ):
            return []
        directory_fd = os.open(Path(root).resolve(), os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
        for part in relative.parts[:-1]:
            next_fd = os.open(
                part,
                os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | nofollow,
                dir_fd=directory_fd,
            )
            os.close(directory_fd)
            directory_fd = next_fd
        file_fd = os.open(
            relative.parts[-1],
            os.O_RDONLY | nofollow | getattr(os, 'O_NONBLOCK', 0),
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE_BYTES:
            return []
        chunks, total = [], 0
        while total <= MAX_FILE_BYTES:
            chunk = os.read(file_fd, MAX_FILE_BYTES + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > MAX_FILE_BYTES:
            return []
        return b''.join(chunks).decode(errors='replace').splitlines()
    except (OSError, RuntimeError):
        return []
    finally:
        if file_fd is not None:
            os.close(file_fd)
        if directory_fd is not None:
            os.close(directory_fd)


def callees(root, uid):
    out, offset = [], 0
    while offset <= 100:
        data = jpixel(root, 'who-calls', '--role', 'callees', '--offset', str(offset), uid, '.')
        got = data.get('edges', [])
        out += got
        if len(got) < data.get('edge_limit', 20):
            break
        offset += len(got)
    return out


def stem(word):
    word = word.lower()
    for suffix in ('ing', 'ed', 'es', 's'):
        if word.endswith(suffix) and len(word) - len(suffix) >= 4:
            return word[:-len(suffix)]
    return word


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req['repo_root'], req['prompt'], req.get('brief', '')
    words = list(dict.fromkeys(re.findall(r'[A-Za-z_][A-Za-z0-9_]*', prompt)))
    shown = set(re.findall(r'^### (\S+?):\d+-\d+', brief, re.M))
    funcs, types = {}, {}
    for w in words:
        if len(w) < 3 or w.lower() in {'the', 'how', 'and', 'trace', 'from'}:
            continue
        for s in jpixel(root, 'find-symbol', w, '.').get('symbols', []):
            if s.get('name') != w:
                continue
            if s['kind'] in FUNC_KINDS:
                funcs.setdefault(w, []).append(s)
            elif s['kind'] in TYPE_KINDS:
                types.setdefault(w, []).append(s)
    if not funcs or not types:
        return
    m = re.search(r'(?i)\b(?:from|starting (?:at|from)|at|in)\s+`?([A-Za-z_]\w*)', prompt)
    entry_word = m.group(1) if m and m.group(1) in funcs else next(iter(funcs))
    entry = sorted(funcs[entry_word], key=lambda s: (s['path'] not in shown, -(s['end_line'] - s['start_line']), s['path']))[0]
    tword = next(iter(types))
    target = sorted(types[tword], key=lambda s: (s['path'] not in shown, s['path']))[0]
    tlines = read(root, target['path'])
    ctor_names = []
    for i, line in enumerate(tlines):
        d = re.match(r'\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+|unsafe\s+|const\s+)*(?:fn|def|function|func)\s+([A-Za-z_]\w*)', line)
        if not d:
            continue
        sig = ' '.join(tlines[i:i + 4]).split('{')[0]
        ret = sig.split('->', 1)[1] if '->' in sig else ''
        if re.search(r'\b(' + re.escape(target['name']) + r'|Self)\b', ret) and d.group(1) not in ctor_names:
            ctor_names.append(d.group(1))
    best = None
    for name in ctor_names[:10]:
        for s in jpixel(root, 'find-symbol', name, '.').get('symbols', []):
            if s['path'] != target['path'] or not (s.get('qualified', '').startswith(target['name'] + '::') or s['kind'] == 'function'):
                continue
            data = jpixel(root, 'call-path', entry['uid'], s['uid'], '.')
            hops = data.get('hops') or []
            if data.get('found') and len(hops) >= 2 and (best is None or len(hops) < len(best)):
                best = hops
    if not best:
        return
    out, emitted, used = [], [], 0

    def emit(path, a, b, label):
        nonlocal used
        lines = read(root, path)
        a, b = max(1, a), min(len(lines), b)
        if a > b or any(p == path and x <= a and b <= y for p, x, y in emitted):
            return False
        rows = [n for n in range(a, b + 1) if lines[n - 1].strip()]
        size = sum(len(lines[n - 1][:200]) + 8 for n in rows)
        if used + size > BYTES:
            return False
        used += size
        emitted.append((path, a, b))
        out.append(f'### {path}:{a}-{b} — {label}')
        out.extend(f'{n}| {lines[n - 1][:200]}' for n in rows)
        return True

    chain = ' -> '.join(f"{h['name']} ({h['path']}:{h['line']})" for h in best)
    out.append('### call trace, entry to target')
    out.append(f'chain {chain}')
    terms = {stem(w) for w in re.findall(r'[A-Za-z]{4,}', prompt) if not w.lower().startswith(FRAME)}
    uids = {h['uid'] for h in best}

    def info(uid):
        sym = jpixel(root, 'find-symbol', uid.split('#')[1].split('::')[-1], '.')
        return next((s for s in sym.get('symbols', []) if s['uid'] == uid), None)

    syms = [info(h['uid']) for h in best]
    for i, (h, s) in enumerate(zip(best, syms)):
        if not s:
            continue
        nxt = best[i + 1]['uid'] if i + 1 < len(best) else None
        site = next((e.get('site_line') for e in callees(root, h['uid']) if e['symbol']['uid'] == nxt), None) if nxt else None
        size = s['end_line'] - s['start_line'] + 1
        if nxt is None:
            emit(s['path'], s['start_line'], s['start_line'] + HEAD_CAP - 1, f"{s['name']} (constructor of {target['name']}), head")
        elif size <= HOP_CAP:
            emit(s['path'], s['start_line'], s['end_line'], f"{s['name']} calls {best[i + 1]['name']}")
        else:
            if (site or s['start_line']) - 2 > s['start_line']:
                emit(s['path'], s['start_line'], s['start_line'], f"{s['name']} (declaration)")
            emit(s['path'], max(s['start_line'], (site or s['start_line']) - 2), (site or s['start_line']) + 4, f"{s['name']} calls {best[i + 1]['name']}")
    esym = syms[0]
    for e in callees(root, entry['uid']):
        c = e['symbol']
        if c['uid'] in uids or c['kind'] not in FUNC_KINDS:
            continue
        if re.search(r'\b' + re.escape(target['name']) + r'\b', c.get('sig', '')):
            emit(c['path'], c['start_line'], c['start_line'] + 9, f"{c['name']} receives the {target['name']}")
    def ranked(uid):
        res = []
        for e in callees(root, uid):
            c = e['symbol']
            if c['uid'] in uids or c['kind'] not in FUNC_KINDS or 'test' in c['path'].lower():
                continue
            hay = c.get('qualified', c['name']).lower()
            score = sum(1 for t in terms if t in hay)
            if score and c['end_line'] - c['start_line'] >= 2:
                res.append((-score, c['path'], c['start_line'], c))
        res.sort(key=lambda r: r[:3])
        seen, out2 = set(), []
        for *_, c in res:
            if c['uid'] not in seen:
                seen.add(c['uid'])
                out2.append(c)
        return out2[:MAX_RANKED // 2]

    def body(c, why, cap=BODY_CAP):
        return emit(c['path'], c['start_line'], min(c['end_line'], c['start_line'] + cap - 1), why)

    def siblings(c):
        owner = c.get('qualified', '').rsplit('::', 1)[0] if '::' in c.get('qualified', '') else None
        if not owner:
            return []
        lines = read(root, c['path'])
        names = sorted({m.group(1) for line in lines for m in [re.match(r'\s*(?:pub(?:\([^)]*\))?\s+)?fn\s+([A-Za-z_]\w*)', line)] if m and any(t in m.group(1).lower() for t in terms)} - {c['name']})
        res = []
        for n in names[:6]:
            for s in jpixel(root, 'find-symbol', n, '.').get('symbols', []):
                if s['path'] == c['path'] and s.get('qualified', '').startswith(owner + '::') and s['uid'] not in uids:
                    res.append(s)
        return sorted(res, key=lambda s: s['start_line'])[:1]

    for h in best[:-1]:
        for c in ranked(h['uid']):
            if body(c, f"{c['name']} (called by {h['name']}, named by the question)"):
                for d in siblings(c):
                    body(d, f"{d['name']} (beside {c['name']}, named by the question)")
                for d in ranked(c['uid']):
                    if body(d, f"{d['name']} (called by {c['name']}, named by the question)"):
                        for q in siblings(d):
                            body(q, f"{q['name']} (beside {d['name']}, named by the question)")
                far = [e['symbol'] for e in callees(root, c['uid']) if e['symbol']['path'] != c['path'] and e['symbol']['kind'] in FUNC_KINDS
                       and e['symbol']['end_line'] - e['symbol']['start_line'] >= 8 and 'test' not in e['symbol']['path'].lower()]
                for d in sorted({x['uid']: x for x in far}.values(), key=lambda s: (s['path'], s['start_line']))[:2]:
                    body(d, f"{d['name']} (called by {c['name']})", FAR_CAP)
    if len(out) <= 2:
        return
    own = [h for h in re.findall(r'^### (.+)$', brief, re.M) if h not in {l[4:] for l in out if l.startswith('### ')}]
    if own:
        print('drop: ^(?:' + '|'.join(re.escape(h) for h in own) + ')$')
    print('\n'.join(out))


main()
