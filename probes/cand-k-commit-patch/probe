"""cand-k-commit-patch: a question that quotes a commit title and asks what the commit did and which files it touched.

The commit is found like history-fallback does (a version the prompt quotes, else the quoted title through
`git log --grep`, else the prompt's rarest words). What is printed differs: the message's leading paragraphs
(fenced output is cut), the complete `--stat` file list (so every file of the commit is named, with its counts),
then the hunks file by file with source files first and manifests next (a merge against its first parent),
lockfiles and generated files only summarised, inside a byte budget. The block
carries the header history-fallback uses, so in `lead` mode it replaces that block (a later block with a header
already held is skipped by the merge).

Read-only git, deterministic, nothing printed when no commit matches or the brief already holds a history block.

The brief runs the Rust step of the same name (crates/pixel/src/execution_brief/steps/cand_k_commit_patch.rs) and does
not start this script; it stays as the oracle that scripts/bench/step-parity.py compares the step with."""
import collections
import json
import math
import tempfile
import re
import subprocess
import sys

MESSAGE_LINES = 34
NUMBERS = re.compile(r"\d(\.\d+)?\s*(±|x\b|times|%|ms\b)")
FENCED_KEEP = 6
PATCH_BYTES = 3300
LOCK_LINES = 6
LINE_CHARS = 150
LOCKS = re.compile(r"(^|/)(Cargo\.lock|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb?|go\.sum|poetry\.lock|"
                   r"uv\.lock|Gemfile\.lock|composer\.lock|Pipfile\.lock)$|\.min\.(js|css)$|\.snap$")
MANIFEST = re.compile(r"(^|/)(Cargo\.toml|package\.json|pyproject\.toml|go\.mod|build\.gradle|pom\.xml|Gemfile)$")


def git(root, *args):
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=20).stdout


# A version the prompt quotes ("3.10", "v5.3.0"): the most specific token a history question carries, and
# one the letter-only word lists below never see.
VERSION = re.compile(r"(?<![\w.])v?(\d+\.\d+(?:\.\d+)*)(?!\w|\.\d)")
# Words any history question uses: they name no commit of their own.
ASKING = {"which", "what", "when", "where", "commit", "commits", "change", "changed", "changes", "release",
          "released", "made", "make", "does", "version", "versions"}


# Kept identical in both standalone history probes: bundles install each script alone.
SUBJECT_LIMIT = 20_000
SUBJECT_BYTES = 4 * 1024 * 1024
SUBJECT_STOP = ASKING | set("was were is are the to of a an and or it did that this how from with for in added add introduced introduce happen happens first".split())


def subject_words(text):
    return [w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in SUBJECT_STOP and len(w) >= 2]


def by_subject(root, prompt):
    """Prefer multi-term subject evidence to incidental mentions in long message bodies.

    This ranks candidate commits, not proof of first introduction. Exact versions and
    quoted titles retain precedence. A lone shared word never admits a candidate.
    """
    try:
        with tempfile.TemporaryFile() as output:
            result = subprocess.run(["git", "-C", root, "log", "-n", str(SUBJECT_LIMIT),
                                     "--format=%H\t%h %as %s"], stdout=output,
                                    stderr=subprocess.DEVNULL, timeout=0.8)
            if result.returncode or output.tell() > SUBJECT_BYTES:
                return []
            output.seek(0)
            rows = output.read(SUBJECT_BYTES).decode("utf-8", errors="replace").splitlines()
    except (OSError, subprocess.SubprocessError):
        return []
    records = [r.split("\t", 1) for r in rows if "\t" in r]
    corpus = [set(subject_words(r[1].split(" ", 2)[-1])) for r in records]
    counts = collections.Counter(w for row in corpus for w in row)
    asked = set(subject_words(prompt))
    raw = re.findall(r"[a-z0-9]+", prompt.lower())
    pairs = {(a, b) for a, b in zip(raw, raw[1:]) if a in asked and b in asked}
    ranked = []
    for index, (record, tokens) in enumerate(zip(records, corpus)):
        shared = asked & tokens
        if len(shared) < 2:
            continue
        seq = re.findall(r"[a-z0-9]+", record[1].split(" ", 2)[-1].lower())
        adjacent = set(zip(seq, seq[1:])) & pairs
        if len(shared) < 3 and not adjacent:
            continue
        score = sum(math.log1p(len(records) / (1 + counts[w])) for w in sorted(shared)) + 4 * len(adjacent)
        ranked.append((score, len(shared), -index, record))
    return [record for _, _, _, record in sorted(ranked, reverse=True)[:6]]



def stems(text):
    return {w[:4] for w in re.findall(r"[a-z]{4,}", text.lower()) if w not in ASKING}


def by_version(root, prompt):
    """``[(sha, "%h %as %s")]`` of the commits naming a version the prompt quotes, best first: the commit its
    exact release tag points at, then the subjects sharing most of the prompt's other word stems, then the
    newest. Only the tagged commit and subjects sharing a stem are kept: a bare number names no commit."""
    asked = stems(VERSION.sub(" ", prompt))
    for version in dict.fromkeys(VERSION.findall(prompt)):
        pattern = "(^|[^0-9.])" + re.escape(version) + "([^0-9.]|\\.([^0-9]|$)|$)"
        log = git(root, "log", "-i", "-E", "-n", "20", "--format=%H\t%h %as %s", f"--grep={pattern}")
        found = [line.split("\t", 1) for line in log.splitlines()]
        tagged = next((sha for sha in (git(root, "rev-list", "-n", "1", f"refs/tags/{tag}", "--").strip()
                                       for tag in (f"v{version}", version)) if sha), "")
        if tagged and tagged not in (sha for sha, _ in found):
            found.insert(0, [tagged, git(root, "show", "-s", "--format=%h %as %s", tagged).strip()])
        shared = lambda line: len(asked & stems(line.split(" ", 2)[-1]))
        ranked = sorted(enumerate(found), key=lambda c: (c[1][0] != tagged, -shared(c[1][1]), c[0]))
        kept = [(sha, line) for _, (sha, line) in ranked if sha == tagged or shared(line)]
        if kept:
            return kept
    return []


def find_commit(root, prompt):
    named = by_version(root, prompt)
    if named:
        return named[0][1].split()[0]
    for phrase in [q.strip() for q in re.findall(r"[\"'`]([^\"'`]{8,120})[\"'`]", prompt)]:
        out = git(root, "log", "-i", "--fixed-strings", "-n", "6", "--format=%h", f"--grep={phrase}").split()
        if out:
            return out[0]
    named = by_subject(root, prompt)
    if named:
        return named[0][0]
    words = [w for w in dict.fromkeys(re.findall(r"[a-z]{5,}", prompt.lower()))]
    messages = git(root, "log", "-i", "-n", "20000", "--format=%B%x00").lower().split("\0")
    counts = {w: sum(w in m for m in messages) for w in words[:24]}
    words = sorted((w for w in words if counts.get(w)), key=lambda w: (counts[w], w))
    for k in (3, 2):   # a single rare word names no commit: stay silent rather than show a neighbour
        out = git(root, "log", "-i", "--all-match", "-n", "6", "--format=%h", *[f"--grep={w}" for w in words[:k]]).split()
        if out and words:
            return out[0]
    return None


def message(root, sha):
    lines = git(root, "show", "-s", "--format=%h %ad %an%n%B", "--date=short", sha).strip().splitlines()
    out, fenced, kept = lines[:1], False, 0
    for line in lines[1:]:
        if line.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            if kept < FENCED_KEEP and NUMBERS.search(line) and "Summary" not in line and "Range" not in line:
                kept += 1
                out.append("  " + line.strip())
            continue
        out.append(line)
    clean = []
    for line in out:
        if line.strip() or (clean and clean[-1].strip()):
            clean.append(line)
    return clean[:MESSAGE_LINES + 1]


def sections(diff):
    """``[(path, [lines])]`` of a unified diff, in the order git printed it."""
    out, cur = [], None
    for line in diff.splitlines():
        m = re.match(r"diff --git a/(.*) b/(.*)$", line)
        if m:
            cur = (m.group(2), [])
            out.append(cur)
        elif cur is not None and not line.startswith(("index ", "--- ", "+++ ", "new file", "deleted file", "similarity")):
            cur[1].append(line)
    return out


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    if re.search(r"^### (history|commit )", brief, re.M):
        return
    sha = find_commit(root, prompt)
    if not sha:
        return
    # A merge shows what it brought to its first parent: its combined diff is empty when it merged cleanly.
    stat = git(root, "show", "--format=", "--stat=100", "--diff-merges=first-parent", "--no-ext-diff",
               sha).rstrip().splitlines()
    diff = sections(git(root, "show", "--format=", "-U1", "--diff-merges=first-parent", "--no-ext-diff", sha))
    rank = lambda s: (2 if LOCKS.search(s[0]) else 1 if MANIFEST.search(s[0]) else 0, s[0])
    out = [f"### commit {sha} — message, files and patch"]
    out += [l[:LINE_CHARS] for l in message(root, sha)]
    out += ["files in the commit:"] + [l[:LINE_CHARS] for l in stat]
    used = sum(len(l) + 1 for l in out)
    left_out = 0
    for path, body in sorted(diff, key=rank):
        if used >= PATCH_BYTES + 1500:
            left_out += 1  # the stat above already names it
            continue
        if LOCKS.search(path):
            edits = [l for l in body if l[:1] in "+-"]
            out.append(f"@@ {path} (lockfile, {len(edits)} edited lines; first ones)")
            out += [l[:LINE_CHARS] for l in edits[:LOCK_LINES]]
            continue
        chunk = [f"@@ {path}"] + [l[:LINE_CHARS] for l in body]
        cost = sum(len(l) + 1 for l in chunk)
        if used + cost > PATCH_BYTES + 1500 and used > 0:
            chunk = chunk[: max(2, (PATCH_BYTES + 1500 - used) // 60)] + ["... (hunks cut)"]
            cost = sum(len(l) + 1 for l in chunk)
        used += cost
        out += chunk
    if left_out:
        out.append(f"... hunks of {left_out} more files cut (named in the list above)")
    discarded = [header for header in re.findall(r"^### (.+)$", brief, re.M)
                 if not header.startswith(("history", "commit "))]
    if discarded:
        print("drop: ^(?:" + "|".join(re.escape(header) for header in discarded) + ")$")
    print("\n".join(out))


main()
