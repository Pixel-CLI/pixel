"""cand-j-stop-cause: a 'why does X stop/skip/ignore ...' question is answered by the code that implements the
effect and the tests that pin it down. The question's rare words (IDF over the tracked source, plus a small table
of verb synonyms: stop = quit = halt ...) each form a group; every 30-line window of every file scores the groups it
holds close together. Windows inside multi-line string literals (flag documentation) and windows with little code
are left out; the best non-overlapping windows are shown, tests and source alike, a test file named after a group
weighing a little more. Brief blocks whose best window holds fewer than three groups are dropped, longer ones are
cut to their best window. Read-only, deterministic, no network.

The brief runs the Rust step of the same name (crates/pixel/src/execution_brief/steps/cand_j_stop_cause.rs) and does not start
this script; it stays as the oracle that scripts/bench/step-parity.py compares the step with."""
import json
import math
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

SRC = re.compile(r'\.(rs|py|js|jsx|ts|tsx|go|java|kt|c|h|cc|cpp|hpp|rb|php|swift|cs|scala|sh|lua)$')
TESTPATH = re.compile(r'(^|/)(tests?|__tests__|spec|testdata)/|[._-](test|spec)s?\.\w+$|(^|/)test_\w+\.\w+$|_tests?\.\w+$')
STOP = set('what where which that this with from does how the and for are was were why when who whom whose into onto than then them they their there these those have has had been being will would should could can may might must about after before between through during over under again further once here some such only same also just very more most other each both any all not our your its his her him she you out off use used using make made get got let trace explain tell show describe find list name names code function functions method methods file files line lines value values data'.split())
FRAME = ('test', 'prov', 'proo', 'cove', 'defi', 'call', 'beha', 'work', 'happ', 'deci', 'expl', 'show', 'mean')
SYN = [set(g.split()) for g in ('stop quit halt abort terminate bail cancel', 'skip suppress ignore hide filter refuse reject discard omit exclude',
                                'fail error crash panic', 'print display output emit')]
HEADER = re.compile(r'^### (\S+?):(\d+)-(\d+)(.*)$', re.M)
SIZE, MIN_GROUPS, MAX_SRC, PER_FILE, BYTES, MIN_DENSITY, MAX_PROSE = 30, 3, 5, 1, 5300, 0.35, 0.1
BRIEF_BOOST = 1.3
MIN_WINDOW = 2
REQUIRED = 2
MAX_TEST, FAMILY, TEST_CAP, TEST_BYTES = 3, 3, 12, 3000
MAX_FILES, MAX_FILE_BYTES = 4000, 300_000


DECL = re.compile(r'^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+|unsafe\s+|const\s+|extern\s+"[^"]*"\s+|static\s+|export\s+|default\s+)*(?:fn|def|function|func)\s+([A-Za-z_]\w*)|^\s*(?:[A-Za-z_]\w*!)\(\s*([A-Za-z_]\w*)\s*,\s*(?:\||move\s*\||\{|fn\b)|^\s*(?:test|it|describe)\(\s*[\'"`]([^\'"`]+)')


def units(path, lines):
    """``(start, end, name)`` of the tests of a file, 1-based, leading comment lines included."""
    res, n = [], len(lines)
    in_test_file = bool(TESTPATH.search(path))
    for i in range(n):
        m = DECL.match(lines[i])
        if not m:
            continue
        name = next(g for g in m.groups() if g)
        s = i
        while s > 0 and re.match(r'\s*(//|#\[|#\s|/\*|\*|@)', lines[s - 1]):
            s -= 1
        marked = any(re.match(r'\s*#\[(tokio::)?test|\s*@(Test|pytest)', lines[k]) for k in range(s, i + 1))
        if not (in_test_file or marked or name.startswith('test_') or m.group(2) or m.group(3)):
            continue
        end, depth, seen = None, 0, False
        for j in range(i, min(n, i + 400)):
            for ch in re.sub(r'"(\\.|[^"\\])*"|\'(\\.|[^\'\\])\'|//.*$', '', lines[j]):
                if ch == '{':
                    depth, seen = depth + 1, True
                elif ch == '}':
                    depth -= 1
            if seen and depth <= 0:
                end = j
                break
        if end is None:
            indent = len(lines[i]) - len(lines[i].lstrip())
            j = i + 1
            while j < n and (not lines[j].strip() or len(lines[j]) - len(lines[j].lstrip()) > indent):
                j += 1
            end = j - 1
            while end > i and not lines[end].strip():
                end -= 1
        res.append((s + 1, end + 1, name))
    return res


def pixel_json(root, *args):
    exe = os.environ.get('PIXEL_BIN') or 'pixel'
    try:
        out = subprocess.run([exe, *args, '--json', '--metrics', 'off'], cwd=root, capture_output=True, text=True, timeout=6).stdout
        return json.loads(out or '{}')
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}


def stem(word):
    word = word.lower()
    for suffix in ('ing', 'ed', 'es', 's'):
        if word.endswith(suffix) and len(word) - len(suffix) >= 4:
            return word[:-len(suffix)]
    return word


def tracked(root):
    out = subprocess.run(['git', 'ls-files', '-z'], cwd=root, capture_output=True, text=True, timeout=5).stdout
    return sorted(f for f in out.split('\0') if f and SRC.search(f))[:MAX_FILES]


def read(root, path):
    directory_fd = None
    file_fd = None
    try:
        relative = Path(path)
        nofollow = getattr(os, 'O_NOFOLLOW', None)
        if nofollow is None or relative.is_absolute() or not relative.parts or any(
            part in ('', '.', '..') for part in relative.parts
        ):
            return []
        directory_fd = os.open(Path(root).resolve(), os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
        for part in relative.parts[:-1]:
            next_fd = os.open(
                part,
                os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | nofollow,
                dir_fd=directory_fd,
            )
            os.close(directory_fd)
            directory_fd = next_fd
        file_fd = os.open(
            relative.parts[-1],
            os.O_RDONLY | nofollow | getattr(os, 'O_NONBLOCK', 0),
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE_BYTES:
            return []
        chunks, total = [], 0
        while total <= MAX_FILE_BYTES:
            chunk = os.read(file_fd, MAX_FILE_BYTES + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > MAX_FILE_BYTES:
            return []
        return b''.join(chunks).decode(errors='replace').splitlines()
    except (OSError, RuntimeError):
        return []
    finally:
        if file_fd is not None:
            os.close(file_fd)
        if directory_fd is not None:
            os.close(directory_fd)


def prose_lines(lines):
    """Flags the lines inside multi-line string literals (Rust raw strings, triple quotes, template literals)."""
    flags, inside = [], None
    for line in lines:
        flag = inside is not None
        if inside is None:
            m = re.search(r'(r#*"|"""|\'\'\'|`)', line)
            if m:
                token = m.group(1)
                close = '"' + '#' * (len(token) - 2) if token.startswith('r') else token
                if close not in line[m.end():]:
                    inside, flag = close, True
        elif inside in line:
            inside = None
        flags.append(flag)
    return flags


def code_like(line):
    s = line.strip()
    return bool(s) and not s.startswith(('//', '#', '*', '/*', '"', "'")) and (s.endswith((';', '{', '}', ')', ',')) or '(' in s)


def groups_of(prompt, texts):
    """``[(weight, {stems})]``: one group per rare question word, with its synonyms."""
    n = len(texts)
    lowered = {f: '\n'.join(t).lower() for f, t in texts.items()}
    out = []
    for word in dict.fromkeys(re.findall(r'[A-Za-z]{4,}', prompt)):
        if word.lower() in STOP or word.lower().startswith(FRAME):
            continue
        s = stem(word)
        df = sum(1 for body in lowered.values() if s in body)
        if df == 0 or df / n > 0.5:
            continue
        members = {s}
        for g in SYN:
            if s in g or any(stem(x) == s for x in g):
                members |= {stem(x) for x in g}
        out.append((math.log(n / df) ** 2, members))
    return out


def windows(lines, groups, size=SIZE, doc=False):
    """``(score, groups held, first, last)`` of every window of ``size`` lines (1-based, inclusive)."""
    n = len(lines)
    required = sorted(range(len(groups)), key=lambda i: -groups[i][0])[:REQUIRED]
    low = [l.lower() for l in lines]
    ng = len(groups)
    pre = [[0] * (n + 1) for _ in range(ng)]
    for i, l in enumerate(low):
        for g, (_, members) in enumerate(groups):
            pre[g][i + 1] = pre[g][i] + sum(l.count(m) for m in members)
    prose, code = prose_lines(lines), [code_like(l) for l in lines]
    pp, cp = [0], [0]
    for i in range(n):
        pp.append(pp[-1] + (1 if prose[i] else 0))
        cp.append(cp[-1] + (1 if code[i] else 0))
    out = []
    for a in range(0, max(1, n - size + 1)):
        b = min(n, a + size)
        counts = [pre[g][b] - pre[g][a] for g in range(ng)]
        if not any(counts) or not all(counts[i] for i in required):
            continue
        got = sum(1 for c in counts if c)
        if not doc and ((pp[b] - pp[a]) / (b - a) > MAX_PROSE or (cp[b] - cp[a]) / (b - a) < MIN_DENSITY):
            continue
        score = sum(w * (1 + math.log(c)) for (w, _), c in zip(groups, counts) if c)
        out.append((score, got, a + 1, b))
    return out


def unit_score(lines, groups):
    body = '\n'.join(lines).lower()
    got, total = 0, 0.0
    for weight, members in groups:
        c = sum(body.count(m) for m in members)
        if c:
            got += 1
            total += weight * (1 + math.log(c))
    return got, total


def recentre(lines, a, b, groups):
    """The window of the same size centred on the weighted centroid of the group words inside ``[a, b]``."""
    weight = {}
    for n in range(a, b + 1):
        low = lines[n - 1].lower()
        weight[n] = sum(w for w, members in groups if any(m in low for m in members))
    total = sum(weight.values())
    if not total:
        return a, b
    centre = sum(n * w for n, w in weight.items()) / total
    size = b - a + 1
    lo = max(1, min(len(lines) - size + 1, round(centre - size / 2)))
    return lo, lo + size - 1


def snap(lines, a, b, reach=10):
    """``[a, b]`` widened to whole syntax: a window that starts inside a comment run starts at the run, and one that
    ends inside an open brace ends where it closes."""
    comment = lambda n: lines[n - 1].lstrip().startswith(('//', '#', '*', '/*'))
    n = a
    while n > 1 and a - n < reach and comment(n) and comment(n - 1):
        n -= 1
    a = n if comment(a) else a
    depth = 0
    for k in range(a, b + 1):
        depth += lines[k - 1].count('{') - lines[k - 1].count('}')
    k = b
    while depth > 0 and k < min(len(lines), b + reach):
        k += 1
        depth += lines[k - 1].count('{') - lines[k - 1].count('}')
    return a, (k if depth <= 0 else b)


def trim(lines, a, b, groups, context=2, floor=8):
    """``[a, b]`` cut to the lines that hold a group word, with ``context`` lines around them."""
    hit = [n for n in range(a, b + 1) if any(m in lines[n - 1].lower() for _, members in groups for m in members)]
    if not hit:
        return a, b
    lo, hi = max(a, hit[0] - context), min(b, hit[-1] + context)
    while hi - lo + 1 < floor and (lo > a or hi < b):
        lo, hi = max(a, lo - 1), min(b, hi + 1)
    return lo, hi


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req['repo_root'], req['prompt'], req.get('brief', '')
    texts = {f: read(root, f) for f in tracked(root)}
    texts = {f: t for f, t in texts.items() if t}
    if len(texts) < 4:
        return
    groups = groups_of(prompt, texts)
    if len(groups) < MIN_GROUPS:
        return
    names = {m for _, members in groups for m in members}
    scored, in_test = {}, {}
    for f, lines in texts.items():
        boost = 1.15 if any(m in Path(f).stem.lower() for m in names) else 1.0
        scored[f] = [(s * boost, g, a, b) for s, g, a, b in windows(lines, groups) if g >= MIN_WINDOW]
        if scored[f] and not TESTPATH.search(f):
            marked = set()
            for ua, ub, _ in units(f, lines):
                marked |= set(range(ua, ub + 1))
            scored[f] = [r for r in scored[f] if len(marked & set(range(r[2], r[3] + 1))) / (r[3] - r[2] + 1) < 0.5]
    drops, shown = [], {}
    for m in HEADER.finditer(brief):
        path, a, b, label = m.group(1), int(m.group(2)), int(m.group(3)), m.group(4)
        if re.search(r'definition|named by the prompt', label):
            shown.setdefault(path, []).append((a, b))
        else:
            drops.append(re.escape(f'{path}:{a}-{b}'))

    in_brief = {}
    for m in HEADER.finditer(brief):
        in_brief.setdefault(m.group(1), set()).update(range(int(m.group(2)), int(m.group(3)) + 1))

    def covered(path, a, b):
        have = set()
        for lo, hi in shown.get(path, []):
            have |= set(range(lo, hi + 1))
        return len(have & set(range(a, b + 1))) / max(1, b - a + 1)

    wants_tests = bool(re.search(r'(?i)\b(tests?|specs?|prov\w*|proof|cover\w*)\b', prompt))
    def boosted(s, f, a, b):
        return s * (BRIEF_BOOST if len(in_brief.get(f, set()) & set(range(a, b + 1))) / (b - a + 1) > 0.5 else 1.0)

    rows = sorted(((boosted(s, f, a, b), g, f, a, b) for f, rs in scored.items() for s, g, a, b in rs if not TESTPATH.search(f)),
                  key=lambda r: (-r[0], r[2], r[3]))
    chosen, per_file, used = [], {}, 0
    for s, g, f, a, b in rows:
        if len(chosen) >= MAX_SRC:
            break
        if per_file.get(f, 0) >= PER_FILE or covered(f, a, b) > 0.5:
            continue
        if any(c[0] == f and not (b < c[1] - 4 or a > c[2] + 4) for c in chosen):
            continue
        a, b = snap(texts[f], *trim(texts[f], *recentre(texts[f], a, b, groups), groups))
        size = sum(len(texts[f][n - 1]) + 8 for n in range(a, b + 1))
        if used + size > BYTES:
            continue
        chosen.append((f, a, b))
        per_file[f] = per_file.get(f, 0) + 1
        used += size
    names_re = '|'.join(sorted(re.escape(m) for m in names if len(m) >= 4))
    extra = []
    for f, a, b in list(chosen):
        if TESTPATH.search(f):
            continue
        for k in range(a, b + 1):
            d = DECL.match(texts[f][k - 1])
            if not d or not d.group(1) or not re.search(names_re, d.group(1).lower()):
                continue
            end = next((u[1] for u in [(0, k + 11)] if u), k + 11)
            found = pixel_json(root, 'find-symbol', d.group(1), '.').get('symbols', [])
            sym = next((x for x in found if x['path'] == f and x['start_line'] == k), None)
            if not sym or sym['end_line'] - sym['start_line'] > 12:
                continue
            callers = sorted(pixel_json(root, 'who-calls', sym['uid'], '.').get('edges', []), key=lambda e: (e['symbol']['path'], e['symbol']['start_line']))
            for e in callers[:1]:
                site = e.get('site_line') or e['symbol']['start_line']
                c = e['symbol']
                lo, hi = max(c['start_line'], site - 14), min(c['end_line'], site + 12)
                if not covered(c['path'], lo, hi) > 0.5:
                    extra.append((c['path'], lo, hi))
    for item in extra:
        if item not in chosen:
            chosen.append(item)
    if wants_tests:
        tests = []
        for f, lines in texts.items():
            boost = 1.15 if any(m in Path(f).stem.lower() for m in names) else 1.0
            for a, b, name in units(f, lines):
                got, total = unit_score(lines[a - 1:b], groups)
                if got >= MIN_GROUPS - 1 and total > 0:
                    tests.append((total * boost, f, a, b, name))
        best = {}
        for total, f, a, b, name in sorted(tests, key=lambda r: (-r[0], r[1], r[2])):
            dedicated = any(m in Path(f).stem.lower() for m in names)
            norm = re.sub(r'\d+', '', name)
            fam = '_'.join(norm.split('_')[:2]) if norm.count('_') >= 2 else norm
            slot = best.setdefault(f, [])
            if len(slot) < (2 if dedicated else 1) and all(x[3] != fam for x in slot):
                slot.append((total * (1.5 if dedicated else 1.0), a, b, fam, name))
        t_used, picks = 0, sorted(((x, f) for f, v in best.items() for x in v), key=lambda r: (-r[0][0], r[1], r[0][1]))
        seen_files = []
        for (total, a, b, fam, name), f in picks:
            if f not in seen_files:
                if len(seen_files) >= MAX_TEST:
                    continue
                seen_files.append(f)
            near = [u for u in units(f, texts[f]) if fam != re.sub(r'\d+', '', name) and re.sub(r'\d+', '', u[2]).startswith(fam + '_') and u[0] != a]
            group = [(a, b, name)] + sorted(near, key=lambda u: u[0])[:FAMILY - 1]
            for ua, ub, un in sorted(group):
                ub = min(ub, ua + TEST_CAP - 1)
                size = sum(len(texts[f][n - 1]) + 8 for n in range(ua, ub + 1) if texts[f][n - 1].strip())
                if t_used + size > TEST_BYTES:
                    continue
                t_used += size
                chosen.append((f, ua, ub))
    if not chosen:
        return
    if drops:
        print('drop: ^(?:' + '|'.join(drops) + ')')
    for f, a, b in sorted(chosen):
        kind = 'test' if TESTPATH.search(f) else 'code'
        print(f'### {f}:{a}-{b} — where the question\'s words meet ({kind})')
        print('\n'.join(f'{n}| {texts[f][n - 1][:200]}' for n in range(a, b + 1) if texts[f][n - 1].strip()))


main()
