"""config-registry: a setting question ("where do I set X", "which environment variables", "what port") is answered
by a registry built with rg over the working tree: key, value or fallback, where it is declared, where it is read.
Reads env reads in JS/TS/Python/Rust/Go/Ruby, typed env declarations, committed .env templates and the git-tracked
.env.development / .env.production (values that look like secrets are masked; untracked .env* are never read),
exported default constants and dev-server port settings. Read-only, deterministic."""
import ast
import io
import json
import os
import re
import subprocess
import sys
import time
import tokenize
from pathlib import Path

TEMPLATE_ENV = re.compile(r"^\.env\.(example|sample|template|dist|defaults?)$|^(example|sample)\.env$")
TRACKED_ENV = True  # tracked .env.development/.env.production are read; secret-looking values are masked
SECRETISH = re.compile(r"key|secret|token|password|passwd|credential|private|signature|config", re.I)

STOP = set("""about above after again against also another because been before being below between both could does doing down during each
from further have having here into just more most much once only other over same should some such than that their them then there these they this those
through under until very want what when where which while will with would your locally local want where want""".split()) | {"set", "run", "use", "app", "own", "the", "and", "for", "how", "can", "any", "not", "are", "you", "has", "get", "was", "its", "out"}

JS_READ = re.compile(r"(?:process\.env|import\.meta\.env)(?:\.|\[\s*[\"'])([A-Za-z_][A-Za-z0-9_]*)")
PREFIXED = re.compile(r"\b((?:VITE|REACT_APP|NEXT_PUBLIC|NUXT|EXPO_PUBLIC|PUBLIC)_[A-Z0-9_]{2,})\b")
PY_READ = re.compile(r"os\.(?:environ(?:\.get)?|getenv)\s*[\(\[]\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']")
RS_READ = re.compile(r"env::var(?:_os)?\(\s*\"([A-Za-z_][A-Za-z0-9_]*)\"|\benv\s*=\s*\"([A-Z_][A-Z0-9_]*)\"|\benv!\(\s*\"([A-Z_][A-Z0-9_]*)\"")
GO_READ = re.compile(r"os\.(?:Getenv|LookupEnv)\(\s*\"([A-Za-z_][A-Za-z0-9_]*)\"")
RB_READ = re.compile(r"\bENV(?:\[|\.fetch\()\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']")
ENV_DECL = re.compile(r"^\s*([A-Z][A-Z0-9_]{2,})\??\s*:\s*[A-Za-z<>\[\]| ]+;")
ENV_LINE = re.compile(r"^(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$")
CONST = re.compile(r"^\s*(?:pub(?:\([a-z]+\))?\s+)?(?:export\s+)?(?:const|static)\s+([A-Z][A-Z0-9_]{2,})\b[^=]*=\s*(.+?);?\s*$")
PYCONST = re.compile(r"^([A-Z][A-Z0-9_]{2,})\s*(?::[^=]+)?=\s*(.+)$")
PORT_CFG = re.compile(r"(?:\bport\s*[:=]\s*|--port[= ]|\bPORT=)([^,;}\n]+)", re.I)
DEFAULT_AFTER = re.compile(r"(?:\|\||\?\?)\s*([^;,)\n]+)|,\s*([\"'0-9][^)]*)\)")
SETTER_CALL = re.compile(r"\b[\w.]+\.(?:set|setDefault|set_default)\(\s*(['\"])([\w .-]+)\1\s*,\s*((?:'[^'\n]*'|\"[^\"\n]*\")|true|false|null|-?\d+(?:\.\d+)?)\s*\)")
CODE_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".py", ".rs", ".go", ".rb", ".vue", ".svelte")
RG_EXCL = ["!node_modules", "!target", "!dist", "!build", "!vendor", "!*.lock", "!yarn.lock", "!package-lock.json", "!*.min.js", "!*.map", "!*.snap", "!*.svg", "!*.json5"]
SCAN_MAX_COLUMNS = 300  # ripgrep counts bytes, including for UTF-8 input
SCAN_MAX_FILE_BYTES = 400 * 1024
SCOPED_SCAN_MAX_FILES = 160
SCOPED_SCAN_MAX_MS = 450
TRACKED_PATHS_MAX_BYTES = 4 * 1024 * 1024
TRACKED_PATHS_MAX_COUNT = 50_000
SCOPED_EVIDENCE_MAX = 3600
SCOPED_BLOCK_MAX_LINES = 72
PATTERNS = [r"process\.env|import\.meta\.env", r"(?:VITE|REACT_APP|NEXT_PUBLIC|NUXT|EXPO_PUBLIC)_[A-Z0-9_]{2,}",
            r"os\.(?:environ|getenv)", r"env::var|\benv\s*=\s*\"|env!\(", r"os\.(?:Getenv|LookupEnv)", r"\bENV(?:\[|\.fetch)",
            r"^\s*[A-Z][A-Z0-9_]{2,}\??\s*:\s*[A-Za-z<>\[\]| ]+;", r"^(?:export\s+)?[A-Z][A-Z0-9_]*=",
            r"^\s*(?:pub(?:\([a-z]+\))?\s+)?(?:export\s+)?(?:const|static)\s+[A-Z][A-Z0-9_]{2,}\b", r"^[A-Z][A-Z0-9_]{2,}\s*(?::[^=]+)?=",
             r"\bport\s*[:=]|--port|\bPORT=",
             r"\b[\w.]+\.(?:set|setDefault|set_default)\(\s*['\"][\w .-]+['\"]\s*,",
             r"\b(?:localStorage|sessionStorage)\.(?:getItem|setItem)\s*\("]


def git(clone, *a): return subprocess.run(["git", "-C", clone, *a], capture_output=True, text=True).stdout


def tracked(clone, rel):
    return bool(git(clone, "ls-files", "--", rel).strip())


_TRACKED_PATHS_CACHE = {}


def tracked_paths(clone, deadline=None):
    """Return a bounded, invocation-local inventory of tracked paths."""
    root = str(Path(clone).resolve())
    if root in _TRACKED_PATHS_CACHE:
        return _TRACKED_PATHS_CACHE[root]
    timeout = 0.25 if deadline is None else min(0.25, deadline - time.monotonic())
    if timeout <= 0:
        return None
    try:
        proc = subprocess.run(["git", "-C", root, "ls-files", "-z"], capture_output=True,
                              timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode or len(proc.stdout) > TRACKED_PATHS_MAX_BYTES:
        return None
    paths = proc.stdout.decode("utf-8", errors="replace").split("\0")
    if len(paths) > TRACKED_PATHS_MAX_COUNT:
        return None
    result = {path for path in paths if path}
    _TRACKED_PATHS_CACHE[root] = result
    return result


def scan(clone):
    """[(path, line, text)] of every line that may define or read a config key; .env* admitted only as templates."""
    cmd = ["rg", "-n", "--no-heading", "--no-messages", "--max-columns", str(SCAN_MAX_COLUMNS), "--hidden", "-g", "!.git", "-g", "!.pixel", "-g", "!.env*", "-g", "!*.env", "--max-filesize", str(SCAN_MAX_FILE_BYTES)]
    for g in RG_EXCL: cmd += ["-g", g]
    for p in PATTERNS: cmd += ["-e", p]
    try:
        out = subprocess.run(cmd + ["."], cwd=clone, capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return []   # no ripgrep, or too slow: no registry
    rows = []
    # Exclude all env files from rg before opening them; templates also require tracking.
    for rel in git(clone, "ls-files", "-z").split("\0"):
        base = os.path.basename(rel)
        if not (TEMPLATE_ENV.fullmatch(base) or re.fullmatch(r"\.env\.(development|production|local\.example)", base)):
            continue
        path = Path(clone) / rel
        if path.is_symlink() or not path.is_file() or path.stat().st_size > SCAN_MAX_FILE_BYTES:
            continue
        for n, text in enumerate(path.read_text(errors="replace").splitlines(), 1):
            if len(text.encode("utf-8")) <= SCAN_MAX_COLUMNS and ENV_LINE.match(text): rows.append((rel, n, text))
    for l in out.splitlines():
        m = re.match(r"\./(.+?):(\d+):(.*)$", l)
        if not m: continue
        path, n, text = m.group(1), int(m.group(2)), m.group(3)
        base = os.path.basename(path)
        if base.startswith(".env") or base.endswith(".env"):
            if not TEMPLATE_ENV.match(base) and not (TRACKED_ENV and re.match(r"\.env\.(development|production|local\.example)$", base) and tracked(clone, path)):
                continue
        elif not path.endswith(CODE_EXT + (".json", ".mts", ".yml", ".yaml", ".toml", ".mdx", ".md", ".d.ts")):
            continue
        if re.search(r"(^|/)(test|tests|__tests__|fixtures?|node_modules)/|\.(test|spec)\.", path): continue
        rows.append((path, n, text))
    # rg searches files in parallel: a stable order makes the registry (first reads, first declarations) deterministic.
    rows.sort(key=lambda row: (row[0], row[1]))
    return rows


def registry(clone, rows=None):
    """{key: {kind, defs:[(path,line,text,default)], reads:[(path,line,text)]}}"""
    reg = {}
    def ent(k): return reg.setdefault(k, {"defs": [], "reads": []})
    for path, n, text in scan(clone) if rows is None else rows:
        base = os.path.basename(path)
        code = path.endswith(CODE_EXT)
        if base.startswith(".env") or base.endswith(".env"):
            m = ENV_LINE.match(text)
            if m: ent(m.group(1))["defs"].append((path, n, text.strip(), m.group(2).strip().strip("'\"")))
            continue
        if code and re.search(r"(vite-env|env)\.d\.ts$", path):
            m = ENV_DECL.match(text)
            if m: ent(m.group(1))["defs"].append((path, n, text.strip(), ""))
            continue
        if code:
            keys = set(JS_READ.findall(text)) | set(PY_READ.findall(text)) | set(GO_READ.findall(text)) | set(RB_READ.findall(text)) | set(PREFIXED.findall(text))
            for g in RS_READ.findall(text): keys |= {x for x in g if x}
            d = DEFAULT_AFTER.search(text)
            for k in keys:
                ent(k)["reads"].append((path, n, text.strip(), (d.group(1) or d.group(2)).strip() if d else ""))
            m = CONST.match(text) or (PYCONST.match(text) if path.endswith(".py") else None)
            if m and not keys:
                val = m.group(2).strip() if m.lastindex and m.lastindex >= 2 else ""
                val = re.sub(r"\s*//.*$|\s*#.*$|;$", "", val).strip()
                if re.match(r"^[\"'\d\-\[]|^(true|false|Duration|Some|None)\b|^\d", val): ent(m.group(1))["defs"].append((path, n, text.strip(), val[:60]))
        if re.search(r"(\.config\.|package\.json|docker-compose|\.ya?ml$|\.toml$)", path):
            m = PORT_CFG.search(text)
            if m and re.search(r"\d", m.group(1)) and not PREFIXED.search(text) and not re.search(r"\"(build|preview|serve|test|docs?)[^\"]*\"\s*:", text) and not re.search(r"(^|/)(dev-docs|examples?|docs?|website|e2e|fixtures?)/", path):
                ent("dev-server port")["defs"].append((path, n, text.strip(), m.group(1).strip().strip('",')))
    return reg


IDS_WORDS = []

def stems(words):
    # Truncate to 6 chars and strip a trailing s so byte matches bytes, file matches files.
    out = set()
    for w in words:
        s = w[:6]
        if len(s) >= 4 and s.endswith("s") and not s.endswith("ss"):
            s = s[:-1]
        out.add(s)
    return out


BOUND_WORDS = stems(["max", "maximum", "min", "minimum", "bound", "bounds", "limit", "limited", "cap", "caps"])


def words_of(prompt):
    ws = [w for w in dict.fromkeys(re.findall(r"[a-z]{2,}", prompt.lower())) if w not in STOP and len(w) >= 3 or w == "ws"]
    return ws


WEAK = {"dev", "server", "app", "config", "setting", "file", "default", "value", "url", "locall", "local", "where"}
WEAK = WEAK | {w[:6] for w in WEAK}


def key_tokens(key):
    out = []
    for part in re.split(r"[_\-\s.]+", key):
        out += [part.lower()] if part.isupper() or part.islower() else [t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", part)]
    return [t for t in out if t]


def comment_above(clone, path, n, back=3):
    try: lines = (Path(clone) / path).read_text(errors="replace").splitlines()
    except OSError: return ""
    out = []
    for i in range(n - 2, max(-1, n - 2 - back), -1):
        if re.match(r"\s*(#|//|\*|/\*)", lines[i]): out.append(lines[i])
        else: break
    return " ".join(out)


def rank(clone, reg, prompt):
    ws = words_of(prompt); st = stems(ws)
    scored = []
    for k, e in reg.items():
        toks = key_tokens(k) if k != "dev-server port" else ["dev", "server", "port"]
        ktoks = stems(toks)
        strong = st - WEAK
        s = 3 * len(strong & ktoks) + len((st & ktoks) - strong)
        hay = ""
        for d in e["defs"][:2]: hay += " " + comment_above(clone, d[0], d[1]) + " " + d[2]
        hs = stems(re.findall(r"[a-z]{3,}", hay.lower()))
        s += 2 * len((strong & hs) - ktoks)
        if k == "dev-server port" and "port" in st: s += 3
        s += 2 if e["reads"] and any(not r[0].endswith(".rs") or "env" in r[2] for r in e["reads"]) else 0
        if (strong & ktoks) or (strong & hs): scored.append((s, len(e["defs"]) + len(e["reads"]), k))
    scored.sort(reverse=True)
    return [k for _, _, k in scored[:4]]


BOUND_QUERY = re.compile(r"\b(max(?:imum)?|min(?:imum)?|bounds?)\b", re.I)
EXISTING_CONFIG_INTENT = re.compile(r"\b(config\w*|settings?|env(ironment)?(\s+var\w*)?|variables?|flags?|options?|defaults?|ports?|overrid\w+|where do i set|set (that|this|it))\b", re.I)
BOUND_VALUE_WORDS = stems(["defined", "definition", "level", "size", "value", "number", "amount"])
MAX_WORDS = stems(["max", "maximum", "cap", "caps"])
MIN_WORDS = stems(["min", "minimum"])


def rank_bound(clone, reg, prompt):
    """Require a bound declaration and a prompt-specific subject for bound-only questions."""
    prompt_words = stems(words_of(prompt))
    subject = prompt_words - WEAK - BOUND_WORDS - BOUND_VALUE_WORDS
    if not subject: return []
    requested_max = bool(re.search(r"\bmax(?:imum)?\b", prompt, re.I))
    requested_min = bool(re.search(r"\bmin(?:imum)?\b", prompt, re.I))
    eligible = {}
    for key, entry in reg.items():
        key_words = stems(key_tokens(key))
        declarations = " ".join(row[2] for row in entry["defs"][:2])
        # Include the comment above each declaration, as rank() does: a bound word
        # ("cap", "limit") in the doc comment above a constant is a bound declaration
        # even when the constant's name carries none (e.g. BRIEF_BYTES, "Rendered size cap").
        comments = " ".join(comment_above(clone, d[0], d[1]) for d in entry["defs"][:2])
        declaration_words = stems(re.findall(r"[a-z]+", (declarations + " " + comments).lower()))
        has_bound = bool((key_words | declaration_words) & BOUND_WORDS)
        has_max = bool((key_words | declaration_words) & MAX_WORDS)
        has_min = bool((key_words | declaration_words) & MIN_WORDS)
        has_direction = not (requested_max or requested_min) or (requested_max and has_max) or (requested_min and has_min)
        if has_bound and has_direction and subject & (key_words | declaration_words):
            eligible[key] = entry
    return rank(clone, eligible, prompt)


def block(clone, path, n, ctx_before=0, ctx_after=0):
    try: lines = (Path(clone) / path).read_text(errors="replace").splitlines()
    except OSError: return []
    lo, hi = max(1, n - ctx_before), min(len(lines), n + ctx_after)
    return [f"### {path}:{lo}-{hi}"] + [f"{i}| {lines[i - 1][:150]}" for i in range(lo, hi + 1)]


def evidence_block(clone, key, path, n, before=0, after=0):
    """Keep coordinates, but never copy a secret-bearing source line into the brief."""
    lines = block(clone, path, n, before, after)
    return [line if i == 0 or not (SECRETISH.search(key) or SECRETISH.search(line))
            else line.split("|", 1)[0] + "| <masked>" for i, line in enumerate(lines)]


def setter_evidence(clone, rows, prompt):
    """Quote prompt-matched literal setting calls as source; do not infer precedence or effect."""
    prompt_words = stems(words_of(prompt))
    if not prompt_words: return ""
    root = Path(clone).resolve()
    tracked_paths = set(git(clone, "ls-files", "-z").split("\0"))
    candidates = []
    for path, n, text in rows:
        if path not in tracked_paths or not path.endswith((".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts")):
            continue
        if text.lstrip().startswith(("//", "/*", "*")) or len(text.encode("utf-8")) > SCAN_MAX_COLUMNS:
            continue
        full_path = root / path
        if full_path.is_symlink():
            continue
        resolved = full_path.resolve()
        if not resolved.is_relative_to(root) or not resolved.is_file() or resolved.stat().st_size > SCAN_MAX_FILE_BYTES:
            continue
        match = SETTER_CALL.search(text)
        if not match:
            continue
        key = match.group(2).strip()
        overlap = len(prompt_words & stems(re.findall(r"[a-z]+", key.lower())))
        if overlap:
            candidates.append((-overlap, path, n, key))
    blocks = []
    for _, path, n, key in sorted(candidates, key=lambda row: row[:3])[:4]:
        source_block = block(clone, path, n, 3, 3)
        if source_block:
            blocks.append(f"{source_block[0]} — literal setting call candidate; inspect surrounding control flow")
        for line in source_block[1:]:
            source = line.split("|", 1)[1].lstrip() if "|" in line else line
            if SECRETISH.search(key) or SECRETISH.search(source):
                line = line.split("|", 1)[0] + "| <masked>"
            blocks.append(line)
    return "\n".join(blocks) + ("\n" if blocks else "")


def scoped_source_files(clone, pattern, suffix, deadline):
    """Find bounded, tracked, regular source files matching a narrow source shape."""
    root = Path(clone).resolve()
    tracked_paths_for_root = tracked_paths(clone, deadline)
    if tracked_paths_for_root is None:
        return []
    try:
        suffixes = (suffix,) if isinstance(suffix, str) else suffix
        globs = [arg for item in suffixes for arg in ("-g", f"*{item}")]
        proc = subprocess.run(["rg", "-l", "--hidden", "-g", "!.git", "-g", "!target", "-g", "!node_modules",
                              "-g", "!tests", "-g", "!test", "-g", "!__tests__", "-g", "!*.test.*", *globs,
                              "--", pattern, "."], cwd=root, capture_output=True,
                             text=True, timeout=max(0.02, min(0.25, deadline - time.monotonic())))
    except (OSError, subprocess.SubprocessError):
        return []
    found = []
    for raw in sorted(proc.stdout.splitlines()):
        if time.monotonic() >= deadline or len(found) >= SCOPED_SCAN_MAX_FILES:
            break
        rel = raw.removeprefix("./")
        if rel not in tracked_paths_for_root or not rel.endswith(suffixes):
            continue
        full = root / rel
        try:
            if full.is_symlink() or not full.resolve().is_relative_to(root) or not full.is_file():
                continue
            if full.stat().st_size > SCAN_MAX_FILE_BYTES:
                continue
        except OSError:
            continue
        found.append((rel, full))
    return found


def rust_code_mask(source):
    """Replace Rust comments and quoted literals with spaces, preserving offsets."""
    out = list(source)
    i, n, block_depth = 0, len(source), 0
    state = "code"
    while i < n:
        if state == "code":
            if source.startswith("//", i):
                state = "line"
                out[i] = out[i + 1] = " "
                i += 2
                continue
            if source.startswith("/*", i):
                state, block_depth = "block", 1
                out[i] = out[i + 1] = " "
                i += 2
                continue
            # Raw strings may contain braces in examples or diagnostics.
            raw = re.match(r"r(#{0,8})\"", source[i:]) if source[i] == "r" else None
            if raw:
                state = "raw"
                raw_end = '"' + raw.group(1)
                for j in range(i, i + raw.end()):
                    if source[j] != "\n": out[j] = " "
                i += raw.end()
                continue
            if source[i] == '"':
                state = "string"
                out[i] = " "
                i += 1
                continue
            if source[i] == "'" and i + 2 < n and (source[i+2] == "'" or source[i+1] == "\\"):
                state = "char"
                out[i] = " "
                i += 1
                continue
        elif state == "line":
            if source[i] == "\n": state = "code"
            else: out[i] = " "
        elif state == "block":
            if source.startswith("/*", i):
                block_depth += 1
                out[i] = out[i+1] = " "
                i += 2
                continue
            if source.startswith("*/", i):
                block_depth -= 1
                out[i] = out[i+1] = " "
                i += 2
                if block_depth == 0: state = "code"
                continue
            if source[i] != "\n": out[i] = " "
        elif state == "raw":
            if source.startswith(raw_end, i):
                for j in range(i, i + len(raw_end)):
                    if source[j] != "\n": out[j] = " "
                i += len(raw_end)
                state = "code"
                continue
            if source[i] != "\n": out[i] = " "
        elif state in {"string", "char"}:
            closing = '"' if state == "string" else "'"
            if source[i] == "\\":
                out[i] = " "
                if i + 1 < n and source[i+1] != "\n": out[i+1] = " "
                i += 2
                continue
            if source[i] == closing: state = "code"
            if source[i] != "\n": out[i] = " "
        i += 1
    return "".join(out)


def rust_scopes(source, pattern):
    """Yield (start offset, end offset, body start offset) for braced Rust item matches."""
    masked = rust_code_mask(source)
    stack, matching = [], {}
    for pos, char in enumerate(masked):
        if char == "{":
            stack.append(pos)
        elif char == "}" and stack:
            matching[stack.pop()] = pos
    for match in re.finditer(pattern, masked, re.M):
        opening = match.end() - 1 if match.end() and masked[match.end() - 1] == "{" else masked.find("{", match.end())
        if opening < 0: continue
        closing = matching.get(opening)
        if closing is not None:
            yield match.start(), closing + 1, opening + 1


def rust_test_only(source, item_start, test_modules):
    """Exclude a cfg(test) item or any implementation nested under a cfg(test) module."""
    prefix = source[:item_start]
    attributes = re.search(r"(?:^|\n)(\s*#\[[^\n]+\]\s*)+$", prefix)
    if attributes and re.search(r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]", attributes.group(1)):
        return True
    return any(start < item_start < end for start, end in test_modules)


def source_range(path, source, start, end, note):
    first = source.count("\n", 0, start) + 1
    last = source.count("\n", 0, end) + 1
    lines = source.splitlines()
    lo, hi = max(1, first), min(len(lines), last)
    if hi - lo + 1 > SCOPED_BLOCK_MAX_LINES:
        hi = lo + SCOPED_BLOCK_MAX_LINES - 1
    return [f"### {path}:{lo}-{hi} — {note}"] + [f"{i}| {lines[i-1][:150]}" for i in range(lo, hi+1)]


def redact_source_range(lines, subject):
    """Preserve coordinates while masking secret-named subjects and lines."""
    if not lines: return lines
    return [line if index == 0 or not (SECRETISH.search(subject) or SECRETISH.search(line))
            else line.split("|", 1)[0] + "| <masked>" for index, line in enumerate(lines)]


def cli_setting_evidence(clone, prompt):
    """Find a prompt-named CLI setting and its function-scoped runtime derivation."""
    if not re.search(r"\b(config\w*|settings?|flags?|options?|defaults?|overrid\w+|where do i set|set (that|this|it))\b", prompt, re.I):
        return ""
    prompt_terms = stems(words_of(prompt)) - WEAK - BOUND_WORDS
    if not prompt_terms: return ""
    requested_short = {option[1:].lower() for option in re.findall(r"(?<![\w-])-[A-Za-z](?![\w-])", prompt)}
    deadline = time.monotonic() + SCOPED_SCAN_MAX_MS / 1000
    impls = scoped_source_files(clone, r"impl\s+Flag\s+for", ".rs", deadline)
    selected = None
    for rel, path in impls:
        if time.monotonic() >= deadline: break
        source = path.read_text(errors="replace")
        test_modules = [(start, end) for start, end, _body in rust_scopes(
            source, r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]\s*(?:(?:pub(?:\([^)]*\))?\s+)?mod\s+\w+\s*\{)")]
        for start, end, body_start in rust_scopes(source, r"^\s*impl\s+Flag\s+for\s+\w+\s*\{"):
            if rust_test_only(source, start, test_modules): continue
            body = source[body_start:end-1]
            name_method = next((m for m in rust_scopes(body, r"\bfn\s+name_long\s*\(")), None)
            short_method = next((m for m in rust_scopes(body, r"\bfn\s+name_short\s*\(")), None)
            update_method = next((m for m in rust_scopes(body, r"\bfn\s+update\s*\(")), None)
            if not update_method: continue
            name_text = body[name_method[2]:name_method[1]-1] if name_method else ""
            name_match = re.search(r"\"([a-z][a-z0-9_-]*)\"", name_text, re.I) if name_method else None
            option_tokens = stems(re.findall(r"[a-z]+", name_match.group(1).lower())) if name_match else set()
            overlap = option_tokens & prompt_terms
            short_char = None
            if short_method:
                short_start, short_end, short_body = short_method
                short_text = body[short_body:short_end-1]
                masked_short = rust_code_mask(short_text)
                for short_match in re.finditer(r"Some\s*\(\s*b(['\"])([A-Za-z0-9])\1\s*\)", short_text):
                    masked_span = masked_short[short_match.start():short_match.end()]
                    if re.search(r"\bSome\s*\(\s*b\s+\s*\)", masked_span):
                        short_char = short_match.group(2).lower()
                        break
            short_match = short_char in requested_short if short_char else False
            # An explicit short option is stronger identity than nearby prose.
            # In particular, "command-line" must not select --line-buffered
            # when the prompt explicitly asks about -j.
            if requested_short:
                if not short_match: continue
            elif not overlap:
                continue
            update_text = body[update_method[2]:update_method[1]-1]
            field = re.search(r"\bargs\.([a-z_][a-z0-9_]*)\s*=", update_text)
            if not field: continue
            selected = (rel, source, start, end, field.group(1), len(overlap), short_match)
            break
        if selected: break
    if not selected: return ""
    rel, impl_source, start, end, field, _score, _short_match = selected
    deadline = max(deadline, time.monotonic() + 0.2)
    consumers = scoped_source_files(clone, re.escape(field), ".rs", deadline)
    for consumer_rel, path in consumers:
        if time.monotonic() >= deadline: break
        source = path.read_text(errors="replace")
        # Most rg hits are comments, docs, or unrelated field mentions. Avoid
        # parsing their full Rust syntax trees unless the exact receiver exists.
        if f"low.{field}" not in source: continue
        for fn_start, fn_end, fn_body in rust_scopes(source, r"^\s*(?:(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn)\s+\w+\s*(?:<[^>]*>)?\s*\("):
            body = source[fn_body:fn_end-1]
            masked_body = rust_code_mask(body)
            if not re.search(r"\blow\." + re.escape(field) + r"\b", masked_body): continue
            if not re.search(r"\b(parallelism|available_[a-z_]+|unwrap_or(?:_else)?|if\s+let|match)\b", masked_body, re.I): continue
            positions = [m.start() for m in re.finditer(r"\blow\." + re.escape(field) + r"\b", masked_body)]
            if not positions: continue
            lo = max(fn_body, fn_body + min(positions) - 140)
            hi = min(fn_end - 1, fn_body + max(positions) + 180)
            blocks = source_range(consumer_rel, source, lo, hi, "matched setting consumed within one function")
            blocks += source_range(rel, impl_source, start, end, "matching CLI setting declaration and override")
            text = "\n".join(blocks) + "\n"
            return text[:SCOPED_EVIDENCE_MAX]
    return ""


COMPILED_SETTING_INTENT = re.compile(r"\b(compil\w*|implement\w*|use\w*|consumer|getter)\b", re.I)
JS_SOURCE_SUFFIXES = (".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts")


def js_function_ranges(source):
    """Yield braced JavaScript function bodies using an offset-preserving JS masker."""
    masked = js_code_mask(source)
    stack, matching = [], {}
    for pos, char in enumerate(masked):
        if char == "{":
            stack.append(pos)
        elif char == "}" and stack:
            matching[stack.pop()] = pos
    for match in re.finditer(r"\bfunction(?:\s+[A-Za-z_$][\w$]*)?\s*\(", masked):
        opening = masked.find("{", match.end())
        if opening < 0: continue
        closing = matching.get(opening)
        if closing is not None:
            yield match.start(), closing + 1, opening + 1


def js_code_mask(source):
    """Mask JavaScript comments and all quoted strings while preserving offsets and newlines."""
    out = list(source)
    i, state, escaped = 0, "code", False
    while i < len(source):
        ch = source[i]
        if state == "code":
            if source.startswith("//", i):
                out[i] = out[i + 1] = " "
                i += 2
                state = "line"
                continue
            if source.startswith("/*", i):
                out[i] = out[i + 1] = " "
                i += 2
                state = "block"
                continue
            if ch in "'\"`":
                out[i] = " "
                state = ch
                escaped = False
        elif state == "line":
            if ch == "\n": state = "code"
            else: out[i] = " "
        elif state == "block":
            if source.startswith("*/", i):
                out[i] = out[i + 1] = " "
                i += 2
                state = "code"
                continue
            if ch != "\n": out[i] = " "
        else:
            if ch == "\n":
                i += 1
                continue
            if escaped:
                out[i] = " "
                escaped = False
                i += 1
                continue
            if ch == "\\":
                out[i] = " "
                escaped = True
                i += 1
                continue
            if ch == state: state = "code"
            out[i] = " "
        i += 1
    return "".join(out)


def active_string_match(source, pattern, expected, accepts=None):
    """Find a literal-bearing match and reject occurrences that are only comments or strings."""
    masked = js_code_mask(source)
    for match in re.finditer(pattern, source):
        segment = masked[match.start():match.end()]
        if expected(segment) and (accepts is None or accepts(match)):
            return match
    return None


def compiled_setting_evidence(clone, prompt, rows):
    """Link a named setting's source compiler to the exact named getter that consumes it."""
    if not COMPILED_SETTING_INTENT.search(prompt): return ""
    dotted = re.search(r"\b([a-z_$][\w$]*)\.([a-z_$][\w$]*)\b", prompt)
    if not dotted: return ""
    receiver, property_name = dotted.groups()
    prompt_words = stems(words_of(prompt)) - WEAK - BOUND_WORDS
    root = Path(clone).resolve()
    tracked_inventory = tracked_paths(clone, time.monotonic() + SCOPED_SCAN_MAX_MS / 1000)
    if tracked_inventory is None: return ""

    settings = []
    for path, number, text in rows:
        if path not in tracked_inventory or not path.endswith(JS_SOURCE_SUFFIXES): continue
        if text.lstrip().startswith(("//", "/*", "*")) or len(text.encode("utf-8")) > SCAN_MAX_COLUMNS: continue
        match = SETTER_CALL.search(text)
        if not match: continue
        setting = match.group(2).strip()
        setting_words = stems(re.findall(r"[a-z]+", setting.lower()))
        overlap = len(prompt_words & setting_words)
        if overlap:
            settings.append((-overlap, len(setting_words), path, setting))
    if not settings: return ""

    deadline = time.monotonic() + SCOPED_SCAN_MAX_MS / 1000
    bytes_read = 0
    for _negative_overlap, _word_count, setting_path, setting in sorted(set(settings))[:3]:
        if time.monotonic() >= deadline: break
        setting_file = root / setting_path
        try:
            if setting_file.is_symlink() or not setting_file.resolve().is_relative_to(root): continue
            if not setting_file.is_file() or setting_file.stat().st_size > SCAN_MAX_FILE_BYTES: continue
            setting_source = setting_file.read_text(errors="replace")
            bytes_read += setting_file.stat().st_size
            if bytes_read > TRACKED_PATHS_MAX_BYTES: break
        except OSError:
            continue
        compiler_binding = None
        setter_span = None
        compiled_key = setting + " fn"
        for start, end, body_start in js_function_ranges(setting_source):
            body = setting_source[body_start:end-1]
            for case in re.finditer(r"case\s*(['\"])(.*?)\1\s*:", body):
                if case.group(2) != setting: continue
                case_mask = js_code_mask(body)[case.start():case.end()]
                if not re.search(r"\bcase\s*:", case_mask): continue
                compile_call = active_string_match(
                    body,
                    r"this\s*\.\s*set\s*\(\s*(['\"])(.*?)\1\s*,\s*([A-Za-z_$][\w$]*)\s*\(\s*[A-Za-z_$][\w$]*\s*\)",
                    lambda segment: bool(re.search(r"\bthis\s*\.\s*set\s*\(\s*,\s*[A-Za-z_$][\w$]*\s*\(", segment)),
                    lambda match: match.group(2) == compiled_key)
                if not compile_call or compile_call.start() < case.end(): continue
                intervening_case = active_string_match(
                    body[case.end():compile_call.start()], r"case\s*(['\"])(.*?)\1\s*:",
                    lambda segment: bool(re.search(r"\bcase\s*:", segment)))
                if intervening_case: continue
                compiler_binding = compile_call.group(3)
                setter_span = (start, end)
                break
            if compiler_binding: break
        if not compiler_binding: continue

        import_pattern = re.compile(
            r"\b(?:var|let|const)\s+" + re.escape(compiler_binding) +
            r"\s*=\s*require\(\s*(['\"])(\.[^'\"]+)\1\s*\)\.([A-Za-z_$][\w$]*)")
        imported = active_string_match(setting_source, import_pattern,
                                       lambda segment: bool(re.search(r"\b(?:var|let|const)\s+" + re.escape(compiler_binding) +
                                                                      r"\s*=\s*require\s*\(\s*\)\s*\.\s*[A-Za-z_$][\w$]*", segment)),
                                       lambda match: match.group(3) == compiler_binding)
        if not imported: continue
        module = imported.group(2)
        if not module.startswith("."): continue
        module_base = (setting_file.parent / module).resolve()
        compiler_path = None
        compiler_source = None
        for suffix in JS_SOURCE_SUFFIXES:
            target = Path(str(module_base) + suffix)
            try:
                if target.is_symlink() or not target.resolve().is_relative_to(root): continue
                rel = target.relative_to(root).as_posix()
                if rel not in tracked_inventory or not target.is_file() or target.stat().st_size > SCAN_MAX_FILE_BYTES: continue
                compiler_source = target.read_text(errors="replace")
                bytes_read += target.stat().st_size
                if bytes_read > TRACKED_PATHS_MAX_BYTES:
                    compiler_source = None
                    break
                compiler_path = rel
                break
            except (OSError, ValueError):
                continue
        if not compiler_source or not compiler_path: continue
        compiler_ranges = []
        for start, end, _body in js_function_ranges(compiler_source):
            prefix = compiler_source[max(0, start - 100):start]
            if re.search(r"\bexports\s*\.\s*" + re.escape(compiler_binding) + r"\s*=\s*$", prefix) or \
               re.search(r"\bfunction\s+" + re.escape(compiler_binding) + r"\s*\(", compiler_source[start:end]):
                compiler_ranges.append((start, end))
        if len(compiler_ranges) != 1: continue
        compiler_start, compiler_end = compiler_ranges[0]

        getter_pattern = r"defineGetter\s*\(\s*" + re.escape(receiver) + r"\s*,\s*(['\"])" + re.escape(property_name) + r"\1\s*,\s*function(?:\s+[A-Za-z_$][\w$]*)?\s*\("
        consumer_files = scoped_source_files(clone, r"\bdefineGetter\s*\(", JS_SOURCE_SUFFIXES, deadline)
        for consumer_rel, consumer_file in consumer_files:
            if time.monotonic() >= deadline: break
            try:
                if consumer_file.is_symlink() or not consumer_file.resolve().is_relative_to(root): continue
                if not consumer_file.is_file() or consumer_file.stat().st_size > SCAN_MAX_FILE_BYTES: continue
                bytes_read += consumer_file.stat().st_size
                if bytes_read > TRACKED_PATHS_MAX_BYTES: break
                source = consumer_file.read_text(errors="replace")
            except OSError:
                continue
            getter = active_string_match(source, getter_pattern,
                lambda segment: bool(re.search(r"\bdefineGetter\s*\(\s*" + re.escape(receiver) +
                                               r"\s*,\s*,\s*function(?:\s+[A-Za-z_$][\w$]*)?\s*\(", segment)))
            if not getter: continue
            functions = [(start, end) for start, end, _body in js_function_ranges(source)
                         if getter.start() <= start <= getter.end() + 20]
            for fn_start, fn_end in functions:
                body = source[fn_start:fn_end]
                key_access = active_string_match(body,
                    r"\.\s*get\s*\(\s*(['\"])(.*?)\1\s*\)",
                    lambda segment: bool(re.search(r"\.\s*get\s*\(\s*\)", segment)),
                    lambda match: match.group(2) == compiled_key)
                if not key_access: continue
                getter_span = (getter.start(), fn_end)
                lines = redact_source_range(source_range(consumer_rel, source, *getter_span,
                                                          "named getter reads the matching compiled setting"), setting)
                setter_lines = redact_source_range(source_range(setting_path, setting_source, *setter_span,
                                                                 "setting branch installs a compiled function"), setting)
                compiler_lines = redact_source_range(source_range(compiler_path, compiler_source, compiler_start, compiler_end,
                                                                   "exact imported setting compiler implementation"), setting)
                return "\n".join(setter_lines + compiler_lines + lines) + "\n"
    return ""


STORAGE_CALL = re.compile(r"\b(localStorage|sessionStorage)\.(getItem|setItem)\s*\(\s*([^,\n)]+)", re.I)
PERSISTENCE_INTENT = re.compile(r"\b(persist\w*|session\w*|remember\w*|restore\w*|startup|initial|load\w*)\b", re.I)
PERSISTENCE_WORDS = stems(["persist", "persistence", "session", "remember", "restore", "startup", "initial", "load"])


def storage_key_tokens(expression):
    expression = re.split(r"\bas\b", expression, maxsplit=1, flags=re.I)[0]
    return stems(re.findall(r"[A-Za-z]+", expression.lower()))


SENSITIVE_STORAGE_WORDS = {"key", "secret", "token", "password", "passwd", "credential", "private", "signature", "config"}


def storage_text_is_sensitive(text):
    return bool(set(key_tokens(text)) & SENSITIVE_STORAGE_WORDS)


def storage_key_declaration(clone, source_path, source, expression):
    """Resolve an imported object member only through a relative, tracked import."""
    match = re.search(r"\b([A-Z][A-Z0-9_]*)\.([A-Z][A-Z0-9_]*)\b", expression)
    if not match: return []
    obj, member = match.groups()
    import_match = re.search(r"import\s*\{([^}]+)\}\s*from\s*['\"]([^'\"]+)['\"]", source)
    if not import_match or not re.search(r"\b" + re.escape(obj) + r"\b", import_match.group(1)): return []
    module = import_match.group(2)
    if not module.startswith("."): return []
    root = Path(clone).resolve()
    base = (root / source_path).parent / module
    targets = [base.with_suffix(ext) for ext in (".ts", ".tsx", ".js", ".jsx", ".mts", ".mjs")]
    tracked_paths_for_root = tracked_paths(clone)
    if tracked_paths_for_root is None: return []
    for target in targets:
        try:
            if not target.resolve().is_relative_to(root) or target.is_symlink() or not target.is_file(): continue
            rel = target.relative_to(root).as_posix()
            if rel not in tracked_paths_for_root or target.stat().st_size > SCAN_MAX_FILE_BYTES: continue
            target_source = target.read_text(errors="replace")
        except (OSError, ValueError):
            continue
        for start, end, body_start in rust_scopes(target_source, r"\b(?:const|let)\s+" + re.escape(obj) + r"\s*=\s*\{"):
            body = target_source[body_start:end-1]
            key_match = re.search(r"(?m)^\s*" + re.escape(member) + r"\s*:\s*([^,\n]+)", body)
            if key_match:
                absolute = body_start + key_match.start()
                lines = source_range(rel, target_source, absolute, absolute + len(key_match.group()), "imported storage-key declaration")
                if storage_text_is_sensitive(member):
                    lines = [lines[0]] + [line.split("|", 1)[0] + "| <masked>" for line in lines[1:]]
                return lines
    return []


def browser_preference_evidence(clone, prompt):
    """Pair subject-matched browser preference reads and writes by exact storage key."""
    if not PERSISTENCE_INTENT.search(prompt): return ""
    subject = stems(words_of(prompt)) - WEAK - PERSISTENCE_WORDS - BOUND_WORDS
    if not subject: return ""
    root = Path(clone).resolve()
    deadline = time.monotonic() + SCOPED_SCAN_MAX_MS / 1000
    source_files = scoped_source_files(clone, r"\b(?:localStorage|sessionStorage)\.(?:getItem|setItem)\s*\(",
                                       (".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts"), deadline)
    candidates = []
    for rel, path in source_files:
        if time.monotonic() >= deadline: break
        try:
            if path.is_symlink() or not path.resolve().is_relative_to(root) or path.stat().st_size > SCAN_MAX_FILE_BYTES: continue
            source = path.read_text(errors="replace")
        except OSError:
            continue
        calls = []
        for match in STORAGE_CALL.finditer(source):
            key = match.group(3).strip()
            key_words = storage_key_tokens(key)
            if not subject & key_words: continue
            calls.append((match.group(1).lower(), match.group(2).lower(), key, match.start()))
        for storage in sorted({call[0] for call in calls}):
            for key in sorted({call[2] for call in calls if call[0] == storage}):
                modes = {call[1] for call in calls if call[0] == storage and call[2] == key}
                if not {"getitem", "setitem"}.issubset(modes): continue
                positions = [call[3] for call in calls if call[0] == storage and call[2] == key]
                candidates.append((rel, path, source, key, min(positions), max(positions)))
    if not candidates: return ""
    candidates.sort(key=lambda item: (item[0], item[4], item[3]))
    rel, path, source, key, first, last = candidates[0]
    lines = source.splitlines()
    first_line, last_line = source.count("\n", 0, first) + 1, source.count("\n", 0, last) + 1
    lo, hi = max(1, first_line - 3), min(len(lines), last_line + 5)
    if hi - lo + 1 > SCOPED_BLOCK_MAX_LINES: hi = lo + SCOPED_BLOCK_MAX_LINES - 1
    header = f"### {rel}:{lo}-{hi} — browser preference read/write using the same subject-matched storage key; active runtime conditions unknown"
    block_lines = [header]
    sensitive_key = storage_text_is_sensitive(key)
    for number in range(lo, hi + 1):
        line = lines[number - 1][:150]
        block_lines.append(f"{number}| " + ("<masked>" if sensitive_key or storage_text_is_sensitive(line) else line))
    declaration = storage_key_declaration(clone, rel, source, key)
    blocks = block_lines + declaration
    return ("\n".join(blocks) + "\n")[:SCOPED_EVIDENCE_MAX]


def declaration_candidates(clone, key, defs):
    """A source coordinate identifies a declaration; a shared spelling proves no binding or precedence."""
    heads = [f"- {key} | {len(defs)} distinct declaration candidates; lexical binding and override precedence unknown"]
    blocks = []
    for path, n, _text, value in defs[:4]:
        heads.append(f"  - {key} @ {path}:{n} | candidate value {mask(key, value) or 'unknown'}")
        # Context preserves the surrounding scope as evidence, not a guessed resolution.
        blocks += evidence_block(clone, key, path, n, 2, 2)
    if len(defs) > 4:
        heads.append(f"  - {len(defs) - 4} additional candidates omitted; no unique default established")
    return heads, blocks


def mask(key, val):
    """A value of a key whose name looks like a secret is never printed, whatever its length."""
    return "<masked>" if val and SECRETISH.search(key) else val


LOADER_MAX_FILES = 256
LOADER_MAX_LINES = 80
LOADER_MAX_HELPERS = 3
LOADER_MAX_CANDIDATES = 2
LOADER_MAX_CHARS = 6000


def loader_body_nodes(fn):
    nodes = [n for stmt in fn.body for n in ast.walk(stmt)]
    return [] if any(isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)) for n in nodes) else nodes


def loader_source_rows(source, fn):
    lines = source.splitlines()
    omitted = set()
    for n in loader_body_nodes(fn):
        if isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant) and isinstance(n.value.value, str):
            omitted.update(range(n.lineno, n.end_lineno + 1))
    replacements = {}
    for tok in tokenize.generate_tokens(io.StringIO(source).readline):
        if not (fn.lineno <= tok.start[0] <= fn.end_lineno) or tok.start[0] in omitted:
            continue
        if tok.type not in (tokenize.STRING, tokenize.NUMBER, tokenize.COMMENT,
                            getattr(tokenize, 'FSTRING_MIDDLE', -1), getattr(tokenize, 'TSTRING_MIDDLE', -1)):
            continue
        for line in range(tok.start[0], tok.end[0] + 1):
            lo = tok.start[1] if line == tok.start[0] else 0
            hi = tok.end[1] if line == tok.end[0] else len(lines[line - 1])
            replacements.setdefault(line, []).append((lo, hi, '' if tok.type == tokenize.COMMENT else '<masked>'))
    rows = []
    for n in range(fn.lineno, fn.end_lineno + 1):
        if n in omitted:
            continue
        text = lines[n - 1]
        for lo, hi, value in sorted(replacements.get(n, []), reverse=True):
            text = text[:lo] + value + text[hi:]
        if text.strip():
            rows.append((n, text))
    return rows


def loader_evidence(root, prompt):
    if not re.search(r'\b(env\w*|overrid\w*|load\w*|precedence)\b', prompt, re.I):
        return ''
    paths = subprocess.run(['git', '-C', str(root), 'ls-files', '-z', '--', '*.py'],
                           text=True, capture_output=True, check=True).stdout.split('\0')
    candidates = []
    for rel in sorted(p for p in paths if p)[:LOADER_MAX_FILES]:
        path = Path(root) / rel
        if path.is_symlink() or path.name.startswith('.env') or not path.is_file():
            continue
        if path.stat().st_size > SCAN_MAX_FILE_BYTES or re.search(r'(^|/)(tests?|fixtures?|vendor)/', rel):
            continue
        try:
            source = path.read_text()
            if 'os.environ' not in source and 'os.getenv' not in source:
                continue
            tree = ast.parse(source)
        except (OSError, UnicodeError, SyntaxError):
            continue
        # A deliberately small shape: direct os import, dynamic env-name parameter,
        # followed through the same class. No imports, overrides or bindings guessed.
        if not any(isinstance(n, ast.Import) and any(a.name == 'os' and a.asname is None for a in n.names) for n in tree.body):
            continue
        for cls in (n for n in tree.body if isinstance(n, ast.ClassDef)):
            methods = {n.name: n for n in cls.body if isinstance(n, ast.FunctionDef) and not n.decorator_list}
            for fn in methods.values():
                params = {a.arg for a in fn.args.args}
                if not fn.args.args:
                    continue
                receiver = fn.args.args[0].arg
                reads = [n for n in loader_body_nodes(fn) if isinstance(n, ast.Call) and n.args
                         and ast.unparse(n.func) in ('os.environ.get', 'os.getenv')
                         and isinstance(n.args[0], ast.Name) and n.args[0].id in params]
                names = {n.targets[0].id for n in loader_body_nodes(fn) if isinstance(n, ast.Assign)
                         and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.value in reads}
                forwards = [n for n in loader_body_nodes(fn) if isinstance(n, ast.Call) and n.args
                            and isinstance(n.func, ast.Attribute) and isinstance(n.func.value, ast.Name)
                            and n.func.value.id == receiver and n.func.attr in methods
                            and isinstance(n.args[0], ast.Name) and n.args[0].id in names]
                if not forwards:
                    continue
                chain, pending = [fn], [methods[n.func.attr] for n in forwards]
                while pending and len(chain) < LOADER_MAX_HELPERS:
                    node = pending.pop(0)
                    if node in chain:
                        continue
                    chain.append(node)
                    for call in (n for n in loader_body_nodes(node) if isinstance(n, ast.Call)):
                        target = call.func
                        if isinstance(target, ast.Attribute) and isinstance(target.value, ast.Name) and target.value.id == receiver and target.attr in methods and methods[target.attr] not in chain:
                            pending.append(methods[target.attr])
                if not any(isinstance(n, ast.Subscript) and isinstance(n.ctx, ast.Store)
                           and isinstance(n.value, ast.Name) and n.value.id == receiver
                           for method in chain for n in loader_body_nodes(method)):
                    continue
                selected = ([methods['__init__']] if '__init__' in methods and methods['__init__'] not in chain else []) + chain
                rows = [(n, text) for method in selected for n, text in loader_source_rows(source, method)]
                if len(rows) > LOADER_MAX_LINES or any(len(t.encode()) > SCAN_MAX_COLUMNS for _, t in rows):
                    continue
                out = ['### configuration loader — dynamic environment-name lookup, same-class helper candidates and mapping writes. Conditions and parameters are source evidence; runtime dispatch, active mode, file contents and effective values unknown. Literal values masked.']
                if pending:
                    out.append('Additional helper candidates omitted; chain is incomplete.')
                previous = -1
                for n, text in rows:
                    if n != previous + 1:
                        out.append(f'### {rel}:{n}-{n} — loader evidence')
                    else:
                        header = next(i for i in range(len(out)-1, -1, -1) if out[i].startswith('### '))
                        out[header] = re.sub(r'-(\d+) —', f'-{n} —', out[header])
                    out.append(f'{n}| {text}')
                    previous = n
                out[0] += f' Candidate {cls.name}.{fn.name} @ {rel}:{fn.lineno}.'
                candidates.append('\n'.join(out) + '\n')
    if not candidates:
        return ''
    selected = []
    for candidate in candidates[:LOADER_MAX_CANDIDATES]:
        if len(''.join(selected)) + len(candidate) <= LOADER_MAX_CHARS:
            selected.append(candidate)
    result = ''.join(selected)
    if result and len(candidates) > len(selected):
        result += f'Additional loader candidates omitted: {len(candidates)-len(selected)}; no unique loader established.\n'
    return result


INTENT = re.compile(r"\b(config\w*|settings?|env(ironment)?(\s+var\w*)?|variables?|flags?|options?|defaults?|ports?|overrid\w+|where do i set|set (that|this|it)|max(?:imum)?|min(?:imum)?|bounds?)\b", re.I)


def emit(clone, prompt, brief):
    if not Path(clone).exists() or not INTENT.search(prompt): return ""
    global IDS_WORDS
    IDS_WORDS = words_of(prompt)
    scoped = cli_setting_evidence(clone, prompt) + browser_preference_evidence(clone, prompt)
    if scoped:
        return scoped[:9000]
    loader = loader_evidence(clone, prompt)
    rows = scan(clone)
    compiled = compiled_setting_evidence(clone, prompt, rows)
    if compiled:
        return compiled[:9000]
    reg = registry(clone, rows)
    bound_only = bool(BOUND_QUERY.search(prompt)) and not EXISTING_CONFIG_INTENT.search(prompt)
    keys = rank_bound(clone, reg, prompt) if bound_only else rank(clone, reg, prompt)
    setters = setter_evidence(clone, rows, prompt)
    prefix = (loader + setters)[:9000]
    if not keys: return prefix
    envfiles = [f for f in git(clone, "ls-files", "--", ".env*", "*/.env*").split() if os.path.basename(f).startswith(".env")]
    head = [f"### config registry — keys matching {', '.join(IDS_WORDS[:6])} (key | value or fallback | declared | read at)"]
    blocks, seen = [], set()
    for k in keys:
        e = reg[k]
        defs = sorted(e["defs"], key=lambda d: (not os.path.basename(d[0]).startswith(".env"), d[0]))
        if len(defs) > 1:
            candidate_heads, candidate_blocks = declaration_candidates(clone, k, defs)
            head += candidate_heads
            blocks += candidate_blocks
            for r in e["reads"][:2]:
                blocks += evidence_block(clone, k, r[0], r[1], 1, 2)
            continue
        d0 = defs[0] if defs else None
        fileval = next(((d[0], d[1], mask(k, d[3])) for d in defs if os.path.basename(d[0]).startswith(".env") and d[3]), None)
        fallback = mask(k, next((r[3] for r in e["reads"] if r[3]), "") or next((d[3] for d in defs if d[3] and not os.path.basename(d[0]).startswith(".env")), ""))
        isenv = bool(e["reads"]) or any(d[0].endswith("env.d.ts") or os.path.basename(d[0]).startswith(".env") for d in defs)
        val = f"set in {fileval[0]}:{fileval[1]} = {fileval[2]}" + (f" (code fallback {fallback})" if fallback else "") if fileval else \
              ((f"code fallback {fallback}; an env file may override" if isenv else f"constant default {fallback}") if fallback else "no value in indexed files")
        reads = [f"{r[0]}:{r[1]}" for r in e["reads"][:3]]
        decl = [f"{d[0]}:{d[1]}" for d in defs[:1]]
        head.append(f"- {k} | {val} | {decl[0] if decl else 'not declared'} | read at {', '.join(reads) or 'no code read'}"
                    + (f" (+{len(e['reads']) - 3} more)" if len(e["reads"]) > 3 else "") + (f" (+{len(defs) - 1} more declarations)" if len(defs) > 1 else ""))
        shown = defs[:1] + ([fileval and next(d for d in defs if d[0] == fileval[0])] if fileval and defs[:1] and defs[0][0] != fileval[0] else [])
        for d in [x for x in shown if x]:
            span = comment_above(clone, d[0], d[1]).count("//") + comment_above(clone, d[0], d[1]).count("#")
            if (d[0], d[1]) not in seen:
                seen.add((d[0], d[1])); b = evidence_block(clone, k, d[0], d[1], min(span, 3), 0)
                if k == "dev-server port": b = evidence_block(clone, k, d[0], d[1], 1, 1)
                if os.path.basename(d[0]).startswith(".env"): b = [re.sub(r"=(.*)$", lambda m: "=<masked>" if SECRETISH.search(x.split("=")[0].split("|")[-1]) or SECRETISH.search(k) else m.group(0), x) for x in b]
                blocks += b
        for r in e["reads"][:2]:
            if (r[0], r[1]) not in seen:
                seen.add((r[0], r[1])); blocks += evidence_block(clone, k, r[0], r[1], 1, 2)
    if envfiles: head.append("env files in the repo (names only; local .env* are never indexed): " + ", ".join(sorted(envfiles)[:6]))
    remaining = max(0, 9000 - len(prefix))
    registry_output = ("\n".join(head + blocks) + "\n")[:remaining]
    return prefix + registry_output


def main():
    req = json.load(sys.stdin)
    text = emit(req["repo_root"], req["prompt"], req.get("brief", ""))
    if text.strip():
        sys.stdout.write(text)


main()
