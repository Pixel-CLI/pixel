"""config-registry: a setting question ("where do I set X", "which environment variables", "what port") is answered
by a registry built with rg over the working tree: key, value or fallback, where it is declared, where it is read.
Reads env reads in JS/TS/Python/Rust/Go/Ruby, typed env declarations, committed .env templates and the git-tracked
.env.development / .env.production (values that look like secrets are masked; untracked .env* are never read),
exported default constants and dev-server port settings. Read-only, deterministic."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

TEMPLATE_ENV = re.compile(r"^\.env\.(example|sample|template|dist|defaults?)$|^(example|sample)\.env$")
TRACKED_ENV = True  # tracked .env.development/.env.production are read; secret-looking values are masked
SECRETISH = re.compile(r"key|secret|token|password|passwd|credential|private|signature|config", re.I)

STOP = set("""about above after again against also another because been before being below between both could does doing down during each
from further have having here into just more most much once only other over same should some such than that their them then there these they this those
through under until very want what when where which while will with would your locally local want where want""".split()) | {"set", "run", "use", "app", "own", "the", "and", "for", "how", "can", "any", "not", "are", "you", "has", "get", "was", "its", "out"}

JS_READ = re.compile(r"(?:process\.env|import\.meta\.env)(?:\.|\[\s*[\"'])([A-Za-z_][A-Za-z0-9_]*)")
PREFIXED = re.compile(r"\b((?:VITE|REACT_APP|NEXT_PUBLIC|NUXT|EXPO_PUBLIC|PUBLIC)_[A-Z0-9_]{2,})\b")
PY_READ = re.compile(r"os\.(?:environ(?:\.get)?|getenv)\s*[\(\[]\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']")
RS_READ = re.compile(r"env::var(?:_os)?\(\s*\"([A-Za-z_][A-Za-z0-9_]*)\"|\benv\s*=\s*\"([A-Z_][A-Z0-9_]*)\"|\benv!\(\s*\"([A-Z_][A-Z0-9_]*)\"")
GO_READ = re.compile(r"os\.(?:Getenv|LookupEnv)\(\s*\"([A-Za-z_][A-Za-z0-9_]*)\"")
RB_READ = re.compile(r"\bENV(?:\[|\.fetch\()\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']")
ENV_DECL = re.compile(r"^\s*([A-Z][A-Z0-9_]{2,})\??\s*:\s*[A-Za-z<>\[\]| ]+;")
ENV_LINE = re.compile(r"^(?:export\s+)?([A-Z][A-Z0-9_]*)=(.*)$")
CONST = re.compile(r"^\s*(?:pub(?:\([a-z]+\))?\s+)?(?:export\s+)?(?:const|static)\s+([A-Z][A-Z0-9_]{2,})\b[^=]*=\s*(.+?);?\s*$")
PYCONST = re.compile(r"^([A-Z][A-Z0-9_]{2,})\s*(?::[^=]+)?=\s*(.+)$")
PORT_CFG = re.compile(r"(?:\bport\s*[:=]\s*|--port[= ]|\bPORT=)([^,;}\n]+)", re.I)
DEFAULT_AFTER = re.compile(r"(?:\|\||\?\?)\s*([^;,)\n]+)|,\s*([\"'0-9][^)]*)\)")
CODE_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".py", ".rs", ".go", ".rb", ".vue", ".svelte")
RG_EXCL = ["!node_modules", "!target", "!dist", "!build", "!vendor", "!*.lock", "!yarn.lock", "!package-lock.json", "!*.min.js", "!*.map", "!*.snap", "!*.svg", "!*.json5"]
SCAN_MAX_COLUMNS = 300  # ripgrep counts bytes, including for UTF-8 input
SCAN_MAX_FILE_BYTES = 400 * 1024
PATTERNS = [r"process\.env|import\.meta\.env", r"(?:VITE|REACT_APP|NEXT_PUBLIC|NUXT|EXPO_PUBLIC)_[A-Z0-9_]{2,}",
            r"os\.(?:environ|getenv)", r"env::var|\benv\s*=\s*\"|env!\(", r"os\.(?:Getenv|LookupEnv)", r"\bENV(?:\[|\.fetch)",
            r"^\s*[A-Z][A-Z0-9_]{2,}\??\s*:\s*[A-Za-z<>\[\]| ]+;", r"^(?:export\s+)?[A-Z][A-Z0-9_]*=",
            r"^\s*(?:pub(?:\([a-z]+\))?\s+)?(?:export\s+)?(?:const|static)\s+[A-Z][A-Z0-9_]{2,}\b", r"^[A-Z][A-Z0-9_]{2,}\s*(?::[^=]+)?=",
            r"\bport\s*[:=]|--port|\bPORT="]


def git(clone, *a): return subprocess.run(["git", "-C", clone, *a], capture_output=True, text=True).stdout


def tracked(clone, rel):
    return bool(git(clone, "ls-files", "--", rel).strip())


def scan(clone):
    """[(path, line, text)] of every line that may define or read a config key; .env* admitted only as templates."""
    cmd = ["rg", "-n", "--no-heading", "--no-messages", "--max-columns", str(SCAN_MAX_COLUMNS), "--hidden", "-g", "!.git", "-g", "!.pixel", "-g", "!.env*", "-g", "!*.env", "--max-filesize", str(SCAN_MAX_FILE_BYTES)]
    for g in RG_EXCL: cmd += ["-g", g]
    for p in PATTERNS: cmd += ["-e", p]
    try:
        out = subprocess.run(cmd + ["."], cwd=clone, capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return []   # no ripgrep, or too slow: no registry
    rows = []
    # Exclude all env files from rg before opening them; templates also require tracking.
    for rel in git(clone, "ls-files", "-z").split("\0"):
        base = os.path.basename(rel)
        if not (TEMPLATE_ENV.fullmatch(base) or re.fullmatch(r"\.env\.(development|production|local\.example)", base)):
            continue
        path = Path(clone) / rel
        if path.is_symlink() or not path.is_file() or path.stat().st_size > SCAN_MAX_FILE_BYTES:
            continue
        for n, text in enumerate(path.read_text(errors="replace").splitlines(), 1):
            if len(text.encode("utf-8")) <= SCAN_MAX_COLUMNS and ENV_LINE.match(text): rows.append((rel, n, text))
    for l in out.splitlines():
        m = re.match(r"\./(.+?):(\d+):(.*)$", l)
        if not m: continue
        path, n, text = m.group(1), int(m.group(2)), m.group(3)
        base = os.path.basename(path)
        if base.startswith(".env") or base.endswith(".env"):
            if not TEMPLATE_ENV.match(base) and not (TRACKED_ENV and re.match(r"\.env\.(development|production|local\.example)$", base) and tracked(clone, path)):
                continue
        elif not path.endswith(CODE_EXT + (".json", ".mts", ".yml", ".yaml", ".toml", ".mdx", ".md", ".d.ts")):
            continue
        if re.search(r"(^|/)(test|tests|__tests__|fixtures?|node_modules)/|\.(test|spec)\.", path): continue
        rows.append((path, n, text))
    # rg searches files in parallel: a stable order makes the registry (first reads, first declarations) deterministic.
    rows.sort(key=lambda row: (row[0], row[1]))
    return rows


def registry(clone):
    """{key: {kind, defs:[(path,line,text,default)], reads:[(path,line,text)]}}"""
    reg = {}
    def ent(k): return reg.setdefault(k, {"defs": [], "reads": []})
    for path, n, text in scan(clone):
        base = os.path.basename(path)
        code = path.endswith(CODE_EXT)
        if base.startswith(".env") or base.endswith(".env"):
            m = ENV_LINE.match(text)
            if m: ent(m.group(1))["defs"].append((path, n, text.strip(), m.group(2).strip().strip("'\"")))
            continue
        if code and re.search(r"(vite-env|env)\.d\.ts$", path):
            m = ENV_DECL.match(text)
            if m: ent(m.group(1))["defs"].append((path, n, text.strip(), ""))
            continue
        if code:
            keys = set(JS_READ.findall(text)) | set(PY_READ.findall(text)) | set(GO_READ.findall(text)) | set(RB_READ.findall(text)) | set(PREFIXED.findall(text))
            for g in RS_READ.findall(text): keys |= {x for x in g if x}
            d = DEFAULT_AFTER.search(text)
            for k in keys:
                ent(k)["reads"].append((path, n, text.strip(), (d.group(1) or d.group(2)).strip() if d else ""))
            m = CONST.match(text) or (PYCONST.match(text) if path.endswith(".py") else None)
            if m and not keys:
                val = m.group(2).strip() if m.lastindex and m.lastindex >= 2 else ""
                val = re.sub(r"\s*//.*$|\s*#.*$|;$", "", val).strip()
                if re.match(r"^[\"'\d\-\[]|^(true|false|Duration|Some|None)\b|^\d", val): ent(m.group(1))["defs"].append((path, n, text.strip(), val[:60]))
        if re.search(r"(\.config\.|package\.json|docker-compose|\.ya?ml$|\.toml$)", path):
            m = PORT_CFG.search(text)
            if m and re.search(r"\d", m.group(1)) and not PREFIXED.search(text) and not re.search(r"\"(build|preview|serve|test|docs?)[^\"]*\"\s*:", text) and not re.search(r"(^|/)(dev-docs|examples?|docs?|website|e2e|fixtures?)/", path):
                ent("dev-server port")["defs"].append((path, n, text.strip(), m.group(1).strip().strip('",')))
    return reg


IDS_WORDS = []

def stems(words):
    return {(w[:6] if len(w) >= 6 else w) for w in words}


def words_of(prompt):
    ws = [w for w in dict.fromkeys(re.findall(r"[a-z]{2,}", prompt.lower())) if w not in STOP and len(w) >= 3 or w == "ws"]
    return ws


WEAK = {"dev", "server", "app", "config", "setting", "file", "default", "value", "url", "locall", "local", "where"}
WEAK = WEAK | {w[:6] for w in WEAK}


def key_tokens(key):
    out = []
    for part in re.split(r"[_\-\s.]+", key):
        out += [part.lower()] if part.isupper() or part.islower() else [t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", part)]
    return [t for t in out if t]


def comment_above(clone, path, n, back=3):
    try: lines = (Path(clone) / path).read_text(errors="replace").splitlines()
    except OSError: return ""
    out = []
    for i in range(n - 2, max(-1, n - 2 - back), -1):
        if re.match(r"\s*(#|//|\*|/\*)", lines[i]): out.append(lines[i])
        else: break
    return " ".join(out)


def rank(clone, reg, prompt):
    ws = words_of(prompt); st = stems(ws)
    scored = []
    for k, e in reg.items():
        toks = key_tokens(k) if k != "dev-server port" else ["dev", "server", "port"]
        ktoks = stems(toks)
        strong = st - WEAK
        s = 3 * len(strong & ktoks) + len((st & ktoks) - strong)
        hay = ""
        for d in e["defs"][:2]: hay += " " + comment_above(clone, d[0], d[1]) + " " + d[2]
        hs = stems(re.findall(r"[a-z]{3,}", hay.lower()))
        s += 2 * len((strong & hs) - ktoks)
        if k == "dev-server port" and "port" in st: s += 3
        s += 2 if e["reads"] and any(not r[0].endswith(".rs") or "env" in r[2] for r in e["reads"]) else 0
        if (strong & ktoks) or (strong & hs): scored.append((s, len(e["defs"]) + len(e["reads"]), k))
    scored.sort(reverse=True)
    return [k for _, _, k in scored[:4]]


def block(clone, path, n, ctx_before=0, ctx_after=0):
    try: lines = (Path(clone) / path).read_text(errors="replace").splitlines()
    except OSError: return []
    lo, hi = max(1, n - ctx_before), min(len(lines), n + ctx_after)
    return [f"### {path}:{lo}-{hi}"] + [f"{i}| {lines[i - 1][:150]}" for i in range(lo, hi + 1)]


def evidence_block(clone, key, path, n, before=0, after=0):
    """Keep coordinates, but never copy a secret-bearing source line into the brief."""
    lines = block(clone, path, n, before, after)
    return [line if i == 0 or not (SECRETISH.search(key) or SECRETISH.search(line))
            else line.split("|", 1)[0] + "| <masked>" for i, line in enumerate(lines)]


def declaration_candidates(clone, key, defs):
    """A source coordinate identifies a declaration; a shared spelling proves no binding or precedence."""
    heads = [f"- {key} | {len(defs)} distinct declaration candidates; lexical binding and override precedence unknown"]
    blocks = []
    for path, n, _text, value in defs[:4]:
        heads.append(f"  - {key} @ {path}:{n} | candidate value {mask(key, value) or 'unknown'}")
        # Context preserves the surrounding scope as evidence, not a guessed resolution.
        blocks += evidence_block(clone, key, path, n, 2, 2)
    if len(defs) > 4:
        heads.append(f"  - {len(defs) - 4} additional candidates omitted; no unique default established")
    return heads, blocks


def mask(key, val):
    """A value of a key whose name looks like a secret is never printed, whatever its length."""
    return "<masked>" if val and SECRETISH.search(key) else val


INTENT = re.compile(r"\b(config\w*|settings?|env(ironment)?(\s+var\w*)?|variables?|flags?|options?|defaults?|ports?|overrid\w+|where do i set|set (that|this|it))\b", re.I)


def emit(clone, prompt, brief):
    if not Path(clone).exists() or not INTENT.search(prompt): return ""
    global IDS_WORDS
    IDS_WORDS = words_of(prompt)
    reg = registry(clone)
    keys = rank(clone, reg, prompt)
    if not keys: return ""
    envfiles = [f for f in git(clone, "ls-files", "--", ".env*", "*/.env*").split() if os.path.basename(f).startswith(".env")]
    head = [f"### config registry — keys matching {', '.join(IDS_WORDS[:6])} (key | value or fallback | declared | read at)"]
    blocks, seen = [], set()
    for k in keys:
        e = reg[k]
        defs = sorted(e["defs"], key=lambda d: (not os.path.basename(d[0]).startswith(".env"), d[0]))
        if len(defs) > 1:
            candidate_heads, candidate_blocks = declaration_candidates(clone, k, defs)
            head += candidate_heads
            blocks += candidate_blocks
            for r in e["reads"][:2]:
                blocks += evidence_block(clone, k, r[0], r[1], 1, 2)
            continue
        d0 = defs[0] if defs else None
        fileval = next(((d[0], d[1], mask(k, d[3])) for d in defs if os.path.basename(d[0]).startswith(".env") and d[3]), None)
        fallback = mask(k, next((r[3] for r in e["reads"] if r[3]), "") or next((d[3] for d in defs if d[3] and not os.path.basename(d[0]).startswith(".env")), ""))
        isenv = bool(e["reads"]) or any(d[0].endswith("env.d.ts") or os.path.basename(d[0]).startswith(".env") for d in defs)
        val = f"set in {fileval[0]}:{fileval[1]} = {fileval[2]}" + (f" (code fallback {fallback})" if fallback else "") if fileval else \
              ((f"code fallback {fallback}; an env file may override" if isenv else f"constant default {fallback}") if fallback else "no value in indexed files")
        reads = [f"{r[0]}:{r[1]}" for r in e["reads"][:3]]
        decl = [f"{d[0]}:{d[1]}" for d in defs[:1]]
        head.append(f"- {k} | {val} | {decl[0] if decl else 'not declared'} | read at {', '.join(reads) or 'no code read'}"
                    + (f" (+{len(e['reads']) - 3} more)" if len(e["reads"]) > 3 else "") + (f" (+{len(defs) - 1} more declarations)" if len(defs) > 1 else ""))
        shown = defs[:1] + ([fileval and next(d for d in defs if d[0] == fileval[0])] if fileval and defs[:1] and defs[0][0] != fileval[0] else [])
        for d in [x for x in shown if x]:
            span = comment_above(clone, d[0], d[1]).count("//") + comment_above(clone, d[0], d[1]).count("#")
            if (d[0], d[1]) not in seen:
                seen.add((d[0], d[1])); b = evidence_block(clone, k, d[0], d[1], min(span, 3), 0)
                if k == "dev-server port": b = evidence_block(clone, k, d[0], d[1], 1, 1)
                if os.path.basename(d[0]).startswith(".env"): b = [re.sub(r"=(.*)$", lambda m: "=<masked>" if SECRETISH.search(x.split("=")[0].split("|")[-1]) or SECRETISH.search(k) else m.group(0), x) for x in b]
                blocks += b
        for r in e["reads"][:2]:
            if (r[0], r[1]) not in seen:
                seen.add((r[0], r[1])); blocks += evidence_block(clone, k, r[0], r[1], 1, 2)
    if envfiles: head.append("env files in the repo (names only; local .env* are never indexed): " + ", ".join(sorted(envfiles)[:6]))
    return "\n".join(head + blocks)[:9000] + "\n"


def main():
    req = json.load(sys.stdin)
    text = emit(req["repo_root"], req["prompt"], req.get("brief", ""))
    if text.strip():
        sys.stdout.write(text)


main()
