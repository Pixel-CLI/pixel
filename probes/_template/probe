"""template: reads {prompt, repo_root, brief, kind, session_files} as JSON on stdin and prints brief blocks.

    ### path:lo-hi — label          a block: this header, then numbered lines `N| text`
    drop: <regex>                   remove the brief's blocks whose header matches
    first: <regex>                  move the brief's blocks whose header matches to the front

Rules: read-only, no network, deterministic (sort what you list), generic (derive every word, path and symbol
from the prompt and the repository when you run; never write them into this file), and print nothing when you have
nothing to add. `.env*` only when git tracks it, with secret-looking values masked. Run it by hand with
`python3 -I scripts/probe-test.py <name>`."""
import json
import re
import subprocess
import sys
from pathlib import Path

STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "how", "the", "and"}


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    words = [w for w in dict.fromkeys(re.findall(r"[a-z]{4,}", prompt.lower())) if w not in STOP]
    if not words:
        return
    hits = subprocess.run(["rg", "-n", "--sort", "path", "-j", "1", "-m", "1", "-w", words[0], "."], cwd=root,
                          capture_output=True, text=True, timeout=5).stdout.splitlines()
    for hit in hits[:3]:
        path, line, _ = hit.split(":", 2)
        lines = (Path(root) / path).read_text(errors="replace").splitlines()
        first, last = max(1, int(line) - 2), min(len(lines), int(line) + 6)
        print(f"### {path.lstrip('./')}:{first}-{last} — a line naming '{words[0]}'")
        print("\n".join(f"{n}| {lines[n - 1][:160]}" for n in range(first, last + 1)))


main()
