"""history-fallback: a history question whose brief has no history block (no history index, a lookup that missed
the window) is answered from git itself: the commits naming a version the prompt quotes, else `log --grep` on the
prompt's rarest words, a `-S` pickaxe on the rarest, then the top commit's message, stat, patch (a merge against its
first parent) and first tag. Read-only git, deterministic."""
import collections
import json
import math
import tempfile
import re
import subprocess
import sys

PATCH_LINES = 90
MESSAGE_LINES = 10


def git(root, *args):
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=20).stdout


# A version the prompt quotes ("3.10", "v5.3.0"): the most specific token a history question carries, and
# one the letter-only word lists below never see.
VERSION = re.compile(r"(?<![\w.])v?(\d+\.\d+(?:\.\d+)*)(?!\w|\.\d)")
# Words any history question uses: they name no commit of their own.
ASKING = {"which", "what", "when", "where", "commit", "commits", "change", "changed", "changes", "release",
          "released", "made", "make", "does", "version", "versions"}


# Kept identical in both standalone history probes: bundles install each script alone.
SUBJECT_LIMIT = 20_000
SUBJECT_BYTES = 4 * 1024 * 1024
SUBJECT_STOP = ASKING | set("was were is are the to of a an and or it did that this how from with for in added add introduced introduce happen happens first".split())


def subject_words(text):
    return [w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in SUBJECT_STOP and len(w) >= 2]


def by_subject(root, prompt):
    """Prefer multi-term subject evidence to incidental mentions in long message bodies.

    This ranks candidate commits, not proof of first introduction. Exact versions and
    quoted titles retain precedence. A lone shared word never admits a candidate.
    """
    try:
        with tempfile.TemporaryFile() as output:
            result = subprocess.run(["git", "-C", root, "log", "-n", str(SUBJECT_LIMIT),
                                     "--format=%H\t%h %as %s"], stdout=output,
                                    stderr=subprocess.DEVNULL, timeout=0.8)
            if result.returncode or output.tell() > SUBJECT_BYTES:
                return []
            output.seek(0)
            rows = output.read(SUBJECT_BYTES).decode("utf-8", errors="replace").splitlines()
    except (OSError, subprocess.SubprocessError):
        return []
    records = [r.split("\t", 1) for r in rows if "\t" in r]
    corpus = [set(subject_words(r[1].split(" ", 2)[-1])) for r in records]
    counts = collections.Counter(w for row in corpus for w in row)
    asked = set(subject_words(prompt))
    raw = re.findall(r"[a-z0-9]+", prompt.lower())
    pairs = {(a, b) for a, b in zip(raw, raw[1:]) if a in asked and b in asked}
    ranked = []
    for index, (record, tokens) in enumerate(zip(records, corpus)):
        shared = asked & tokens
        if len(shared) < 2:
            continue
        seq = re.findall(r"[a-z0-9]+", record[1].split(" ", 2)[-1].lower())
        adjacent = set(zip(seq, seq[1:])) & pairs
        if len(shared) < 3 and not adjacent:
            continue
        score = sum(math.log1p(len(records) / (1 + counts[w])) for w in sorted(shared)) + 4 * len(adjacent)
        ranked.append((score, len(shared), -index, record))
    return [record for _, _, _, record in sorted(ranked, reverse=True)[:6]]



def stems(text):
    return {w[:4] for w in re.findall(r"[a-z]{4,}", text.lower()) if w not in ASKING}


def by_version(root, prompt):
    """``[(sha, "%h %as %s")]`` of the commits naming a version the prompt quotes, best first: the commit its
    exact release tag points at, then the subjects sharing most of the prompt's other word stems, then the
    newest. Only the tagged commit and subjects sharing a stem are kept: a bare number names no commit."""
    asked = stems(VERSION.sub(" ", prompt))
    for version in dict.fromkeys(VERSION.findall(prompt)):
        pattern = "(^|[^0-9.])" + re.escape(version) + "([^0-9.]|\\.([^0-9]|$)|$)"
        log = git(root, "log", "-i", "-E", "-n", "20", "--format=%H\t%h %as %s", f"--grep={pattern}")
        found = [line.split("\t", 1) for line in log.splitlines()]
        tagged = next((sha for sha in (git(root, "rev-list", "-n", "1", f"refs/tags/{tag}", "--").strip()
                                       for tag in (f"v{version}", version)) if sha), "")
        if tagged and tagged not in (sha for sha, _ in found):
            found.insert(0, [tagged, git(root, "show", "-s", "--format=%h %as %s", tagged).strip()])
        shared = lambda line: len(asked & stems(line.split(" ", 2)[-1]))
        ranked = sorted(enumerate(found), key=lambda c: (c[1][0] != tagged, -shared(c[1][1]), c[0]))
        kept = [(sha, line) for _, (sha, line) in ranked if sha == tagged or shared(line)]
        if kept:
            return kept
    return []


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    if re.search(r"^### history", brief, re.M):
        return
    named = by_version(root, prompt)
    if named:
        versions = list(dict.fromkeys(VERSION.findall(prompt)))
        show(root, versions, [line for _, line in named], named[0][1].split()[0])
        return
    quoted = [q.strip() for q in re.findall(r"[\"'`]([^\"'`]{8,120})[\"'`]", prompt)]
    for phrase in quoted:
        out = git(root, "log", "-i", "--fixed-strings", "-n", "6", "--format=%h %as %s", f"--grep={phrase}").strip()
        if out:
            shown = out.splitlines()
            show(root, subject_words(phrase), shown, shown[0].split()[0])
            return
    named = by_subject(root, prompt)
    if named:
        show(root, subject_words(prompt), [line for _, line in named], named[0][0])
        return
    words = [w for w in dict.fromkeys(re.findall(r"[a-z]{5,}", prompt.lower()))]
    messages = git(root, "log", "-i", "-n", "20000", "--format=%B%x00").lower().split("\0")
    counts = {w: sum(w in m for m in messages) for w in words[:24]}
    words = sorted((w for w in words if counts.get(w)), key=lambda w: (counts[w], w))
    shown = []
    if not words and not shown:
        return
    for k in () if shown else (3, 2, 1):
        args = ["log", "-i", "--all-match", "-n", "6", "--format=%h %as %s"] + [f"--grep={w}" for w in words[:k]]
        out = git(root, *args).strip()
        if out:
            shown = out.splitlines()
            break
    pick = []
    if words and not shown:
        pick = git(root, "log", "-S" + words[0], "-n", "5", "--format=%h %as %s", "--", "*.rs", "*.py", "*.ts",
                   "*.js", "*.go").strip().splitlines()
    shas = [line.split()[0] for line in shown] or [line.split()[0] for line in pick]
    if not shas:
        return
    show(root, words, shown or pick, shas[0])


def show(root, words, shown, sha):
    message = git(root, "show", "-s", "--format=%h %ad %an%n%B", "--date=short", sha).strip().splitlines()
    body = message[:MESSAGE_LINES] + git(root, "show", "--format=", "--stat=100", "--patch", "-U2",
                                         "--diff-merges=first-parent", "--no-ext-diff", sha).splitlines()
    tags = git(root, "tag", "--contains", sha, "--sort=creatordate").split("\n")
    print(f"### history — commits matching {', '.join(words[:3])}")
    print("\n".join(shown))
    print(f"### commit {sha} — message, files and patch")
    print("\n".join(line[:160] for line in body[:PATCH_LINES]))
    if tags and tags[0]:
        print(f"first tag containing it: {tags[0]}")


main()
