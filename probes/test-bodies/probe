"""test-bodies: for a question about tests, quote the test cases whose name or body carries the prompt's subject.

Candidates are the test files the brief names, then those whose path names the subject, then those whose text carries
the subject words; Rust keeps its tests inline, so a named or subject-named source holding a `#[test]` counts too. A
case is a Python `def test_*`, a JS `it(...)`/`test(...)`, or a Rust `fn` under `#[test]`, cut at its closing line
and at 40 lines. A case scores by the subject words its name (3x) and body carry (a token starting with the word),
each weighted by how few cases carry it; cases under half the best score, and ranges the brief already quotes, are
left out. Read-only, deterministic, at most 9 000 bytes. Issue #1196.

The brief runs the Rust step of the same name (crates/pixel/src/execution_brief/steps/test_bodies.rs) and does not start
this script; it stays as the oracle that scripts/bench/step-parity.py compares the step with."""
import json
import math
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

# Function words only: how much a content word says is measured on the repository (see `main`), never listed here.
STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "how", "the", "and", "are", "they", "them",
        "for", "into", "about", "when", "should", "their", "there", "these", "those", "have", "your", "can", "could",
        "would", "will", "may", "might", "must", "whether", "test", "tests", "testing", "check", "checks", "please",
        "need", "want", "you", "your", "our", "its", "does", "did", "do", "was", "were", "be", "been", "being",
        "cover", "covers", "exercise", "include", "spec", "specs"}
TEST_PATH = re.compile(r"(^|/)(tests?|__tests__|spec|testdata)/|(^|/)test_[^/]*$|_tests?\.[a-z]+$|\.(test|spec)\.[a-z]+$|(^|/)tests?\.rs$", re.I)
CODE = (".py", ".rs", ".js", ".ts", ".tsx", ".jsx", ".mjs", ".go", ".rb")
UNIT = [
    re.compile(r"^\s*(?:async\s+)?def\s+(test\w*)\s*\("),                                   # python
    re.compile(r"^\s*(?:it|test|specify)(?:\.\w+)?\s*\(\s*(['\"`])(.+?)\1"),                 # js it('...')
    re.compile(r"^\s*(?:pub\s+)?(?:async\s+)?fn\s+(\w+)\s*\("),                              # rust (after #[test])
]
OUT_CAP = 9_000
UNIT_CAP = 40


def stem(w):
    w = w.lower()
    for suf in ("ations", "ation", "ings", "ing", "ers", "ies", "es", "s", "ed"):
        if len(w) - len(suf) >= 4 and w.endswith(suf):
            return w[: -len(suf)]
    return w


def terms(prompt):
    out = []
    for raw in re.findall(r"[A-Za-z][A-Za-z0-9_.]*", prompt):
        for part in re.split(r"[._]|(?<=[a-z])(?=[A-Z])", raw):
            if len(part) >= 3 and part.lower() not in STOP:
                out.append(stem(part))
        joined = re.sub(r"[._]", "", raw)
        if joined != raw and len(joined) >= 5:
            out.append(stem(joined))
    return list(dict.fromkeys(out))


def requested_option(prompt):
    """Return an explicitly named option, including its exact hyphenated spelling."""
    match = re.search(r"--([a-z][a-z0-9]*(?:-[a-z0-9]+)*)", prompt, re.I)
    if not match:
        match = re.search(r"\b([a-z][a-z0-9]*(?:-[a-z0-9]+)*)\s+option\b", prompt, re.I)
    return match.group(1).lower().replace("-", "_") if match else None


def exact_option_case(name, option, body=""):
    """Prove the exact option from a case title or its exact option flag literal."""
    if not option:
        return False
    normalized = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
    normalized = re.sub(r"^(?:test|spec)_", "", normalized)
    if normalized == option:
        return True
    flag = "--" + option.replace("_", "-")
    return bool(re.search(r"(?<![A-Za-z0-9_-])" + re.escape(flag) + r"(?![A-Za-z0-9_-])", body))


def tokens(text):
    """The words of code or prose, split at case changes, underscores and punctuation, lowercased."""
    return {t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", text)}


def carries(toks, word):
    """Match a word or a simple inflection, not any longer token that shares its prefix."""
    variants = {word, f"{word}s", f"{word}es", f"{word}ed", f"{word}d", f"{word}ing", f"{word}e"}
    if word.endswith("e"):
        variants.update((f"{word[:-1]}ed", f"{word[:-1]}ing"))
    return bool(toks & variants)


def units(lines, rel):
    """(name, start, end) of each test case: Python def test_*, JS it/test(...), Rust fn under #[test]."""
    starts = []
    for i, line in enumerate(lines):
        if rel.endswith(".py"):
            m = UNIT[0].match(line)
            if m:
                starts.append((m.group(1), i))
        elif rel.endswith(".rs"):
            if re.match(r"^\s*#\[(?:\w+::)?test\b", line):
                for j in range(i + 1, min(i + 4, len(lines))):
                    m = UNIT[2].match(lines[j])
                    if m:
                        starts.append((m.group(1), i))
                        break
        else:
            m = UNIT[1].match(line)
            if m:
                starts.append((m.group(2), i))
    out = []
    py = rel.endswith(".py")
    for k, (name, i) in enumerate(starts):
        indent = len(lines[i]) - len(lines[i].lstrip())
        end = starts[k + 1][1] - 1 if k + 1 < len(starts) else len(lines) - 1
        for j in range(i + 1, end + 1):
            s = lines[j]
            if not s.strip():
                continue
            ind = len(s) - len(s.lstrip())
            if ind < indent or (py and ind == indent):
                end = j - 1
                break
            if ind == indent and s.lstrip().startswith(("}", ")")):
                end = j
                break
        while end > i and not lines[end].strip():
            end -= 1
        out.append((name, i + 1, min(end + 1, i + UNIT_CAP)))
    return out


def carrying(root, paths, words):
    """Test files whose text carries the most subject words, most first (ripgrep; none without it)."""
    if not paths or not words:
        return []
    args = ["rg", "-c", "-H", "-i", "-F", "--sort", "path", "-j", "1"] + [x for w in words for x in ("-e", w)] + ["--"]
    try:
        out = subprocess.run(args + paths, cwd=root, capture_output=True, text=True, timeout=5).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []
    counts = [(int(n), p) for p, _, n in (line.rpartition(":") for line in out) if n.isdigit()]
    return [p for _n, p in sorted(counts, key=lambda c: (-c[0], c[1]))]


def quoted_ranges(brief):
    got = {}
    for p, a, b in re.findall(r"^### (\S+?):(\d+)-(\d+)", brief, re.M):
        got.setdefault(p, []).append((int(a), int(b)))
    return got


MAX_BYTES = 2_000_000


def regular_lines(path, limit):
    """Lines of a regular file read without following a symlink; None for anything else or past `limit` bytes."""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return None
    with os.fdopen(fd, "rb") as source:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        raw = source.read(limit + 1)
    return None if len(raw) > limit else raw.decode("utf-8", errors="replace").splitlines()


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = Path(req["repo_root"]), req["prompt"], req.get("brief", "")
    words = terms(prompt)
    if not words:
        return
    try:
        tracked = subprocess.run(["git", "ls-files"], cwd=root, capture_output=True, text=True, timeout=5).stdout.split("\n")
    except (OSError, subprocess.SubprocessError):
        return
    tests = {p for p in tracked if p.endswith(CODE) and TEST_PATH.search(p)}
    rust = {p for p in tracked if p.endswith(".rs")}
    mentioned = list(dict.fromkeys(re.findall(r"([\w./-]+\.\w+)", brief)))

    flat = {p: re.sub(r"[^a-z0-9]", "", p.lower()) for p in tests | rust}
    # A word that names more than a quarter of the test files (the word for "test" itself) names no subject.
    pathy = [w for w in words if sum(w in flat[p] for p in tests) * 4 <= max(len(tests), 1)]

    def names_subject(p):
        return any(w in flat[p] for w in pathy)

    # Test files the brief names, then test files whose path names the subject; Rust keeps its tests inline
    # (#[cfg(test)]), so its named or subject-named sources count when they hold a #[test].
    pool = [p for p in mentioned if p in tests or p in rust] + sorted(p for p in tests | rust if names_subject(p))
    pool += carrying(root, sorted(tests), pathy)
    files = []
    for p in dict.fromkeys(pool):
        body = regular_lines(root / p, MAX_BYTES)
        if body is not None and (p in tests or any("#[test]" in line for line in body)):
            files.append(p)
        if len(files) == 16:
            break
    have = quoted_ranges(brief)
    exact_option = requested_option(prompt)
    cands = []
    df = {w: 0 for w in words}
    parsed = {}
    for rel in files:
        lines = regular_lines(root / rel, MAX_BYTES)
        if lines is None:
            continue
        us = units(lines, rel)
        parsed[rel] = (lines, us)
        for _name, a, b in us:
            toks = tokens(" ".join(lines[a - 1:b]))
            for w in words:
                df[w] += carries(toks, w)
    n = sum(len(us) for _l, us in parsed.values()) or 1
    # Weight by rarity among the cases: a word every case carries weighs almost nothing, one no case carries nothing.
    idf = {w: math.log((n + 1) / df[w]) if df[w] else 0.0 for w in words}
    for rank, rel in enumerate(files):
        lines, us = parsed.get(rel, ([], []))
        for name, a, b in us:
            if any(x <= a and b <= y for x, y in have.get(rel, [])):
                continue
            case_text = " ".join(lines[a - 1:b])
            exact_option_match = exact_option_case(name, exact_option, case_text)
            body, title = tokens(case_text), tokens(name)
            support = [w for w in words if carries(title, w) or carries(body, w)]
            if len(support) < min(2, len(words)) and not exact_option_match:
                continue
            score = sum(idf[w] * (3 * carries(title, w) + carries(body, w)) for w in words)
            if exact_option_match:
                score = max(score, 1.0)
            if score <= 0:
                continue
            cands.append((-score, rank, rel, a, b, name))
    cands.sort()
    if exact_option is not None:
        titled = [candidate for candidate in cands if exact_option_case(candidate[5], exact_option)]
        if titled:
            cands = titled
        else:
            cands = [candidate for candidate in cands if exact_option_case(
                candidate[5], exact_option, " ".join(parsed[candidate[2]][0][candidate[3]-1:candidate[4]]))]
    if cands:
        best = -cands[0][0]
        cands = [c for c in cands if -c[0] >= 0.5 * best]   # the subject's tests, not every test that says "prompt"
    out, size = [], 0
    for _s, _r, rel, a, b, name in cands:
        block = [f"### {rel}:{a}-{b} — test {name[:80]}"] + [f"{k}| {lines_k[:160]}" for k, lines_k in
                                                            ((k, parsed[rel][0][k - 1]) for k in range(a, b + 1))]
        text = "\n".join(block)
        if size + len(text) + 1 > OUT_CAP:
            continue
        out.append(text)
        size += len(text) + 1
    if out:
        print("\n".join(out))


if __name__ == "__main__":
    main()
