"""Quote error evidence without promoting lexical occurrences to runtime causes.
Literal/described matches remain candidates; Python syntax distinguishes message
assignments, documentation and local raises. Matching caught types add a handler
with its conversion/rethrow branches and import boundary. Name-only callers and
test links remain unresolved candidates, never a causal chain. Read-only and
deterministic; a missing parser result cannot prove an emission. Issues #906, #1231."""
import ast
import json
import math
import re
import subprocess
import sys
from pathlib import Path

SRC_GLOBS = ["-g", "*.rs", "-g", "*.py", "-g", "*.ts", "-g", "*.tsx", "-g", "*.js", "-g", "*.go"]
RG = ["rg", "--sort", "path", "-j", "1", "-g", "!.pixel"]
FN = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:fn|def|function)\s+([A-Za-z_]\w*)"
                r"|^\s*(?:export\s+)?(?:const|let)\s+([A-Za-z_]\w*)\s*=\s*(?:async\s*)?\(")
JS_EXT = (".js", ".ts", ".tsx", ".jsx")
MIN_QUOTE, MIN_WORDS, CALLER_LINES, LEVELS, MAX_LINES, MAX_BYTES = 12, 3, 14, 2, 220, 9000


def rg(root, *args):
    """Lines of `rg`; without ripgrep (or past its time) the probe has nothing to say."""
    try:
        return subprocess.run([*RG, *args], cwd=root, capture_output=True, text=True, timeout=10).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []


def quoted(prompt):
    return re.findall(r"""['"`‘“]([^'"`’”]{%d,})['"`’”]""" % MIN_QUOTE, prompt)


# Function words; how much a content word says is measured on the repository (`described`), never listed here.
STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "how", "the", "and", "are", "they", "them",
        "for", "into", "about", "when", "should", "their", "there", "these", "those", "have", "your", "one", "than",
        "its", "was", "has", "can", "not", "but", "all", "any", "you", "of", "to", "in", "is", "it", "on", "at", "by",
        "an", "or", "as", "be", "do", "if", "so", "up", "me", "my", "we", "us", "am"}
LITERAL_EXT = (".json",)          # message catalogues: the text lives here and the code names its key
MIN_SHARED, SEED_WORDS, SEED_HITS = 2, 4, 300
TRIPLE = re.compile(r'"""|\'\'\'')


def tokens(text):
    """The words of code or prose, split at case changes, underscores and punctuation, lowercased."""
    return [t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", text)]


def stem(word):
    if len(word) > 4 and word.endswith("ies"):
        return word[:-3] + "y"
    for suffix in ("ing", "ed", "s"):
        if len(word) - len(suffix) >= 3 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def string_part(text):
    """The text inside the string literals of a code line ('', \"\" or ``), joined."""
    # An escape and a plain character never match the same text (a plain one is no backslash): no backtracking blowup.
    return " ".join(m.group(2) for m in re.finditer(r"""(["'`])((?:\\.|(?!\1)[^\\])*)\1""", text))


def prompt_words(prompt):
    return [w for w in dict.fromkeys(stem(t) for t in tokens(prompt) if len(t) >= 2 and t not in STOP)]


def open_quotes(text, rel):
    """How many string delimiters a stretch of code holds: triple quotes in Python, backticks in JS, unescaped double
    quotes (outside char literals) in Rust and the rest; an odd count leaves a string open."""
    if rel.endswith(".py"):
        return len(TRIPLE.findall(text))
    if rel.endswith(JS_EXT):
        return text.count("`")
    return len(re.findall(r'(?<![\\\'])"', text))


def in_multiline_string(lines, index, rel):
    """The line sits inside a string that spans lines: Python triple quotes or a JS template literal opened above."""
    start = max(0, index - 60)   # a message spans a few lines; parity over a bounded window keeps it cheap
    return open_quotes("\n".join(lines[start:index]), rel) % 2 == 1


def carried(word, toks):
    """A token starting with the word carries it; a word of three letters or fewer must be the token (`no` is not
    in `not`)."""
    return word in toks if len(word) <= 3 else any(t.startswith(word) for t in toks)


def emitter(lines, first, rel):
    """The words of what emits a string that starts on line `first`: the call opening on that line or the one above,
    and the name of the enclosing function (`eprint_nothing_searched`, `err_message!`)."""
    name, _start = enclosing(lines, first, rel.endswith(JS_EXT))
    above = lines[first - 1] if first > 0 else ""
    return set(tokens(" ".join([name or "", above, lines[first].split('"')[0].split("'")[0]])))


def string_span(lines, index, rel, reach=8):
    """`(first, last)` line index of the multi-line string that holds line `index` (itself when it holds none), or
    `None` when the string runs past `reach` lines on either side: a manual page or a doc block, not a message."""
    lo = index
    while in_multiline_string(lines, lo, rel):
        if lo <= max(0, index - reach):
            return None
        lo -= 1
    hi = index
    while hi + 1 < len(lines) and in_multiline_string(lines, hi + 1, rel):
        if hi >= index + reach:
            return None
        hi += 1
    return lo, hi


def described(root, prompt):
    """A message the prompt describes without quoting it: the string literal that carries most of the prompt's words
    (two at least), each weighed by how few source lines carry it, as `(path, line, catalogue)`. Candidate lines come
    from the rarest words; a literal in a message catalogue (JSON) is followed to the code that names its key."""
    words = prompt_words(prompt)
    globs = SRC_GLOBS + ["-g", "*.json"]
    df = {}
    for w in words:
        counts = rg(root, "-c", "-i", "-F", *globs, w, ".")
        df[w] = sum(int(c.rpartition(":")[2]) for c in counts if c.rpartition(":")[2].isdigit())
    present = sorted((w for w in words if df[w]), key=lambda w: (df[w], w))
    if len(present) < MIN_SHARED:
        return None
    total = sum(df.values()) + 1
    idf = {w: math.log(total / df[w]) for w in present}
    best, seen, cache = None, set(), {}
    for w in present[:SEED_WORDS]:
        for hit in rg(root, "-n", "--no-heading", "-i", "-F", *globs, w, ".")[:SEED_HITS]:
            if hit.count(":") < 2:
                continue
            path, line, text = hit.split(":", 2)
            rel = path.lstrip("./")
            if (rel, line) in seen or is_test_path(rel) or re.match(r"\s*(//|#|\*|/\*)", text):
                continue
            seen.add((rel, line))
            message, context = string_part(text), set()
            if not rel.endswith(LITERAL_EXT):
                lines = read(root, rel, cache)
                index = int(line) - 1
                if index >= len(lines) or in_test(rel, lines, index):
                    continue
                span = string_span(lines, index, rel)
                if span and span[0] == span[1] and open_quotes(text, rel) % 2 == 1:   # it opens here
                    span = string_span(lines, index + 1, rel) if index + 1 < len(lines) else None
                    span = span and (index, span[1])
                if span is None:
                    continue
                if span[1] > span[0]:   # the whole string, wherever the word fell in it
                    message = " ".join(lines[span[0]:span[1] + 1])
                context = emitter(lines, span[0], rel)
            words_in = tokens(message)
            if not any(carried(r, set(words_in)) for r in present):
                continue   # the emitter's words only count beside a string that carries the question's own
            inside = set(words_in) | context
            shared = [r for r in present if carried(r, inside)]
            if len(shared) < MIN_SHARED:
                continue
            # More of the question's words first; then rarer words packed in a shorter text (a message, not a manual).
            key = (-len(shared), -sum(idf[r] for r in shared) / math.log2(4 + len(words_in)), rel, int(line))
            if best is None or key < best[0]:
                best = (key, rel, int(line), text)
    if best is None:
        return None
    _key, rel, line, text = best
    if rel.endswith(LITERAL_EXT):
        name = re.match(r'\s*"([A-Za-z_][\w.-]*)"\s*:', text)
        if not name:
            return None
        for hit in rg(root, "-n", "--no-heading", "-w", "-F", *SRC_GLOBS, name.group(1), "."):
            path, at, _ = hit.split(":", 2)
            if not is_test_path(path.lstrip("./")):
                return path.lstrip("./"), int(at), (rel, line)
        return None
    return rel, line, None


def is_test_path(rel):
    return bool(re.search(r"(^|/)tests?/|_test\.|test_", rel))


def locate(root, message):
    """Hits of the longest leading run of `message` (at least MIN_WORDS words) found literally in non-test source."""
    words = re.split(r"(\s+)", message.strip())
    for n in range(len(words), MIN_WORDS + 1, -2):
        fragment = "".join(words[:n]).split("(")[0].split("{")[0].strip(" :")
        if len(fragment.split()) < MIN_WORDS:
            break
        hits = [h for h in rg(root, "-n", "--no-heading", "-F", *SRC_GLOBS, fragment, ".")
                if not is_test_path(h.split(":")[0]) and in_string(h, fragment)]
        if hits:
            return hits
    return []


def in_string(hit, fragment):
    """The fragment sits inside a string literal of a code line: a quote before it, and the line is not a comment."""
    text = hit.split(":", 2)[2] if hit.count(":") >= 2 else ""
    at = text.find(fragment)
    return at > 0 and any(q in text[:at] for q in "\"'`") and not re.match(r"\s*(//|#|\*|/\*)", text)


def definitions(root, name):
    """Files that define a function called `name`."""
    pattern = rf"\b(fn|def|function)\s+{re.escape(name)}\b"
    return sorted({h.split(":")[0].lstrip("./") for h in rg(root, "-n", "--no-heading", *SRC_GLOBS, pattern, ".")})


def enclosing(lines, index, js=False):
    """`(name, line index)` of the function a line is in; the `const x = (` form only counts in JS and TS."""
    for j in range(min(index, len(lines) - 1), -1, -1):
        match = FN.match(lines[j])
        if match and (match.group(1) or js):
            return (match.group(1) or match.group(2)), j
    return None, 0


def show(rel, lines, lo, hi, label):
    lo, hi = max(1, lo), min(len(lines), hi)
    return [f"### {rel}:{lo}-{hi} — {label}"] + [f"{k}| {lines[k - 1][:160]}" for k in range(lo, hi + 1)]


def in_test(rel, lines, index):
    """Test code: a tests path, or after a `mod tests`; an attribute alone marks nothing."""
    return is_test_path(rel) or any(re.match(r"\s*(pub\s+)?mod tests\b", l) for l in lines[:index])


def read(root, rel, cache):
    if rel not in cache:
        try:
            cache[rel] = (Path(root) / rel).read_text(errors="replace").splitlines()
        except OSError:   # a directory, a dangling link: nothing to quote
            cache[rel] = []
    return cache[rel]


def callers(root, name, cache, seen, depth, out, home, defined_in):
    """Bounded lexical call candidates; directory proximity does not resolve receiver or binding identity."""
    if depth == 0 or len(out) > MAX_LINES:
        return
    near = None
    if len(definitions(root, name)) > 1:
        near = defined_in.rsplit("/", 1)[0] + "/" if "/" in defined_in else ""
    frontier = []
    for hit in rg(root, "-n", "--no-heading", *SRC_GLOBS, rf"\b{re.escape(name)}\s*\(", ".")[:40]:
        path, line, text = hit.split(":", 2)
        rel = path.lstrip("./")
        if re.search(rf"\b(fn|def|function)\s+{re.escape(name)}\b", text):
            continue
        lines = read(root, rel, cache)
        index = int(line) - 1
        if in_test(rel, lines, index):
            continue
        if near is not None and not rel.startswith(near):
            continue
        if home and depth < LEVELS and not rel.startswith(home + "/"):
            continue  # deeper levels stay in the origin's directory; `crates/pixel/` is not `crates/pixel-x/`
        caller, start = enclosing(lines, index, rel.endswith(JS_EXT))
        if not caller or (rel, caller, name) in seen:
            continue
        seen.add((rel, caller, name))
        lo = max(start + 1, index + 1 - CALLER_LINES)
        if lo > start + 4:
            out += show(rel, lines, start + 1, start + 3, f"{caller}: lexical caller candidate (scope/binding unresolved)")
        out += show(rel, lines, lo, index + 4, f"{caller} → {name}: lexical call candidate; receiver/binding unresolved; scope unverified" +
                    ("; independent context, no composed path" if depth < LEVELS else ""))
        if depth > 1 and near is None:
            frontier.append((caller, rel))
    # Visit every direct match before indirect context can claim the shared seen slot.
    for caller, rel in frontier:
        callers(root, caller, cache, seen, depth - 1, out, home, rel)


def origins(root, prompt):
    """`(path, line, how, catalogue)` of the message the prompt asks about: a quoted one found literally first, else
    the literal the prompt describes."""
    for message in quoted(prompt)[:3]:
        hits = locate(root, message)
        if hits:
            path, line, _ = hits[0].split(":", 2)
            return path.lstrip("./"), int(line), "quoted occurrence candidate; emission unverified", None
    found = described(root, prompt)
    if found:
        rel, line, catalogue = found
        return rel, line, "described occurrence candidate; emission unverified", catalogue
    return None


def python_role(lines, line):
    """Classify syntax and its actual Python function span, never a nearby definition."""
    role = 'occurrence candidate; emission unverified'
    try:
        tree = ast.parse('\n'.join(lines))
    except (SyntaxError, ValueError, RecursionError):
        return role, None, 0
    functions = [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
                 and n.lineno <= line <= n.end_lineno]
    scope = max(functions, key=lambda n: n.lineno) if functions else None
    for node in ast.walk(tree):
        if not (getattr(node, 'lineno', 0) <= line <= getattr(node, 'end_lineno', 0)):
            continue
        if isinstance(node, ast.Raise):
            role = 'local raise syntax; message origin candidate'
            break
        if isinstance(node, (ast.Assign, ast.AnnAssign)) and isinstance(node.value, ast.Constant):
            role = 'message definition; emission unverified'
            break
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            role = 'documentation occurrence; no emission proved'
            break
    return role, scope.name if scope else None, scope.lineno - 1 if scope else 0


def handler_nodes(node):
    """Only this handler's lexical scope; nested functions/classes own their raises."""
    yield node
    for child in ast.iter_child_nodes(node):
        if not isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
            yield from handler_nodes(child)


def python_handlers(root, prompt, cache):
    """Quote matching typed handlers, not name-only callers. Imports mark a boundary, not an external raise."""
    meaningful = set(prompt_words(prompt)) - {'error', 'exception', 'message', 'text', 'type', 'warning'}
    candidates = []
    for path in rg(root, '-l', '-g', '*.py', r'^\s*(except|raise)\b', '.')[:80]:
        rel = path.removeprefix('./')
        if is_test_path(rel):
            continue
        lines = read(root, rel, cache)
        try:
            tree = ast.parse('\n'.join(lines))
        except (SyntaxError, ValueError, RecursionError):
            continue
        parents = {c: n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
        for handler in ast.walk(tree):
            if not isinstance(handler, ast.ExceptHandler) or handler.type is None:
                continue
            shared = meaningful & {stem(t) for t in tokens(ast.unparse(handler.type))}
            if len(shared) < MIN_SHARED:
                continue
            raises = [n for n in handler_nodes(handler) if isinstance(n, ast.Raise)]
            if not raises:
                continue
            candidates.append((-len(shared), rel, handler.lineno, handler, raises, parents, tree))
    if not candidates:
        return []
    _, rel, _, handler, raises, parents, tree = min(candidates, key=lambda x: x[:3])
    lines = cache[rel]
    owner = parents.get(handler)
    lo = max(handler.lineno - 20, getattr(owner, 'lineno', handler.lineno))
    out = show(rel, lines, lo, min(handler.end_lineno, handler.lineno + 55),
               'conversion/rethrow candidate: matching caught type; runtime message origin unresolved')
    types = {n.id for n in ast.walk(handler.type) if isinstance(n, ast.Name)}
    for node in tree.body:
        if isinstance(node, ast.ImportFrom) and any((a.asname or a.name) in types for a in node.names):
            out += show(rel, lines, node.lineno, node.end_lineno,
                        'dependency boundary candidate: matching import name; binding unresolved; external emission not inspected')
    # The syntax is direct evidence of raising here; matching the question's message remains a hypothesis.
    for raised in raises[:6]:
        out += show(rel, lines, raised.lineno, raised.end_lineno,
                    'local raise/rethrow syntax in this handler; message identity unverified')
    out.append('Call context unresolved: method names alone do not establish receiver identity.')
    return out


def main():
    req = json.load(sys.stdin)
    root, prompt = req["repo_root"], req["prompt"]
    cache, seen = {}, set()
    out = python_handlers(root, prompt, cache)
    for rel, line, how, catalogue in filter(None, [origins(root, prompt)]):
        lines = read(root, rel, cache)
        index = line - 1
        if index >= len(lines):
            break
        name, start = enclosing(lines, index, rel.endswith(JS_EXT))
        if rel.endswith(".py"):
            how, name, start = python_role(lines, line)
        scope = (f" in {name}" if rel.endswith(".py") else f" near {name} (scope unresolved)") if name else ""
        out.append(f"### error origin — {how} at {rel}:{line}" + scope)
        if catalogue:
            crel, cline = catalogue
            clines = read(root, crel, cache)
            out += show(crel, clines, cline, cline, "message definition in catalogue; emission unverified")
        lo = max(start + 1, line - 12) if name else line - 6
        out += show(rel, lines, lo, line + 6, "candidate source occurrence; inspect the evidence category above")
        if not name:
            break
        seen.add((rel, name, name))
        callers(root, name, cache, seen, LEVELS, out, "/".join(rel.split("/")[:-1][:2]), rel)
        for hit in rg(root, "-n", "--no-heading", *SRC_GLOBS, rf"\b{re.escape(name)}\s*\(", "."):
            other, at, _ = hit.split(":", 2)
            other = other.lstrip("./")
            tlines = read(root, other, cache)
            if in_test(other, tlines, int(at) - 1):
                test, tstart = enclosing(tlines, int(at) - 1)
                out += show(other, tlines, tstart + 1, tstart + 24, f"test {test}: name match for {name}; binding unresolved")
                break
        break
    text = "\n".join(out)
    if text:
        sys.stdout.write((text if len(text) <= MAX_BYTES else text[:MAX_BYTES].rsplit("\n", 1)[0]) + "\n")


main()
