"""Quote error evidence without promoting lexical occurrences to runtime causes.
Literal/described matches remain candidates; Python syntax distinguishes message
assignments, documentation and local raises. Matching caught types add a handler
with its conversion/rethrow branches and import boundary. Name-only callers and
test links remain unresolved candidates, never a causal chain. Read-only and
deterministic; a missing parser result cannot prove an emission. Issues #906, #1231."""
import ast
import json
import math
import re
import stat
import subprocess
import sys
from pathlib import Path

SRC_GLOBS = ["-g", "*.rs", "-g", "*.py", "-g", "*.ts", "-g", "*.tsx", "-g", "*.js", "-g", "*.go"]
RG = ["rg", "--sort", "path", "-j", "1", "-g", "!.pixel"]
FN = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:fn|def|function)\s+([A-Za-z_]\w*)"
                r"|^\s*(?:export\s+)?(?:const|let)\s+([A-Za-z_]\w*)\s*=\s*(?:async\s*)?\(")
JS_EXT = (".js", ".ts", ".tsx", ".jsx")
MIN_QUOTE, MIN_WORDS, CALLER_LINES, LEVELS, MAX_LINES, MAX_BYTES = 12, 3, 14, 2, 220, 9000
MAX_DIAGNOSTIC_FILES, MAX_DIAGNOSTIC_PATH_BYTES = 1_500, 180_000
MAX_DIAGNOSTIC_FILE_BYTES, MAX_DIAGNOSTIC_LINE_CHARS = 1_000_000, 900
MAX_DIAGNOSTIC_OUTPUT_BYTES = 2_000_000
MAX_HANDLER_MANIFESTS, MAX_HANDLER_MANIFEST_BYTES = 128, 512_000
MAX_HANDLER_SOURCE_BYTES = 512_000


def rg(root, *args):
    """Lines of `rg`; without ripgrep (or past its time) the probe has nothing to say."""
    try:
        return subprocess.run([*RG, *args], cwd=root, capture_output=True, text=True, timeout=10).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []


def tracked_source_paths(root):
    """A small deterministic set of tracked regular source files, excluding symlink paths."""
    try:
        result = subprocess.run(["git", "ls-files", "-z", "--", "*.rs", "*.py", "*.ts", "*.tsx", "*.js", "*.go"],
                                cwd=root, capture_output=True, timeout=0.8)
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode or len(result.stdout) > 512_000:
        return []
    paths, used = [], 0
    for raw in sorted(set(result.stdout.split(b"\0")) - {b""}):
        try:
            rel = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        path = Path(rel)
        if path.is_absolute() or ".." in path.parts or not path.parts:
            continue
        current = Path(root)
        safe = True
        try:
            for part in path.parts:
                current /= part
                if current.is_symlink():
                    safe = False
                    break
            info = current.lstat() if safe else None
        except OSError:
            continue
        if not safe or info is None or not stat.S_ISREG(info.st_mode) or info.st_size > MAX_DIAGNOSTIC_FILE_BYTES:
            continue
        if used + len(raw) > MAX_DIAGNOSTIC_PATH_BYTES or len(paths) >= MAX_DIAGNOSTIC_FILES:
            break
        paths.append(rel)
        used += len(raw)
    return paths


def _js_mask_noncode(text):
    """Blank JS strings and comments while preserving offsets and line breaks."""
    chars = list(text)
    i = 0
    while i < len(text):
        if text.startswith("//", i):
            end = text.find("\n", i + 2)
            end = len(text) if end < 0 else end
            for j in range(i, end):
                chars[j] = " "
            i = end
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            end = len(text) if end < 0 else end + 2
            for j in range(i, end):
                if chars[j] != "\n":
                    chars[j] = " "
            i = end
        elif text[i] in "'\"`":
            quote = text[i]
            end = i + 1
            while end < len(text):
                if text[end] == "\\":
                    end += 2
                elif text[end] == quote:
                    end += 1
                    break
                else:
                    end += 1
            for j in range(i, min(end, len(text))):
                if chars[j] != "\n":
                    chars[j] = " "
            i = end
        else:
            i += 1
    return "".join(chars)


def _js_matching_brace(code, start):
    depth = 0
    for i in range(start, len(code)):
        if code[i] == "{":
            depth += 1
        elif code[i] == "}":
            depth -= 1
            if depth == 0:
                return i
    return -1


def _js_function_spans(code):
    pattern = re.compile(r"\bfunction(?:\s+[A-Za-z_$][\w$]*)?\s*\(([^)]*)\)\s*\{")
    spans = []
    for match in pattern.finditer(code):
        open_at = match.end() - 1
        close_at = _js_matching_brace(code, open_at)
        if close_at < 0:
            continue
        params = [part.strip() for part in match.group(1).split(",")]
        params = [part for part in params if re.fullmatch(r"[A-Za-z_$][\w$]*", part)]
        spans.append((match.start(), open_at, close_at, params))
    return spans


def _js_package_name(specifier):
    if not specifier or specifier.startswith((".", "/", "node:")):
        return None
    parts = specifier.split("/")
    if specifier.startswith("@"):
        return "/".join(parts[:2]) if len(parts) >= 2 else None
    return parts[0]


def _js_imports(text, code):
    found = {}
    patterns = (
        re.compile(r"\b(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*require\s*\("),
        re.compile(r"\bimport\s+([A-Za-z_$][\w$]*)\s+from\s*"),
    )
    for index, pattern in enumerate(patterns):
        for match in pattern.finditer(code):
            literal = re.match(r"\s*(['\"])([^'\"]+)\1" + (r"\s*\)" if index == 0 else ""), text[match.end():])
            dependency = _js_package_name(literal.group(2) if literal else None)
            if dependency:
                found.setdefault(match.group(1), []).append((dependency, match.start()))
    return found


def _tracked_package_manifests(root):
    """Read bounded tracked package manifests only; never follow manifest symlinks."""
    try:
        result = subprocess.run(["git", "ls-files", "-z", "--", ":(glob)**/package.json"], cwd=root,
                                capture_output=True, timeout=0.5)
    except (OSError, subprocess.SubprocessError):
        return {}
    if result.returncode or len(result.stdout) > MAX_HANDLER_MANIFEST_BYTES:
        return {}
    paths = sorted(set(result.stdout.split(b"\0")) - {b""})
    if len(paths) > MAX_HANDLER_MANIFESTS:
        return {}
    manifests, used = {}, 0
    for raw in paths:
        try:
            rel = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        path = Path(rel)
        if path.is_absolute() or ".." in path.parts or not path.parts:
            continue
        current = Path(root)
        safe = True
        try:
            for part in path.parts:
                current /= part
                if current.is_symlink():
                    safe = False
                    break
            info = current.lstat() if safe else None
        except OSError:
            continue
        if not safe or info is None or not stat.S_ISREG(info.st_mode) or info.st_size > 64_000:
            continue
        used += info.st_size
        if used > MAX_HANDLER_MANIFEST_BYTES:
            return {}
        try:
            text = current.read_text(errors="replace")
            data = json.loads(text)
        except (OSError, ValueError):
            continue
        deps = {}
        for section in ("dependencies", "optionalDependencies", "peerDependencies"):
            entries = data.get(section, {}) if isinstance(data, dict) else {}
            if isinstance(entries, dict):
                deps.update({name: version for name, version in entries.items() if isinstance(version, str)})
        manifests[str(path)] = (text.splitlines(), deps)
    return manifests


def _manifest_for_source(rel, manifests):
    directory = Path(rel).parent
    for parent in (directory, *directory.parents):
        manifest = str(parent / "package.json") if str(parent) != "." else "package.json"
        if manifest in manifests:
            return manifest, manifests[manifest]
    return None


def _js_arguments(body, open_at):
    depth = 0
    close_at = -1
    for i in range(open_at, len(body)):
        if body[i] == "(":
            depth += 1
        elif body[i] == ")":
            depth -= 1
            if depth == 0:
                close_at = i
                break
    if close_at < 0:
        return []
    inner = body[open_at + 1:close_at]
    args, start = [], 0
    parens = braces = brackets = 0
    for i, char in enumerate(inner):
        if char == "(":
            parens += 1
        elif char == ")":
            parens -= 1
        elif char == "{":
            braces += 1
        elif char == "}":
            braces -= 1
        elif char == "[":
            brackets += 1
        elif char == "]":
            brackets -= 1
        elif char == "," and parens == braces == brackets == 0:
            args.append(inner[start:i].strip())
            start = i + 1
    args.append(inner[start:].strip())
    return args


def _js_call_uses(body, result, request, response):
    # Require a routing-shaped final receiver segment, not an earlier component
    # such as `router_metrics`; the source name remains a candidate, not proof.
    call = re.compile(r"([A-Za-z_$][\w$]*(?:\s*\.\s*[A-Za-z_$][\w$]*)*)\s*\.\s*([A-Za-z_$][\w$]*)\s*\(")
    routing_receivers = {"router", "route", "routes", "dispatcher", "dispatch"}
    handling_methods = {"handle", "dispatch", "route", "complete", "finish", "next"}
    for match in call.finditer(body):
        receiver = match.group(1).strip()
        receiver_tail = receiver.split(".")[-1].strip().lower()
        receiver_role = receiver_tail.split("_")[-1].strip("$")
        if receiver_role not in routing_receivers or match.group(2).lower() not in handling_methods:
            continue
        args = _js_arguments(body, match.end() - 1)
        if len(args) < 3 or args[-1] != result:
            continue
        prefix = " ".join(args[:-1])
        if re.search(rf"\b{re.escape(request)}\b", prefix) and re.search(rf"\b{re.escape(response)}\b", prefix):
            return match.start(), f"{receiver}.{match.group(2)}"
    return None


def default_handler_boundary(root, prompt, paths, cache):
    """Locate an imported dependency used as the default request-completion callback."""
    if not re.search(r"\bdefault\b", prompt, re.I) or not re.search(r"\b404\b|\bnot[\s-]+found\b", prompt, re.I):
        return []
    manifests = _tracked_package_manifests(root)
    if not manifests:
        return []
    candidates, used = [], 0
    for rel in paths:
        if not rel.endswith(JS_EXT) or is_test_path(rel) or re.search(r"(^|/)examples?\/", rel, re.I):
            continue
        lines = read(root, rel, cache)
        source = "\n".join(lines)
        size = len(source.encode("utf-8", errors="replace"))
        used += size
        if used > MAX_HANDLER_SOURCE_BYTES:
            return []
        code = _js_mask_noncode(source)
        imported = _js_imports(source, code)
        manifest_pair = _manifest_for_source(rel, manifests)
        if not imported or not manifest_pair:
            continue
        manifest_rel, (manifest_lines, dependencies) = manifest_pair
        spans = _js_function_spans(code)
        for start, open_at, close_at, params in spans:
            body_start = open_at + 1
            body_chars = list(code[body_start:close_at])
            for nested_start, _nested_open, nested_close, _nested_params in spans:
                if nested_start > open_at and nested_close < close_at:
                    for index in range(nested_start - body_start, nested_close - body_start + 1):
                        if 0 <= index < len(body_chars) and body_chars[index] != "\n":
                            body_chars[index] = " "
            body = "".join(body_chars)
            if re.search(r"(?<![\w$])/(?:\\.|[^/\n]){1,180}/[a-z]*", body, re.I):
                continue  # regex literals make this lightweight brace scanner uncertain
            request = next((name for name in params if re.fullmatch(r"(?:req|request)", name, re.I)), None)
            response = next((name for name in params if re.fullmatch(r"(?:res|response)", name, re.I)), None)
            if not request or not response:
                continue
            assignment = re.compile(r"\b(?:(?:const|let|var)\s+)?([A-Za-z_$][\w$]*)\s*=\s*"
                                    r"([A-Za-z_$][\w$]*)\s*\|\|\s*([A-Za-z_$][\w$]*)\s*\(")
            for match in assignment.finditer(body):
                result_name, callback, binding = match.groups()
                if callback not in params or binding in params:
                    continue
                if re.search(rf"\b(?:const|let|var|class|function)\s+{re.escape(binding)}\b", body):
                    continue  # any local declaration could shadow the imported binding
                bindings = imported.get(binding, [])
                if len(bindings) != 1:
                    continue
                dependency, import_at = bindings[0]
                if dependency not in dependencies:
                    continue
                fallback_args = _js_arguments(body, match.end() - 1)
                if not any(re.search(rf"\b{re.escape(request)}\b", arg) for arg in fallback_args):
                    continue
                if not any(re.search(rf"\b{re.escape(response)}\b", arg) for arg in fallback_args):
                    continue
                use = _js_call_uses(body[match.end():], result_name, request, response)
                if use is None:
                    continue
                use_at, callee = use
                fallback_at = body_start + match.start()
                use_line_at = body_start + match.end() + use_at
                manifest_lines_for_dependency = [i + 1 for i, line in enumerate(manifest_lines)
                                                 if re.search(rf"\"{re.escape(dependency)}\"\s*:", line)]
                if len(manifest_lines_for_dependency) != 1:
                    continue
                candidates.append((rel, source, dependency, binding, import_at, fallback_at, use_line_at, callee,
                                   manifest_rel, manifest_lines, manifest_lines_for_dependency[0]))
    if len(candidates) != 1:
        return []
    rel, source, dependency, binding, import_at, fallback_at, use_at, callee, manifest_rel, manifest_lines, manifest_line = candidates[0]
    source_lines = source.splitlines()
    import_line = source.count("\n", 0, import_at) + 1
    fallback_line = source.count("\n", 0, fallback_at) + 1
    use_line = source.count("\n", 0, use_at) + 1
    out = [f"### default handler callback candidate — optional callback falls back to an imported dependency; "
           f"the handler receives request/response and is passed as the final argument to {callee}; "
           "callee behavior and external response text are not inspected"]
    out += show(rel, source_lines, import_line, import_line, "imported dependency binding")
    out += show(rel, source_lines, fallback_line - 1, fallback_line, "optional callback fallback")
    out += show(rel, source_lines, use_line, use_line, f"passes the selected handler to {callee}; call behavior unverified")
    out.append(f"### {manifest_rel}:{manifest_line}-{manifest_line} — declared non-development dependency: {dependency}")
    out.append(f"{manifest_line}| {manifest_lines[manifest_line - 1][:MAX_DIAGNOSTIC_LINE_CHARS]}")
    return out


def tracked_rg(root, paths, *args):
    """Search only the bounded tracked regular-file list; truncate long matching lines."""
    if not paths:
        return []
    try:
        result = subprocess.run([*RG, "--with-filename", "--max-count", "8", "--max-filesize", "1M", "--max-columns",
                                 str(MAX_DIAGNOSTIC_LINE_CHARS), "--max-columns-preview", *args, "--", *paths],
                                cwd=root, capture_output=True, text=True, timeout=0.8)
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode not in (0, 1) or len(result.stdout.encode("utf-8", errors="replace")) > MAX_DIAGNOSTIC_OUTPUT_BYTES:
        return []
    return result.stdout.splitlines()


def quoted(prompt):
    return re.findall(r"""['"`‘“]([^'"`’”]{%d,})['"`’”]""" % MIN_QUOTE, prompt)


STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "how", "the", "and", "are", "they", "them",
        "for", "into", "about", "when", "should", "their", "there", "these", "those", "have", "your", "one", "than",
        "its", "was", "has", "can", "not", "but", "all", "any", "you", "of", "to", "in", "is", "it", "on", "at", "by",
        "an", "or", "as", "be", "do", "if", "so", "up", "me", "my", "we", "us", "am"}
LITERAL_EXT = (".json",)          # message catalogues: the text lives here and the code names its key
MIN_SHARED, SEED_WORDS, SEED_HITS = 2, 4, 300
TRIPLE = re.compile(r'"""|\'\'\'')


def tokens(text):
    """The words of code or prose, split at case changes, underscores and punctuation, lowercased."""
    return [t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", text)]


def stem(word):
    if len(word) > 4 and word.endswith("ies"):
        return word[:-3] + "y"
    for suffix in ("ing", "ed", "s"):
        if len(word) - len(suffix) >= 3 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def string_part(text):
    """The text inside the string literals of a code line ('', \"\" or ``), joined."""
    # An escape and a plain character never match the same text (a plain one is no backslash): no backtracking blowup.
    return " ".join(m.group(2) for m in re.finditer(r"""(["'`])((?:\\.|(?!\1)[^\\])*)\1""", text))


def prompt_words(prompt):
    return [w for w in dict.fromkeys(stem(t) for t in tokens(prompt) if len(t) >= 2 and t not in STOP)]


def open_quotes(text, rel):
    """How many string delimiters a stretch of code holds: triple quotes in Python, backticks in JS, unescaped double
    quotes (outside char literals) in Rust and the rest; an odd count leaves a string open."""
    if rel.endswith(".py"):
        return len(TRIPLE.findall(text))
    if rel.endswith(JS_EXT):
        return text.count("`")
    return len(re.findall(r'(?<![\\\'])"', text))


def in_multiline_string(lines, index, rel):
    """The line sits inside a string that spans lines: Python triple quotes or a JS template literal opened above."""
    start = max(0, index - 60)   # a message spans a few lines; parity over a bounded window keeps it cheap
    return open_quotes("\n".join(lines[start:index]), rel) % 2 == 1


def carried(word, toks):
    """A token starting with the word carries it; a word of three letters or fewer must be the token (`no` is not
    in `not`)."""
    return word in toks if len(word) <= 3 else any(t.startswith(word) for t in toks)


def emitter(lines, first, rel):
    """The words of what emits a string that starts on line `first`: the call opening on that line or the one above,
    and the name of the enclosing function (`eprint_nothing_searched`, `err_message!`)."""
    name, _start = enclosing(lines, first, rel.endswith(JS_EXT))
    above = lines[first - 1] if first > 0 else ""
    return set(tokens(" ".join([name or "", above, lines[first].split('"')[0].split("'")[0]])))


def string_span(lines, index, rel, reach=8):
    """`(first, last)` line index of the multi-line string that holds line `index` (itself when it holds none), or
    `None` when the string runs past `reach` lines on either side: a manual page or a doc block, not a message."""
    lo = index
    while in_multiline_string(lines, lo, rel):
        if lo <= max(0, index - reach):
            return None
        lo -= 1
    hi = index
    while hi + 1 < len(lines) and in_multiline_string(lines, hi + 1, rel):
        if hi >= index + reach:
            return None
        hi += 1
    return lo, hi


def described(root, prompt):
    """A message the prompt describes without quoting it: the string literal that carries most of the prompt's words
    (two at least), each weighed by how few source lines carry it, as `(path, line, catalogue)`. Candidate lines come
    from the rarest words; a literal in a message catalogue (JSON) is followed to the code that names its key."""
    words = prompt_words(prompt)
    globs = SRC_GLOBS + ["-g", "*.json"]
    df = {}
    for w in words:
        counts = rg(root, "-c", "-i", "-F", *globs, w, ".")
        df[w] = sum(int(c.rpartition(":")[2]) for c in counts if c.rpartition(":")[2].isdigit())
    present = sorted((w for w in words if df[w]), key=lambda w: (df[w], w))
    if len(present) < MIN_SHARED:
        return None
    total = sum(df.values()) + 1
    idf = {w: math.log(total / df[w]) for w in present}
    best, seen, cache = None, set(), {}
    for w in present[:SEED_WORDS]:
        for hit in rg(root, "-n", "--no-heading", "-i", "-F", *globs, w, ".")[:SEED_HITS]:
            if hit.count(":") < 2:
                continue
            path, line, text = hit.split(":", 2)
            rel = path.lstrip("./")
            if (rel, line) in seen or is_test_path(rel) or re.match(r"\s*(//|#|\*|/\*)", text):
                continue
            seen.add((rel, line))
            message, context = string_part(text), set()
            if not rel.endswith(LITERAL_EXT):
                lines = read(root, rel, cache)
                index = int(line) - 1
                if index >= len(lines) or in_test(rel, lines, index):
                    continue
                span = string_span(lines, index, rel)
                if span and span[0] == span[1] and open_quotes(text, rel) % 2 == 1:   # it opens here
                    span = string_span(lines, index + 1, rel) if index + 1 < len(lines) else None
                    span = span and (index, span[1])
                if span is None:
                    continue
                if span[1] > span[0]:   # the whole string, wherever the word fell in it
                    message = " ".join(lines[span[0]:span[1] + 1])
                context = emitter(lines, span[0], rel)
            words_in = tokens(message)
            if not any(carried(r, set(words_in)) for r in present):
                continue   # the emitter's words only count beside a string that carries the question's own
            inside = set(words_in) | context
            shared = [r for r in present if carried(r, inside)]
            if len(shared) < MIN_SHARED:
                continue
            # More of the question's words first; then rarer words packed in a shorter text (a message, not a manual).
            key = (-len(shared), -sum(idf[r] for r in shared) / math.log2(4 + len(words_in)), rel, int(line))
            if best is None or key < best[0]:
                best = (key, rel, int(line), text)
    if best is None:
        return None
    _key, rel, line, text = best
    if rel.endswith(LITERAL_EXT):
        name = re.match(r'\s*"([A-Za-z_][\w.-]*)"\s*:', text)
        if not name:
            return None
        for hit in rg(root, "-n", "--no-heading", "-w", "-F", *SRC_GLOBS, name.group(1), "."):
            path, at, _ = hit.split(":", 2)
            if not is_test_path(path.lstrip("./")):
                return path.lstrip("./"), int(at), (rel, line)
        return None
    return rel, line, None


def is_test_path(rel):
    return bool(re.search(r"(^|/)tests?/|_test\.|test_", rel))


def locate(root, message):
    """Hits of the longest leading run of `message` (at least MIN_WORDS words) found literally in non-test source."""
    words = re.split(r"(\s+)", message.strip())
    for n in range(len(words), MIN_WORDS + 1, -2):
        fragment = "".join(words[:n]).split("(")[0].split("{")[0].strip(" :")
        if len(fragment.split()) < MIN_WORDS:
            break
        hits = [h for h in rg(root, "-n", "--no-heading", "-F", *SRC_GLOBS, fragment, ".")
                if not is_test_path(h.split(":")[0]) and in_string(h, fragment)]
        if hits:
            return hits
    return []


def in_string(hit, fragment):
    """The fragment sits inside a string literal of a code line: a quote before it, and the line is not a comment."""
    text = hit.split(":", 2)[2] if hit.count(":") >= 2 else ""
    at = text.find(fragment)
    return at > 0 and any(q in text[:at] for q in "\"'`") and not re.match(r"\s*(//|#|\*|/\*)", text)


def definitions(root, name):
    """Files that define a function called `name`."""
    pattern = rf"\b(fn|def|function)\s+{re.escape(name)}\b"
    return sorted({h.split(":")[0].lstrip("./") for h in rg(root, "-n", "--no-heading", *SRC_GLOBS, pattern, ".")})


def enclosing(lines, index, js=False):
    """`(name, line index)` of the function a line is in; the `const x = (` form only counts in JS and TS."""
    for j in range(min(index, len(lines) - 1), -1, -1):
        match = FN.match(lines[j])
        if match and (match.group(1) or js):
            return (match.group(1) or match.group(2)), j
    return None, 0


def show(rel, lines, lo, hi, label):
    lo, hi = max(1, lo), min(len(lines), hi)
    return [f"### {rel}:{lo}-{hi} — {label}"] + [f"{k}| {lines[k - 1][:160]}" for k in range(lo, hi + 1)]


def in_test(rel, lines, index):
    """Test code: a tests path, or after a `mod tests`; an attribute alone marks nothing."""
    return is_test_path(rel) or any(re.match(r"\s*(pub\s+)?mod tests\b", l) for l in lines[:index])


def read(root, rel, cache):
    if rel not in cache:
        try:
            cache[rel] = (Path(root) / rel).read_text(errors="replace").splitlines()
        except OSError:   # a directory, a dangling link: nothing to quote
            cache[rel] = []
    return cache[rel]


def callers(root, name, cache, seen, depth, out, home, defined_in):
    """Bounded lexical call candidates; directory proximity does not resolve receiver or binding identity."""
    if depth == 0 or len(out) > MAX_LINES:
        return
    near = None
    if len(definitions(root, name)) > 1:
        near = defined_in.rsplit("/", 1)[0] + "/" if "/" in defined_in else ""
    frontier = []
    for hit in rg(root, "-n", "--no-heading", *SRC_GLOBS, rf"\b{re.escape(name)}\s*\(", ".")[:40]:
        path, line, text = hit.split(":", 2)
        rel = path.lstrip("./")
        if re.search(rf"\b(fn|def|function)\s+{re.escape(name)}\b", text):
            continue
        lines = read(root, rel, cache)
        index = int(line) - 1
        if in_test(rel, lines, index):
            continue
        if near is not None and not rel.startswith(near):
            continue
        if home and depth < LEVELS and not rel.startswith(home + "/"):
            continue  # deeper levels stay in the origin's directory; `crates/pixel/` is not `crates/pixel-x/`
        caller, start = enclosing(lines, index, rel.endswith(JS_EXT))
        if not caller or (rel, caller, name) in seen:
            continue
        seen.add((rel, caller, name))
        lo = max(start + 1, index + 1 - CALLER_LINES)
        if lo > start + 4:
            out += show(rel, lines, start + 1, start + 3, f"{caller}: lexical caller candidate (scope/binding unresolved)")
        out += show(rel, lines, lo, index + 4, f"{caller} → {name}: lexical call candidate; receiver/binding unresolved; scope unverified" +
                    ("; independent context, no composed path" if depth < LEVELS else ""))
        if depth > 1 and near is None:
            frontier.append((caller, rel))
    # Visit every direct match before indirect context can claim the shared seen slot.
    for caller, rel in frontier:
        callers(root, caller, cache, seen, depth - 1, out, home, rel)


def origins(root, prompt):
    """`(path, line, how, catalogue)` of the message the prompt asks about: a quoted one found literally first, else
    the literal the prompt describes."""
    for message in quoted(prompt)[:3]:
        hits = locate(root, message)
        if hits:
            path, line, _ = hits[0].split(":", 2)
            return path.lstrip("./"), int(line), "quoted occurrence candidate; emission unverified", None
    found = described(root, prompt)
    if found:
        rel, line, catalogue = found
        return rel, line, "described occurrence candidate; emission unverified", catalogue
    return None


def error_emission(root, prompt, paths=None):
    """Find a bounded diagnostic emitter whose nearby tracked source carries two salient prompt terms."""
    generic = {"error", "exception", "alert", "message", "warning", "text", "code", "where", "which", "what",
               "when", "does", "do", "how", "the", "and", "or", "is", "are", "was", "were", "be", "not",
               "printed", "print", "produced", "defined", "raised", "raise", "emitted", "emits", "called",
               "comes", "come", "from", "that", "says", "reads", "contains", "default", "page"}
    salient = set(prompt_words(prompt)) - generic
    if len(salient) < 2:
        return None
    paths = tracked_source_paths(root) if paths is None else paths
    pattern = r"(?:print_error!|eprintln!|bail!|throw\s+(?:new\s+)?(?:Error|Exception)|next\(err\))"
    best = None
    cache = {}
    for hit in tracked_rg(root, paths, "-n", "--no-heading", pattern):
        if hit.count(":") < 2:
            continue
        rel, at, _text = hit.split(":", 2)
        if is_test_path(rel):
            continue
        try:
            line = int(at)
        except ValueError:
            continue
        lines = read(root, rel, cache)
        if not lines or line > len(lines):
            continue
        # Macros often put their message on the following line. Keep context in the same function when one is clear.
        _, function_start = enclosing(lines, line - 1, rel.endswith(JS_EXT))
        lo_context, hi_context = max(function_start, line - 5), min(len(lines), line + 4)
        function_end = len(lines)
        for following in range(line, hi_context):
            match = FN.match(lines[following])
            if match and (match.group(1) or rel.endswith(JS_EXT)):
                hi_context = following
                function_end = following
                break
        shared = salient & {stem(token) for token in tokens(" ".join(lines[lo_context:hi_context]))}
        if len(shared) < 2:
            continue
        statement = lines[line - 1]
        priority = (0 if "print_error!" in statement else
                    1 if "eprintln!" in statement else
                    2 if "throw" in statement else
                    3 if "bail!" in statement else 4)
        rank = (-len(shared), priority, rel, line)
        if best is None or rank < best[0]:
            out = show(rel, lines, max(function_start + 1, line - 6), min(function_end, line + 6),
                       "error-emission candidate; matching terms and source condition, exact runtime cause unproven")
            best = (rank, rel, line, out)
    return None if best is None else (best[1], best[2], best[3])


def python_role(lines, line):
    """Classify syntax and its actual Python function span, never a nearby definition."""
    role = 'occurrence candidate; emission unverified'
    try:
        tree = ast.parse('\n'.join(lines))
    except (SyntaxError, ValueError, RecursionError):
        return role, None, 0
    functions = [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
                 and n.lineno <= line <= n.end_lineno]
    scope = max(functions, key=lambda n: n.lineno) if functions else None
    for node in ast.walk(tree):
        if not (getattr(node, 'lineno', 0) <= line <= getattr(node, 'end_lineno', 0)):
            continue
        if isinstance(node, ast.Raise):
            role = 'local raise syntax; message origin candidate'
            break
        if isinstance(node, (ast.Assign, ast.AnnAssign)) and isinstance(node.value, ast.Constant):
            role = 'message definition; emission unverified'
            break
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            role = 'documentation occurrence; no emission proved'
            break
    return role, scope.name if scope else None, scope.lineno - 1 if scope else 0


def handler_nodes(node):
    """Only this handler's lexical scope; nested functions/classes own their raises."""
    yield node
    for child in ast.iter_child_nodes(node):
        if not isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
            yield from handler_nodes(child)


def python_handlers(root, prompt, cache):
    """Quote matching typed handlers, not name-only callers. Imports mark a boundary, not an external raise."""
    meaningful = set(prompt_words(prompt)) - {'error', 'exception', 'message', 'text', 'type', 'warning'}
    candidates = []
    for path in rg(root, '-l', '-g', '*.py', r'^\s*(except|raise)\b', '.')[:80]:
        rel = path.removeprefix('./')
        if is_test_path(rel):
            continue
        lines = read(root, rel, cache)
        try:
            tree = ast.parse('\n'.join(lines))
        except (SyntaxError, ValueError, RecursionError):
            continue
        parents = {c: n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
        for handler in ast.walk(tree):
            if not isinstance(handler, ast.ExceptHandler) or handler.type is None:
                continue
            shared = meaningful & {stem(t) for t in tokens(ast.unparse(handler.type))}
            if len(shared) < MIN_SHARED:
                continue
            raises = [n for n in handler_nodes(handler) if isinstance(n, ast.Raise)]
            if not raises:
                continue
            candidates.append((-len(shared), rel, handler.lineno, handler, raises, parents, tree))
    if not candidates:
        return []
    _, rel, _, handler, raises, parents, tree = min(candidates, key=lambda x: x[:3])
    lines = cache[rel]
    owner = parents.get(handler)
    lo = max(handler.lineno - 20, getattr(owner, 'lineno', handler.lineno))
    out = show(rel, lines, lo, min(handler.end_lineno, handler.lineno + 55),
               'conversion/rethrow candidate: matching caught type; runtime message origin unresolved')
    types = {n.id for n in ast.walk(handler.type) if isinstance(n, ast.Name)}
    for node in tree.body:
        if isinstance(node, ast.ImportFrom) and any((a.asname or a.name) in types for a in node.names):
            out += show(rel, lines, node.lineno, node.end_lineno,
                        'dependency boundary candidate: matching import name; binding unresolved; external emission not inspected')
    # The syntax is direct evidence of raising here; matching the question's message remains a hypothesis.
    for raised in raises[:6]:
        out += show(rel, lines, raised.lineno, raised.end_lineno,
                    'local raise/rethrow syntax in this handler; message identity unverified')
    out.append('Call context unresolved: method names alone do not establish receiver identity.')
    return out


def main():
    req = json.load(sys.stdin)
    root, prompt = req["repo_root"], req["prompt"]
    cache, seen = {}, set()
    paths = tracked_source_paths(root)
    boundary = default_handler_boundary(root, prompt, paths, cache)
    out = list(boundary)
    out += python_handlers(root, prompt, cache)
    diagnostic = error_emission(root, prompt, paths)
    if diagnostic and not (boundary and re.search(r"(^|/)examples?/", diagnostic[0], re.I)):
        out += diagnostic[2]
    origin = origins(root, prompt)
    if boundary and origin and re.search(r"(^|/)examples?/", origin[0], re.I):
        origin = None  # a sample page is not the default handler's external response
    if diagnostic and origin and origin[0] == diagnostic[0] and not origin[2].startswith("quoted occurrence"):
        origin = None  # the matching source emitter outranks a lexical neighbor in the same file
    for rel, line, how, catalogue in filter(None, [origin]):
        lines = read(root, rel, cache)
        index = line - 1
        if index >= len(lines):
            break
        name, start = enclosing(lines, index, rel.endswith(JS_EXT))
        if rel.endswith(".py"):
            how, name, start = python_role(lines, line)
        scope = (f" in {name}" if rel.endswith(".py") else f" near {name} (scope unresolved)") if name else ""
        out.append(f"### error origin — {how} at {rel}:{line}" + scope)
        if catalogue:
            crel, cline = catalogue
            clines = read(root, crel, cache)
            out += show(crel, clines, cline, cline, "message definition in catalogue; emission unverified")
        lo = max(start + 1, line - 12) if name else line - 6
        out += show(rel, lines, lo, line + 6, "candidate source occurrence; inspect the evidence category above")
        if not name:
            break
        seen.add((rel, name, name))
        callers(root, name, cache, seen, LEVELS, out, "/".join(rel.split("/")[:-1][:2]), rel)
        for hit in rg(root, "-n", "--no-heading", *SRC_GLOBS, rf"\b{re.escape(name)}\s*\(", "."):
            other, at, _ = hit.split(":", 2)
            other = other.lstrip("./")
            tlines = read(root, other, cache)
            if in_test(other, tlines, int(at) - 1):
                test, tstart = enclosing(tlines, int(at) - 1)
                out += show(other, tlines, tstart + 1, tstart + 24, f"test {test}: name match for {name}; binding unresolved")
                break
        break
    text = "\n".join(out)
    if text:
        sys.stdout.write((text if len(text) <= MAX_BYTES else text[:MAX_BYTES].rsplit("\n", 1)[0]) + "\n")


main()
