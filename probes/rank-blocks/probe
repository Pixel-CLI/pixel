"""rank-blocks: the answer is often in the brief already, buried among blocks that share no word with the question.
Scores each block by the question's words its header names, drops the blocks that share none, moves the rest to
the front by score, and shows the best constants with 12 lines of context and where they are used. Says nothing
when no block shares a word with the question (it never empties a brief)."""
import json
import re
import subprocess
import sys
from pathlib import Path

STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "the", "and", "how", "is", "a", "of", "it",
        "defined", "define", "number", "returns", "return", "set", "get", "use", "used", "make", "could", "there"}
CONTEXT_BLOCKS, CONTEXT_LINES, USES = 3, 12, 4


def stem(word):
    word = word.lower()
    for suffix in ("ing", "es", "s"):
        if len(word) > 4 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def words(text):
    parts = re.findall(r"[A-Za-z][a-z]+|[A-Z]+(?![a-z])", text)
    return {stem(p) for p in parts if len(p) > 2 and p.lower() not in STOP}


def blocks_of(brief):
    blocks, current = [], None
    for line in brief.splitlines():
        if line.startswith("### "):
            current = [line]
            blocks.append(current)
        elif current is not None:
            current.append(line)
    return blocks


def with_context(root, header):
    m = re.match(r"### (?:pixel/)?(\S+?):(\d+)-(\d+) — (.+?) \(constant\)", header)
    if not m:
        return None
    path, lo, hi, names = m.group(1), int(m.group(2)), int(m.group(3)), m.group(4)
    try:
        source = (Path(root) / path).read_text(errors="replace").splitlines()
    except OSError:
        return None
    first, last = max(1, lo - CONTEXT_LINES), min(len(source), hi + CONTEXT_LINES)
    out = [f"### {path}:{first}-{last} — {names} (constant, with context)"]
    out += [f"{i}| {source[i - 1][:160]}" for i in range(first, last + 1)]
    for name in [n.strip() for n in names.split(",")][:2]:
        hits = subprocess.run(["rg", "-n", "-w", "--no-heading", "--sort", "path", "-j", "1", "-m", "3", name, "--glob", "!**/tests/**", "."],
                              cwd=root, capture_output=True, text=True, timeout=10).stdout.splitlines()
        uses = [h for h in hits if not re.search(rf"const {re.escape(name)}\b", h)][:USES]
        if uses:
            out.append(f"uses of {name}:")
            out += [use[:180] for use in uses]
    return out


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    blocks = blocks_of(brief)
    want = words(prompt)
    scored = []
    for index, block in enumerate(blocks):
        header = block[0]
        label, _, rest = header[4:].partition(" — ")
        score = len(want & words(rest + " " + label))
        scored.append((score, index, block))
    keep = sorted((s for s in scored if s[0] > 0), key=lambda s: (-s[0], s[1]))
    if not keep:
        return
    for score, _, block in scored:
        if score == 0:
            print(f"drop: ^{re.escape(block[0][4:])}$")
    for rank, (_, _, block) in enumerate(keep):
        context = with_context(root, block[0]) if rank < CONTEXT_BLOCKS else None
        if context:
            print(f"drop: ^{re.escape(block[0][4:])}$")
            print("\n".join(context))
        else:
            print(f"first: ^{re.escape(block[0][4:])}$")


main()
