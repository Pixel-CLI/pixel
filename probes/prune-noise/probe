"""prune-noise: a brief is useful for the blocks the answer reads, and the rest costs tokens and attention. This
probe only removes: it rewrites the brief it receives as a smaller one and adds no evidence.

Rules, each generic (they read the block's header shape, never a name, and the question's own words):
  doc        documentation sections go unless the question asks for an overview or documentation
  list       test-name lists go when the brief shows test bodies; config-registry rows go unless the row names a
             reader site and the key is named by the question; a bare slice only stays when a kept row cites it
  complete   shell-completion files go unless the question names completions
  merge      overlapping line ranges of one file are joined into one block
  region     lines of a whole-file region that another block of the file already shows are removed
  trace      the call trace is rewritten as `caller -> callee path:line`, constructors and edge-less entries removed
  cap        no block above 2.5 KB (12 lines for a test body): the window with the most question words stays
  total      default 8 KB, 12 KB for flow and test questions; the least valuable blocks go first

It replaces the whole brief (`drop: .` then its own blocks, mode lead) and prints nothing when nothing shrank.
Read-only, deterministic, no network."""
import json
import os
import re
import sys

BLOCK_CAP, HARD_CAP, HARD_CAP_DOC, TEST_LINES, TOTAL_CAP, TOTAL_CAP_WIDE = 2500, 6000, 6000, 18, 8000, 14000
SYM_WEIGHT = 3
FOOTER_PREFIXES = ("Answer from this context.", "These are the regions closest", "pack incomplete", "confidence:")
HEADER = re.compile(r"^### (.+?):(\d+)(?:-(\d+))?(?: — (.*))?$")
NUMBERED = re.compile(r"^(\d+)\| ?(.*)$")
WIDE_KINDS = {"flow", "tests", "overview"}
WIDE_PROMPT = re.compile(r"(?i)\b(trace|flow|call chain|end to end|from \w+ through|tests?)\b")
DOC_KINDS = {"overview"}
DOC_PROMPT = re.compile(r"(?i)\b(readme|documentation|docs?|guide|manual|overview|tour|describe|contains?|"
                        r"made of|make up|consists?)\b")
COMPLETE_PROMPT = re.compile(r"(?i)complet|shell")
COMPLETE_PATH = re.compile(r"(?i)(^|/)(complete|completions?|completer)(/|$)|\.(zsh|fish|bash|ps1)$")
STOP = {"the", "and", "for", "with", "from", "that", "this", "what", "which", "where", "when", "does", "how",
        "are", "was", "its", "can", "not", "has", "any", "all", "but", "you", "our", "into", "than", "then",
        "each", "code", "file", "files", "line", "value", "values", "function"}
WEIGHT = {"commit": 100, "definition": 90, "test": 80, "flag": 70, "usage": 60, "other": 50, "region": 40,
          "trace": 30, "doc": 20, "list": 10}   # which class wins a merge
TIER = {"commit": 1000.0, "definition": 2.0, "test": 2.0, "flag": 2.0, "usage": 1.0, "other": 1000.0, "region": 1.0,
        "trace": 0.3, "doc": 0.3, "list": 0.3}   # how much a byte of each class is worth when the total is over


def subwords(text):
    return [w.lower() for w in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", text)]


def squash(text):
    return re.sub(r"[^a-z0-9]", "", text.lower())


def anchors(prompt, head):
    """``(words, symbols)``: the question's content subwords and its identifiers (and the ones the pack searched)."""
    words = {w for w in subwords(prompt) if len(w) >= 3 and w not in STOP}
    syms = {squash(t) for t in re.findall(r"[A-Za-z0-9_-]+", prompt)
            if re.search(r"_|-{2}", t) or re.search(r"[a-z][A-Z]", t) or re.fullmatch(r"[A-Z0-9_]{4,}", t)}
    m = re.search(r"searched (.+?) in the symbol graph", head)
    if m:
        syms |= {squash(t) for t in m.group(1).split(",") if len(squash(t)) >= 4}
    return words, {s for s in syms if len(s) >= 4}


def line_weight(text, words, syms):
    norm = squash(text)
    hits = len(words & set(subwords(text))) + SYM_WEIGHT * sum(1 for s in syms if s in norm)
    return hits


def split_blocks(brief):
    lines = brief.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    footer = []
    while lines and lines[-1].startswith(FOOTER_PREFIXES):
        footer.insert(0, lines.pop())
    head, blocks = [], []
    for line in lines:
        if line.startswith("### "):
            blocks.append([line])
        elif blocks:
            blocks[-1].append(line)
        else:
            head.append(line)
    for block in blocks:
        while block and block[-1] == "":
            block.pop()
    return head, blocks, footer


class Block:
    def __init__(self, lines):
        self.lines = lines
        self.header = lines[0]
        m = HEADER.match(self.header)
        self.path = self.label = None
        self.lo = self.hi = None
        self.body = {}      # line number -> text, for a numbered block
        self.notes = []
        self.ranged = False
        if m:
            self.path, self.lo = m.group(1), int(m.group(2))
            self.hi = int(m.group(3) or m.group(2))
            self.label = m.group(4) or ""
            numbered = [NUMBERED.match(x) for x in lines[1:] if x != ""]
            if numbered and all(n or x.startswith("…") for n, x in zip(numbered, [x for x in lines[1:] if x != ""])):
                self.ranged = True
                for x in lines[1:]:
                    n = NUMBERED.match(x)
                    if n:
                        self.body[int(n.group(1))] = n.group(2)
                    elif x.startswith("…"):
                        self.notes.append(x)
        self.cat = self.classify()
        self.dropped = None

    def classify(self):
        h = self.header[4:]
        if h.startswith("config registry"):
            return "registry"
        if h.startswith("tests matching") or h.startswith("tests of "):
            return "list"
        if h.startswith("call trace"):
            return "trace"
        if h.endswith("(documentation section)"):
            return "doc"
        if h.startswith(("change ", "diff of")) or "in commit" in h:
            return "commit"
        if not self.ranged:
            return "other"
        label = self.label or ""
        if self.label is None or label == "":
            return "bare"
        if re.search(r"\((?:a )?test(?: of [^)]*)?\)$", label):
            return "test"
        if label.endswith(" region") or "whole file" in label:
            return "region"
        if " definition" in label:
            return "definition"
        if " usage" in label:
            return "usage"
        return "flag"

    def size(self):
        if self.ranged:
            return len(self.header) + 1 + sum(len(f"{n}| {t}") + 1 for n, t in self.body.items()) + sum(
                len(x) + 1 for x in self.notes)
        return sum(len(x) + 1 for x in self.lines)

    def render(self):
        if not self.ranged:
            return list(self.lines)
        keys = sorted(self.body)
        span = f"{keys[0]}" if keys[0] == keys[-1] else f"{keys[0]}-{keys[-1]}"
        header = f"### {self.path}:{span}" + (f" — {self.label}" if self.label else "")
        out = [header] + [f"{n}| {self.body[n]}" for n in keys]
        return out + (self.notes if keys[-1] == self.hi else [])


def drop(block, why, stats):
    stats[why] = stats.get(why, 0) + block.size()
    block.dropped = why


def registry_keep(block, prompt, keep_sites):
    """Rows that name a reader site and whose key the question names; returns the kept rows."""
    low = squash(prompt)
    rows = [x for x in block.lines[1:] if x.startswith("- ")]
    kept = []
    for row in rows:
        cells = [c.strip() for c in row[2:].split(" | ")]
        site = re.search(r"read at ([^\s,;]+?):(\d+)", cells[-1] if cells else "")
        if site and len(squash(cells[0])) >= 4 and squash(cells[0]) in low:
            kept.append(row)
            keep_sites.add((site.group(1), int(site.group(2))))
    return kept


def rewrite_trace(block):
    """`caller -> callee path:line` edges; constructors (a capitalised callee) and entries with no edge are removed."""
    edges, stack = [], []
    for raw in block.lines[1:]:
        m = re.match(r"^(\s*)(entry|calls) (\S+) — (\S+?):(\d+)", raw)
        if not m:
            continue
        depth = (len(m.group(1)) // 2) if m.group(2) == "calls" else -1
        name, path, line = m.group(3), m.group(4), m.group(5)
        if m.group(2) == "entry":
            stack = [name]
            continue
        del stack[depth:]
        caller = stack[-1] if stack else "?"
        stack.append(name)
        if not name[:1].isupper():
            edges.append(f"{caller} -> {name} {path}:{line}")
    return [block.header] + edges if edges else None


def window(block, cap_bytes, cap_lines, words, syms):
    keys = sorted(block.body)
    sizes = [len(f"{n}| {block.body[n]}") + 1 for n in keys]
    if sum(sizes) <= cap_bytes and len(keys) <= cap_lines:
        return False
    sym = squash((block.label or "").split(" ")[0])
    weights = [line_weight(block.body[n], words, syms | ({sym} if len(sym) >= 4 else set())) for n in keys]
    if block.cat == "definition":
        weights[0] += 6     # the signature is the lines a definition is read for
    if block.cat == "test":
        weights = [w + (3 if re.search(r"ass.rt|expect|panic|should", block.body[n]) else 0) for w, n in zip(weights, keys)]
    best, bi, bj, bs = -1, 0, 0, 0
    for i in range(len(keys)):
        j, used, gain = i, 0, 0
        while j < len(keys) and used + sizes[j] <= cap_bytes and j - i < cap_lines:
            used += sizes[j]
            gain += weights[j]
            j += 1
        if j > i and gain > best:
            best, bi, bj, bs = gain, i, j, used
    while True:     # spend the rest of the budget on context, after then before
        grown = False
        if bj < len(keys) and bs + sizes[bj] <= cap_bytes and bj - bi < cap_lines:
            bs += sizes[bj]
            bj += 1
            grown = True
        if bi > 0 and bs + sizes[bi - 1] <= cap_bytes and bj - bi < cap_lines:
            bi -= 1
            bs += sizes[bi]
            grown = True
        if not grown:
            break
    block.body = {n: block.body[n] for n in keys[bi:bj]}
    return True


def merge_overlaps(blocks, stats):
    """Blocks of one file and one class (region or not) whose ranges overlap become the first of them."""
    out, seen = [], {}
    for block in blocks:
        if not block.ranged or block.dropped:
            out.append(block)
            continue
        klass = (block.path, block.cat == "region")
        target = None
        for other in seen.get(klass, []):
            if other.lo <= block.hi and block.lo <= other.hi:
                target = other
                break
        if target is None:
            seen.setdefault(klass, []).append(block)
            out.append(block)
            continue
        before = block.size() + target.size()
        target.body.update(block.body)
        target.lo, target.hi = min(target.lo, block.lo), max(target.hi, block.hi)
        if WEIGHT.get(block.cat, 0) > WEIGHT.get(target.cat, 0):
            target.cat = block.cat
        stats["merge"] = stats.get("merge", 0) + before - target.size()
        block.dropped = "merged"
    return out


def subtract_regions(blocks, stats):
    shown = {}
    for block in blocks:
        if block.ranged and not block.dropped and block.cat != "region":
            shown.setdefault(block.path, set()).update(block.body)
    result = []
    for block in blocks:
        if block.dropped or not block.ranged or block.cat != "region":
            result.append(block)
            continue
        covered = shown.get(block.path, set())
        keep = [n for n in sorted(block.body) if n not in covered]
        if len(keep) == len(block.body):
            result.append(block)
            continue
        before = block.size()
        runs, run = [], []
        for n in keep:
            if run and n != run[-1] + 1:
                runs.append(run)
                run = []
            run.append(n)
        runs.append(run)
        pieces = []
        for run in runs:
            if len(run) < 3:
                continue
            piece = Block(block.lines[:1])
            piece.path, piece.label, piece.ranged, piece.cat = block.path, block.label, True, "region"
            piece.lo, piece.hi, piece.notes = run[0], run[-1], []
            piece.body = {n: block.body[n] for n in run}
            pieces.append(piece)
        stats["region"] = stats.get("region", 0) + before - sum(p.size() for p in pieces)
        result.extend(pieces)
    return result


def prune(brief, prompt, kind):
    head, raw, footer = split_blocks(brief)
    blocks = [Block(b) for b in raw]
    words, syms = anchors(prompt, "\n".join(head))
    stats = {}
    doc_ok = kind in DOC_KINDS or bool(DOC_PROMPT.search(prompt))
    complete_ok = bool(COMPLETE_PROMPT.search(prompt))
    has_test_body = any(b.cat == "test" for b in blocks)
    keep_sites = set()
    for block in blocks:
        if block.cat == "doc":
            seen_words = {w for x in block.lines for w in subwords(x)} & words
            if not doc_ok or not seen_words:
                drop(block, "doc", stats)
        elif block.cat == "list" and has_test_body:
            drop(block, "list", stats)
        elif block.cat == "registry":
            rows = registry_keep(block, prompt, keep_sites)
            if rows:
                before = block.size()
                block.lines = [block.lines[0]] + rows
                stats["registry"] = stats.get("registry", 0) + before - block.size()
            else:
                drop(block, "registry", stats)
        elif block.ranged and not complete_ok and COMPLETE_PATH.search(block.path):
            drop(block, "complete", stats)
        elif block.cat == "trace":
            new = rewrite_trace(block)
            if new is None:
                drop(block, "trace", stats)
            else:
                before = block.size()
                block.lines = new
                stats["trace"] = stats.get("trace", 0) + before - block.size()
    for i, block in enumerate(blocks):
        if block.cat == "bare" and not block.dropped:
            tied = any(b.cat == "registry" for b in blocks[:i])
            if tied and not any(block.path == p and block.lo <= n <= block.hi for p, n in keep_sites):
                drop(block, "registry", stats)
    blocks = [b for b in blocks if not b.dropped]
    blocks = merge_overlaps(blocks, stats)
    blocks = [b for b in blocks if not b.dropped]
    blocks = subtract_regions(blocks, stats)
    for block in blocks:
        if block.ranged:
            before = block.size()
            if window(block, HARD_CAP_DOC if doc_ok else HARD_CAP, TEST_LINES if block.cat == "test" else 10**6, words, syms):
                stats["cap"] = stats.get("cap", 0) + before - block.size()
    wide = kind in WIDE_KINDS or bool(WIDE_PROMPT.search(prompt))
    cap = TOTAL_CAP_WIDE if wide else TOTAL_CAP
    fixed = sum(len(x) + 1 for x in head + footer)

    def total():
        return fixed + sum(b.size() for b in blocks)

    def value(i):
        """Hits of the question's words per KB (head and label count double), times a tier for the block's role."""
        b = blocks[i]
        hits = 0
        if b.ranged:
            hits = sum(line_weight(t, words, syms) for t in b.body.values())
            hits += 2 * line_weight(f"{b.path} {b.label}", words, syms)
        tier = TIER.get(b.cat, 1.0)
        return (tier * (hits + 0.5) / max(b.size(), 1) * 1000, -i)

    def hits_of(b):
        return sum(line_weight(t, words, syms) for t in b.body.values()) if b.ranged else 0

    while total() > cap and len(blocks) > 1:
        options = []
        for i, b in enumerate(blocks):
            tier = TIER.get(b.cat, 1.0)
            head_hits = 2 * line_weight(f"{b.path} {b.label}", words, syms) if b.ranged else 0
            options.append(((tier * (hits_of(b) + head_hits + 0.5)) / max(b.size(), 1), -i, "drop", i, None))
            if b.ranged and b.cat != "commit" and b.size() > BLOCK_CAP:
                small = Block(b.render())
                small.cat, small.label = b.cat, b.label
                if window(small, BLOCK_CAP, TEST_LINES if b.cat == "test" else 10**6, words, syms):
                    saved = b.size() - small.size()
                    lost = tier * max(hits_of(b) - hits_of(small), 0) + 0.25
                    options.append((lost / max(saved, 1), -i, "shrink", i, small))
        _, _, action, i, small = min(options, key=lambda o: o[:2])
        if action == "shrink":
            stats["total"] = stats.get("total", 0) + blocks[i].size() - small.size()
            blocks[i] = small
        else:
            stats["total"] = stats.get("total", 0) + blocks[i].size()
            del blocks[i]
    return head, blocks, footer, stats


def main():
    req = json.load(sys.stdin)
    brief = req.get("brief", "")
    if "### " not in brief:
        return
    head, blocks, footer, stats = prune(brief, req.get("prompt", ""), req.get("kind"))
    if not blocks:
        return
    out = []
    for block in blocks:
        out += block.render()
    new = "\n".join(out)
    old = "\n".join(l for b in split_blocks(brief)[1] for l in b)
    if len(new) >= len(old):
        return
    if os.environ.get("PRUNE_NOISE_STATS"):
        print(json.dumps(stats), file=sys.stderr)
    print("drop: .")
    print(new)


if __name__ == "__main__":
    main()
