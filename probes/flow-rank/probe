"""flow-rank: a walkthrough question is answered by the callees that carry its words, not by a depth-first prefix
of the entry's calls. The entry is the one the question names in code form (`client.fetch`, `handle_event`) when the
graph defines it, else the one the brief's trace names. Reads every callee of the entry (who-calls pages), ranks them
by the question's words (generic words weigh little, tests are left out, an exact edge weighs a little more), follows
the best six one level at a time down to depth 3 (from a named entry, a level where fewer than two callees carry the
question's words keeps its best three: a narrow chain is the path), and shows the entry in full and each ranked body.
It replaces the brief's own flow blocks. Needs `pixel` (PIXEL_BIN, else PATH) and its daemon; prints nothing without
them. Issues #906, #1198."""
import json
import os
import re
import stat
import subprocess
import sys
import time
from pathlib import Path

GENERIC = {"element", "elements", "scene", "file", "files", "data", "state", "value", "type"}
NOISE = {"walk", "through", "happens", "happen", "someone", "until", "from", "shows", "when", "onto", "that", "file",
         "with", "what", "into"}
ENTRY_LINES, BODY_LINES, MAX_RANKED, MIN_SCORE = 160, 130, 12, 1.0
SHORTCUT_SCAN_BYTES, SHORTCUT_FILE_BYTES, SHORTCUT_FILES, SHORTCUT_SCAN_MS = 24_000_000, 600_000, 3000, 700


def pixel(root, *args):
    exe = os.environ.get("PIXEL_BIN") or "pixel"
    try:
        return subprocess.run([exe, *args], cwd=root, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def callees(root, uid):
    out, offset = [], 0
    while offset <= 200:
        text = pixel(root, "who-calls", "--role", "callees", "--metrics", "off", "--json", "--offset", str(offset),
                     uid, ".")
        try:
            data = json.loads(text)
        except ValueError:
            break
        edges = data.get("edges", [])
        out += edges
        if len(edges) < data.get("edge_limit", 20):
            break
        offset += len(edges)
    return out


def numbered(root, path, lo, hi, cap):
    try:
        lines = (Path(root) / path).read_text(errors="replace").splitlines()
    except OSError:
        return [], lo
    hi = min(hi, lo + cap - 1, len(lines))
    return [f"{n}| {lines[n - 1][:200]}" for n in range(lo, hi + 1)], hi


def shortcut_evidence(root, prompt):
    """Resolve a named modifier+key action to its source action, dispatcher, and handler."""
    if not re.search(r"\b(walk|trace|flow|happens|path)\b", prompt, re.I):
        return ""
    chord = re.search(r"\b(ctrl|control|cmd|command|meta)\s*\+\s*([a-z0-9])\b", prompt, re.I)
    if not chord:
        return ""
    key = chord.group(2).upper()
    root = Path(root).resolve()
    try:
        listing = subprocess.run(["git", "ls-files", "-z"], cwd=root, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, timeout=0.5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    suffixes = {".ts", ".tsx", ".js", ".jsx", ".py", ".rs", ".go", ".java", ".kt", ".swift"}
    rows, total, deadline = [], 0, time.monotonic() + SHORTCUT_SCAN_MS / 1000
    for raw in listing.split(b"\0")[:SHORTCUT_FILES + 1]:
        if time.monotonic() >= deadline:
            break
        if not raw:
            continue
        rel = Path(os.fsdecode(raw))
        if rel.is_absolute() or ".." in rel.parts or rel.suffix.lower() not in suffixes:
            continue
        path = root / rel
        try:
            resolved = path.resolve(strict=True)
            if root not in resolved.parents or path.is_symlink():
                continue
            info = path.stat()
            if not stat.S_ISREG(info.st_mode) or info.st_size > SHORTCUT_FILE_BYTES:
                continue
            if total + info.st_size > SHORTCUT_SCAN_BYTES:
                break
            text = path.read_text(errors="replace")
        except OSError:
            continue
        total += info.st_size
        rows.append((rel.as_posix(), text.splitlines()))

    key_forms = [rf"KEYS\.{re.escape(key)}\b", rf"event\.key\s*=+\s*['\"]{re.escape(key.lower())}['\"]",
                 rf"key\s*=+\s*['\"]{re.escape(key.lower())}['\"]"]
    key_re = re.compile("|".join(key_forms), re.I)
    action = None
    for path, lines in rows:
        if "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            if line.lstrip().startswith(("//", "#", "*")) or not key_re.search(line):
                continue
            context = "\n".join(lines[max(0, i - 4):min(len(lines), i + 5)])
            if not re.search(r"ctrl|control|meta|command|cmd", context, re.I):
                continue
            start = max(0, i - 12)
            for j in range(i, max(-1, i - 30), -1):
                if re.search(r"(?:export\s+)?(?:const|let|var|function|class)\s+([\w$]+)", lines[j]):
                    start = j
                    break
            body = lines[start:min(len(lines), i + 13)]
            joined = "\n".join(body)
            if not re.search(r"\b(undo|redo)\b", joined, re.I):
                continue
            m = re.search(r"(?:export\s+)?(?:const|let|var|function|class)\s+([\w$]+)", lines[start])
            action = (path, start + 1, min(len(lines), i + 13), m.group(1) if m else "action", joined)
            break
        if action:
            break
    if not action:
        return ""

    action_path, action_lo, action_hi, action_name, action_body = action
    method = "redo" if re.search(r"\bredo\b", action_body, re.I) and not re.search(r"\bundo\b", action_body, re.I) else "undo"
    out = [f"### shortcut flow: {chord.group(1)}-{key} action {action_name}",
           f"### {action_path}:{action_lo}-{action_hi} — key action {action_name}"]
    out.extend(f"{n}| {line[:200]}" for n, line in enumerate(rows[[p for p, _ in rows].index(action_path)][1][action_lo - 1:action_hi], action_lo))

    def window(path, lines, idx, radius=8):
        lo, hi = max(0, idx - radius), min(len(lines), idx + radius + 1)
        return path, lo + 1, hi, lines[lo:hi]

    handler = None
    for path, lines in rows:
        if "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            declaration = rf"^\s*(?:(?:public|private|protected|async|static)\s+)*(?:function\s+|def\s+)?{method}\s*\("
            if re.search(declaration, line) and "." not in line.split(method, 1)[0]:
                handler = window(path, lines, i)
                break
        if handler:
            break
    dispatch = None
    for path, lines in rows:
        if "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            region = lines[max(0, i - 15):min(len(lines), i + 65)]
            if re.search(r"keyTest", line) and any("actions" in x for x in region) and any("executeAction" in x for x in region):
                execute_at = next((j for j in range(i, min(len(lines), i + 65)) if "executeAction" in lines[j]), None)
                dispatch = (path, lines, i, execute_at)
                break
        if dispatch:
            break
    if dispatch:
        path, lines, key_at, execute_at = dispatch
        first = (max(0, key_at - 8), min(len(lines), key_at + 8))
        second = (max(0, execute_at - 3), min(len(lines), execute_at + 4)) if execute_at is not None else first
        indices = sorted(set(range(*first)) | set(range(*second)))
        out.append(f"### {path}:{indices[0] + 1}-{indices[-1] + 1} — action dispatcher selection and execution")
        out.extend(f"{i + 1}| {lines[i][:200]}" for i in indices)
    if handler:
        path, lo, hi, lines = handler
        out.append(f"### {path}:{lo}-{hi} — {method} handler")
        out.extend(f"{n}| {line[:200]}" for n, line in enumerate(lines, lo))
    return "\n".join(out)[:5200]


def request_router_evidence(root, prompt):
    """Show the tracked app-to-router request handoff for a request/response walkthrough."""
    if not re.search(r"\b(walk|trace|flow|happens|path)\b", prompt, re.I) or not all(
        re.search(rf"\b{term}\b", prompt, re.I) for term in ("request", "router", "response")
    ):
        return ""
    root = Path(root).resolve()
    try:
        listing = subprocess.run(["git", "ls-files", "-z"], cwd=root, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, timeout=0.5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    suffixes = {".ts", ".tsx", ".js", ".jsx", ".py", ".rs", ".go", ".java", ".kt", ".swift"}
    rows, total, deadline = [], 0, time.monotonic() + SHORTCUT_SCAN_MS / 1000
    for raw in listing.split(b"\0")[:SHORTCUT_FILES + 1]:
        if time.monotonic() >= deadline:
            break
        if not raw:
            continue
        rel = Path(os.fsdecode(raw))
        if rel.is_absolute() or ".." in rel.parts or rel.suffix.lower() not in suffixes:
            continue
        path = root / rel
        try:
            resolved = path.resolve(strict=True)
            if root not in resolved.parents or path.is_symlink():
                continue
            info = path.stat()
            if not stat.S_ISREG(info.st_mode) or info.st_size > SHORTCUT_FILE_BYTES:
                continue
            if total + info.st_size > SHORTCUT_SCAN_BYTES:
                break
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        total += info.st_size
        rows.append((rel.as_posix(), lines))
    handoff = None
    for path, lines in rows:
        if "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            if line.lstrip().startswith(("//", "#", "*")) or not re.search(r"\.router\.handle\s*\(", line):
                continue
            window = (path, max(0, i - 18), min(len(lines), i + 5), lines)
            handoff = window
            break
        if handoff:
            break
    if not handoff:
        return ""
    path, lo, hi, lines = handoff
    out = ["### request flow: app delegates request/response to router",
           f"### {path}:{lo + 1}-{hi} — app-to-router handoff"]
    out.extend(f"{n}| {line[:200]}" for n, line in enumerate(lines[lo:hi], lo + 1))
    for candidate, body in rows:
        if "test" in candidate.lower() or "spec" in candidate.lower():
            continue
        for i, line in enumerate(body):
            if re.search(r"\bapp\s*=\s*function\s*\(", line) and any(
                re.search(r"\bapp\.handle\s*\(", item) for item in body[i:min(len(body), i + 8)]
            ):
                start, end = max(0, i - 5), min(len(body), i + 9)
                out.append(f"### {candidate}:{start + 1}-{end} — application request entry")
                out.extend(f"{n}| {text[:200]}" for n, text in enumerate(body[start:end], start + 1))
                return "\n".join(out)[:5200]
    return "\n".join(out)[:5200]


def event_delivery_evidence(root, prompt):
    """Resolve a prompt-named event literal, its handler, and a nearby output sink."""
    if not re.search(r"\bhook\b", prompt, re.I) or not re.search(r"\bbrief\b", prompt, re.I) or not re.search(
        r"\b(print|printed|prints|write|written|output|delivers?)\b", prompt, re.I
    ):
        return ""
    event_match = re.search(r"\b([a-z][a-z0-9]*[-_][a-z][a-z0-9]*)\b", prompt, re.I)
    if not event_match:
        return ""
    event_literal = event_match.group(1).lower().replace("_", "-")
    event_variant = "".join(part[:1].upper() + part[1:] for part in re.split(r"[-_]", event_match.group(1)))
    root = Path(root).resolve()
    try:
        listing = subprocess.run(["git", "ls-files", "-z"], cwd=root, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, timeout=0.5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    suffixes = {".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".go", ".java", ".kt", ".swift"}
    rows, total, deadline = [], 0, time.monotonic() + SHORTCUT_SCAN_MS / 1000
    for raw in listing.split(b"\0")[:SHORTCUT_FILES + 1]:
        if time.monotonic() >= deadline:
            break
        if not raw:
            continue
        rel = Path(os.fsdecode(raw))
        if rel.is_absolute() or ".." in rel.parts or rel.suffix.lower() not in suffixes:
            continue
        path = root / rel
        try:
            resolved = path.resolve(strict=True)
            if root not in resolved.parents or path.is_symlink():
                continue
            info = path.stat()
            if not stat.S_ISREG(info.st_mode) or info.st_size > SHORTCUT_FILE_BYTES:
                continue
            if total + info.st_size > SHORTCUT_SCAN_BYTES:
                break
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        total += info.st_size
        rows.append((rel.as_posix(), lines))
    event = None
    for path, lines in rows:
        if "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            if re.search(rf"['\"]{re.escape(event_literal)}['\"]", line) and not line.lstrip().startswith(("//", "#", "*")):
                variant = re.search(rf"(?:Self::|::)({re.escape(event_variant)})\s*=>", line)
                if variant:
                    event = (path, lines, i, variant.group(1))
                    break
        if event:
            break
    if not event:
        return ""
    event_path, event_lines, event_idx, variant = event
    run_start = next((i for i, line in enumerate(event_lines) if re.search(r"\bfn\s+run\s*\(", line)), None)
    sink = next((i for i, line in enumerate(event_lines) if "writeln!(stdout" in line), None)
    if run_start is None or sink is None or sink < run_start or sink - run_start > 180:
        return ""
    signature = re.search(r"\bevent\s*:\s*([A-Z][A-Za-z0-9_]*)", event_lines[run_start])
    if not signature:
        return ""
    event_type = signature.group(1)
    enum_start = next((i for i, line in enumerate(event_lines)
                       if re.search(rf"\benum\s+{re.escape(event_type)}\b", line)), None)
    if enum_start is None or not any(re.search(rf"\b{re.escape(variant)}\b", line)
                                     for line in event_lines[enum_start:min(len(event_lines), enum_start + 40)]):
        return ""
    consumer = next((i for i in range(run_start, sink)
                     if not re.search(r"\bfn\s+", event_lines[i])
                     and re.search(r"\bprocess\w*\s*\([^;\n]*\bevent\b[^;\n]*\)", event_lines[i])), None)
    if consumer is None:
        return ""
    enum_window = (enum_start, min(len(event_lines), max(event_idx + 4, enum_start + 4)))
    out = [f"### event flow: {event_literal} -> {variant} -> hook output",
           f"### {event_path}:{enum_window[0] + 1}-{enum_window[1]} — typed event and host-name mapping"]
    out.extend(f"{i + 1}| {event_lines[i][:200]}" for i in range(*enum_window))
    signature_hi = min(len(event_lines), run_start + 3)
    out.append(f"### {event_path}:{run_start + 1}-{signature_hi} — runner receives typed event")
    out.extend(f"{i + 1}| {event_lines[i][:200]}" for i in range(run_start, signature_hi))
    lo, hi = max(run_start, consumer - 3), min(sink + 1, consumer + 4)
    out.append(f"### {event_path}:{lo + 1}-{hi} — runner passes event to processing")
    out.extend(f"{i + 1}| {event_lines[i][:200]}" for i in range(lo, hi))
    brief_calls = [i for i, line in enumerate(event_lines)
                   if re.search(r"\b[A-Za-z_]\w*brief\w*\s*\(", line, re.I)
                   and not re.search(r"\b(fn|def|function)\s+", line)]
    for i in brief_calls[:2]:
        lo, hi = max(0, i - 3), min(len(event_lines), i + 5)
        out.append(f"### {event_path}:{lo + 1}-{hi} — brief processing call chain")
        out.extend(f"{n + 1}| {event_lines[n][:200]}" for n in range(lo, hi))
    input_read = next((i for i in range(run_start, sink) if re.search(r"read\w*\s*\(", event_lines[i])), None)
    if input_read is not None:
        lo, hi = max(run_start, input_read - 3), min(sink + 1, input_read + 5)
        out.append(f"### {event_path}:{lo + 1}-{hi} — hook reads the incoming event")
        out.extend(f"{n + 1}| {event_lines[n][:200]}" for n in range(lo, hi))
    lo, hi = max(run_start, sink - 5), min(len(event_lines), sink + 4)
    out.append(f"### {event_path}:{lo + 1}-{hi} — hook writes and flushes output")
    out.extend(f"{n + 1}| {event_lines[n][:200]}" for n in range(lo, hi))
    module = Path(event_path).stem
    for path, lines in rows:
        if path == event_path or "test" in path.lower() or "spec" in path.lower():
            continue
        for i, line in enumerate(lines):
            if re.search(rf"\b{re.escape(module)}::run\s*\(", line):
                lo, hi = max(0, i - 3), min(len(lines), i + 4)
                invocation = "\n".join(lines[lo:hi])
                call = re.search(rf"\b{re.escape(module)}::run\s*\(([^)]{{0,400}})\)", invocation, re.S)
                if not call or not re.search(r"\bevent\b", call.group(1)):
                    continue
                out.append(f"### {path}:{lo + 1}-{hi} — command passes event to hook runner")
                out.extend(f"{n + 1}| {lines[n][:200]}" for n in range(lo, hi))
                return "\n".join(out)[:5200]
    return "\n".join(out)[:5200]


def symbols(root, name):
    try:
        found = json.loads(pixel(root, "find-symbol", "--metrics", "off", "--json", name, ".") or "{}")
    except ValueError:
        return []
    return found.get("symbols") or found.get("hits") or []


def named_entry(root, prompt):
    """The entry a walkthrough names in code form (`client.fetch`, `handle_event`, `app.mount`): the first such name
    the graph defines, as `(uid, name, path, lo, hi)`. A dotted name's leading parts pick among same-named symbols
    (a path that holds them), then a function over a method, then the shortest path; tests never."""
    names = re.findall(r"`([A-Za-z_][\w.]*)`", prompt)
    names += re.findall(r"\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+\b", prompt)
    names += re.findall(r"\b[a-z][a-z0-9]*(?:_[a-z0-9]+)+\b|\b[a-z]+[A-Z]\w*\b", prompt)
    for full in dict.fromkeys(names):
        parts = full.split(".")
        rows = [r for r in symbols(root, parts[-1]) if r.get("name", "").split(".")[-1] == parts[-1]
                and "test" not in r.get("path", "").lower()]
        if not rows:
            continue
        rows.sort(key=lambda r: (-sum(q.lower() in r["path"].lower() for q in parts[:-1]),
                                 r.get("kind") != "function", len(r["path"]), r["path"]))
        r = rows[0]
        return r["uid"], parts[-1], r["path"], r["start_line"], r["end_line"]
    return None


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    shortcut = shortcut_evidence(root, prompt)
    if shortcut:
        print("drop: .")
        print(shortcut)
        return
    request_flow = request_router_evidence(root, prompt)
    if request_flow:
        print("drop: .")
        print(request_flow)
        return
    event_flow = event_delivery_evidence(root, prompt)
    if event_flow:
        print("drop: .")
        print(event_flow)
        return
    named = named_entry(root, prompt)
    m = re.search(r"^entry (\S+) — (\S+?):(\d+)-(\d+)", brief, re.M)
    if named:
        uid, name, path, lo, hi = named   # the question's own entry wins over the one the brief guessed
    elif m and "### call trace" in brief:
        name, path, lo, hi = m.group(1), m.group(2), int(m.group(3)), int(m.group(4))
        uid = next((s["uid"] for s in symbols(root, name) if s.get("path") == path and s.get("start_line") == lo), None)
        if uid is None:
            return
    else:
        return
    terms = [w for w in dict.fromkeys(w.lower() for w in re.findall(r"[A-Za-z]{4,}", prompt)) if w not in NOISE]
    pool = {}

    def scored():
        res = []
        for sym, tier, depth in pool.values():
            n, p = sym["name"].lower(), sym["path"].lower()
            weight = {t: (0.35 if t in GENERIC else 1.2) for t in terms}
            score = sum(weight[t] for t in terms if t in n) + sum(0.3 * weight[t] for t in terms if t in p)
            score += 0.3 if tier == "exact" else 0.0
            if "test" in p or "polyfill" in p:
                score -= 9
            res.append((score - 0.25 * (depth - 1), sym["uid"], sym, depth))
        return sorted(res, key=lambda r: (-r[0], r[1]))

    frontier, kept = [uid], set()
    for depth in (1, 2, 3):
        for u in frontier[:6]:
            for edge in callees(root, u):
                sym = edge["symbol"]
                if sym["uid"] != uid and sym["uid"] not in pool:
                    pool[sym["uid"]] = (sym, edge["tier"], depth)
        level = [r for r in scored() if r[3] == depth and r[0] > -1]
        passing = [r for r in level if r[0] > MIN_SCORE]
        # From an entry the question names, a narrow chain is the path itself: keep its best non-test callees even
        # when their names do not carry the question's words (`client.fetch` calls `send`, then `Pool.open`).
        chosen = passing if named is None or len(passing) >= 2 else level[:3]
        frontier = [r[1] for r in chosen]
        for r in chosen:
            kept.add(r[1])
    ranked = [r for r in scored() if r[0] > MIN_SCORE or r[1] in kept][:MAX_RANKED]
    if not ranked:
        return
    print("drop: .")
    print("### call trace, ranked by the question")
    print(f"entry {name} — {path}:{lo}-{hi}")
    for _, _, sym, depth in ranked:
        print(f"{'  ' * depth}calls {sym['name']} — {sym['path']}:{sym['start_line']}-{sym['end_line']}")
    body, last = numbered(root, path, lo, hi, ENTRY_LINES)
    print(f"### {path}:{lo}-{last} — {name} definition (method)")
    print("\n".join(body))
    if last < hi:
        print(f"… {name} continues past line {last}")
    for _, _, sym, _ in ranked:
        body, last = numbered(root, sym["path"], sym["start_line"], sym["end_line"], BODY_LINES)
        print(f"### {sym['path']}:{sym['start_line']}-{last} — {sym['name']} definition ({sym['kind']})")
        print("\n".join(body))


if __name__ == "__main__":
    main()
