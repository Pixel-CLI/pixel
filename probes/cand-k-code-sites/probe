"""cand-k-code-sites: the code a configuration question reads, not the manual that describes it.

Two shapes, both derived from the prompt and the repository when the probe runs:

* env: an ALL_CAPS_NAME of the prompt that a source file spells (not a doc) is a variable. The function that reads
  it is shown, then the functions of the same file it calls, then the function that calls it (who applies the
  loaded values). Blocks of the brief that are documentation (`.md`, man pages, `doc/` trees) are dropped when
  the code was found: the manual restates what the code shows.
* sites: "which flags/options/settings govern X, and where are they used?": the prompt's rare identifier
  stems (follows -> follow) are searched in non-test code; every hit is mapped to its enclosing definition, the
  definitions that rank highest (a header naming the stem, several hits, several stems) are shown, at most two
  per file.

Read-only (rg, git, file reads), deterministic (sorted), prints nothing when it has nothing to add."""
import json
import math
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

CODE_EXT = ("rs", "py", "ts", "tsx", "js", "jsx", "go", "java", "kt", "c", "h", "cc", "cpp", "hpp", "cs", "rb", "swift", "php", "scala")
TESTY = re.compile(r"(^|/)(tests?|__tests__|spec|benches|examples?|fuzz|vendor|node_modules|target|testdata)/|"
                   r"(_test|\.test|\.spec)\.\w+$|(^|/)test_[^/]*$")
DOCY = re.compile(r"^\S*\.(md|rst|txt|adoc|[0-9])\b:|^\S*/doc/")
DECL = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:export\s+)?(?:default\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?"
                  r"(fn|def|func|function|class|struct|enum|impl|trait|interface|mod|object)\b")
ARROW = re.compile(r"^\s*(?:export\s+)?(?:const|let)\s+\w+\s*=\s*(?:async\s*)?(?:\([^)]*\)|\w+)\s*(?::[^=]+)?=>")
NAME = re.compile(r"(?:fn|def|function|func)\s*(?:\([^)]*\)\s*)?([A-Za-z_]\w*)")
ENV_TOKEN = re.compile(r"\b[A-Z][A-Z0-9]*_[A-Z0-9_]*[A-Z0-9]\b")
WHERE = re.compile(r"(?i)\bwhere\b.*\b(appl\w+|used|handled|enforced|checked|honou?red|read)\b")
SUBJECT = re.compile(r"(?i)\b(flags?|options?|settings?|switch(?:es)?|parameters?|arguments?|toggles?)\b")
QUESTION_WORDS = {"which", "where", "apply", "applies", "does", "what",
                  "that", "this", "with", "from", "when", "they", "them", "their", "used", "uses", "using", "have",
                  "flag", "flags", "option", "options", "setting", "settings", "enable", "enables", "disable",
                  "disables", "affect", "affects", "decide", "decides", "turn", "turns", "toggle", "toggles",
                  "switch", "parameter", "argument", "code", "value", "values", "handled", "handle", "handles",
                  "found", "find", "finds", "read", "reads", "show", "shows", "make", "makes", "determine"}
MAX_REGION, ENV_REGION, SITE_REGION = 60, 60, 26
BUDGET_ENV, BUDGET_SITES = 7000, 7000
LINE_CHARS = 118
MAX_FILE_BYTES = 300_000


def run(root, *cmd):
    try:
        return subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=8, stdin=subprocess.DEVNULL).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def rg(root, *args):
    out = run(root, "rg", "--sort", "path", "-j", "1", "-n", "--no-heading", "--glob", "!.pixel", *args, ".")
    return [l[2:] if l.startswith("./") else l for l in out.splitlines()]


class Files:
    def __init__(self, root):
        self.root, self.cache, self.masks = root, {}, {}
        self.tracked = [f for f in run(root, "git", "ls-files").splitlines() if f]

    def lines(self, path):
        if path not in self.cache:
            text = safe_lines(self.root, path)
            mask = set()
            for n, line in enumerate(text):
                if re.match(r"\s*#\[(cfg\(test\)|test)\]", line):
                    for d in range(n + 1, min(len(text), n + 4)):
                        if DECL.match(text[d]):
                            mask.update(range(n, decl_end(text, d) + 1))
                            break
            self.masks[path] = mask
            self.cache[path] = text
        return self.cache[path]

    def is_test(self, path, i):
        self.lines(path)
        return i in self.masks.get(path, ())

    def code(self, path):
        return path.rsplit(".", 1)[-1] in CODE_EXT and not TESTY.search(path)


def safe_lines(root, path):
    """Read a bounded regular file below root without following symlinks."""
    directory_fd = None
    file_fd = None
    try:
        relative = Path(path)
        nofollow = getattr(os, "O_NOFOLLOW", None)
        if nofollow is None or relative.is_absolute() or not relative.parts or any(
            part in ("", ".", "..") for part in relative.parts
        ):
            return []
        directory_fd = os.open(Path(root).resolve(), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        for part in relative.parts[:-1]:
            next_fd = os.open(
                part,
                os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | nofollow,
                dir_fd=directory_fd,
            )
            os.close(directory_fd)
            directory_fd = next_fd
        file_fd = os.open(
            relative.parts[-1],
            os.O_RDONLY | nofollow | getattr(os, "O_NONBLOCK", 0),
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_FILE_BYTES:
            return []
        chunks, total = [], 0
        while total <= MAX_FILE_BYTES:
            chunk = os.read(file_fd, MAX_FILE_BYTES + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > MAX_FILE_BYTES:
            return []
        return b"".join(chunks).decode("utf-8", errors="replace").splitlines()
    except (OSError, RuntimeError):
        return []
    finally:
        if file_fd is not None:
            os.close(file_fd)
        if directory_fd is not None:
            os.close(directory_fd)


def indent(line):
    return len(line) - len(line.lstrip())


def is_comment(line):
    s = line.strip()
    return not s or s.startswith(("//", "#", "*", "/*", "--", "<!--", '"""', "'''"))


def decl_end(lines, d):
    """Index of the last line of the definition that starts at ``d``."""
    n = indent(lines[d])
    head = " ".join(lines[d:d + 3])
    if lines[d].rstrip().endswith(";") and "{" not in lines[d]:
        return d
    if re.search(r":\s*$", lines[d].rstrip()) and "{" not in head:   # python style
        for j in range(d + 1, min(len(lines), d + 400)):
            if lines[j].strip() and indent(lines[j]) <= n:
                return j - 1
        return len(lines) - 1
    for j in range(d + 1, min(len(lines), d + 400)):
        s = lines[j].strip()
        if indent(lines[j]) == n and s[:1] == "}":
            return j
    return min(len(lines) - 1, d + 40)


def decls_of(lines):
    found = []
    for i, line in enumerate(lines):
        if DECL.match(line) or ARROW.match(line):
            found.append(i)
    return found


def chain(lines, decls, ends, i):
    """The definitions containing line ``i``, innermost first."""
    out = []
    for d in decls:
        if d > i:
            break
        if d not in ends:
            ends[d] = decl_end(lines, d)
        if ends[d] >= i:
            out.append(d)
    return sorted(out, key=lambda d: (-d))


def with_docs(lines, d):
    while d > 0 and lines[d - 1].strip().startswith(("///", "//!", "#[", "@", "/**", "* ", "*/", "//")) and d > 0:
        d -= 1
    return d


def with_type(lines, d):
    """An `impl ... for Name` also shows the one-line `struct Name;` just above it, with its docs."""
    if not re.match(r"\s*impl\b", lines[d]):
        return d
    e = d - 1
    while e > 0 and not lines[e].strip():
        e -= 1
    if e <= d - 2 and re.match(r"\s*(pub(\([^)]*\))?\s+)?(struct|enum)\b", lines[e]) and lines[e].rstrip().endswith(";"):
        return with_docs(lines, e)
    return d


def window(lo, hi, hits, size):
    """At most ``size`` lines of [lo, hi], starting at the definition and then around the hits."""
    if hi - lo + 1 <= size:
        return lo, hi
    mid = (min(hits) + max(hits)) // 2 if hits else lo + size // 2
    start = min(max(lo, mid - size // 2), hi - size + 1)
    return max(lo, start), min(hi, start + size - 1)


def fname(lines, d):
    m = NAME.search(lines[d])
    return m.group(1) if m else None


def block(files, path, lo, hi, label):
    lines = files.lines(path)
    out = [f"### {path}:{lo + 1}-{hi + 1} — {label}"]
    out += [f"{n + 1}| {lines[n][:LINE_CHARS]}" for n in range(lo, hi + 1)]
    return out


def size(block_lines):
    return sum(len(l) + 1 for l in block_lines)


def env_mode(files, prompt, root):
    tokens = [t for t in dict.fromkeys(ENV_TOKEN.findall(prompt)) if len(t) > 5]
    if not tokens:
        return None
    blocks, seen = [], set()
    for token in tokens[:2]:
        sites = []
        for hit in rg(root, "-w", "-F", token):
            path, line, text = hit.split(":", 2)
            if files.code(path) and not is_comment(text) and not files.is_test(path, int(line) - 1):
                sites.append((path, int(line) - 1))
        if not sites:
            continue
        for path, i in sorted(dict.fromkeys(sites))[:2]:
            lines = files.lines(path)
            decls, ends = decls_of(lines), {}
            cs = chain(lines, decls, ends, i)
            if not cs:
                continue
            d = cs[0]
            lo, hi = window(with_docs(lines, d), ends[d], [i], ENV_REGION)
            if (path, lo) in seen:
                continue
            seen.add((path, lo))
            blocks.append((0, block(files, path, lo, hi, f"reads {token}")))
            body = "\n".join(lines[d:ends[d] + 1])
            own = fname(lines, d)
            callees, frontier, depth_of = [], [d], {}
            for _depth in range(2):
                found = []
                for f in frontier:
                    if f not in ends:
                        ends[f] = decl_end(lines, f)
                    body = "\n".join(lines[f:ends[f] + 1])
                    for name in dict.fromkeys(re.findall(r"\b([a-z_]\w*)\s*\(", body)):
                        if name == own:
                            continue
                        for e in decls:
                            if fname(lines, e) == name and e not in callees and e != d and indent(lines[e]) <= indent(lines[d]) + 4:
                                callees.append(e)
                                depth_of[e] = _depth
                                found.append(e)
                                break
                frontier = found
            for e in sorted(callees)[:4]:
                if e not in ends:
                    ends[e] = decl_end(lines, e)
                clo, chi = window(with_docs(lines, e), ends[e], [], 56)
                if (path, clo) not in seen:
                    seen.add((path, clo))
                    blocks.append((2 + depth_of[e], block(files, path, clo, chi, f"callee of {own}")))
            stemfile = os.path.splitext(os.path.basename(path))[0]
            pat = rf"\b{re.escape(stemfile)}::{re.escape(own)}\s*\(" if own else None
            calls = [h for h in (rg(root, pat) if pat else []) if files.code(h.split(":", 2)[0])]
            if not calls and own and len(own) > 5:
                calls = [h for h in rg(root, rf"\b{re.escape(own)}\s*\(") if files.code(h.split(":", 2)[0])
                         and not DECL.match(h.split(":", 2)[2]) and not is_comment(h.split(":", 2)[2])]
            for hit in calls[:2]:
                cpath, cline, _ = hit.split(":", 2)
                clines = files.lines(cpath)
                cdecls, cends = decls_of(clines), {}
                ccs = chain(clines, cdecls, cends, int(cline) - 1)
                if not ccs:
                    continue
                e = ccs[0]
                clo, chi = window(with_docs(clines, e), cends[e], [int(cline) - 1], 56)
                if (cpath, clo) not in seen:
                    seen.add((cpath, clo))
                    blocks.append((1, block(files, cpath, clo, chi, f"calls {own}, where the loaded values take effect")))
    return blocks


def stems_of(prompt, files):
    out = []
    for word in dict.fromkeys(re.findall(r"[A-Za-z]{4,}", prompt)):
        w = word.lower()
        if w in QUESTION_WORDS:
            continue
        for suffix in ("ing", "ed", "es", "s"):
            if len(w) > 5 and w.endswith(suffix):
                w = w[: -len(suffix)]
                break
        out.append(w)
    return list(dict.fromkeys(out))


def parts_of(text):
    out = set()
    for ident in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", text):
        for part in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+", ident):
            out.add(part.lower())
    return out


def hit_weight(text, stem):
    s = text.strip()
    if re.match(rf"(?i)(pub(\([^)]*\))?\s+)?\w*{re.escape(stem)}\w*\s*:", s):
        return 0.3   # a field declaration or initialiser: plumbing, not application
    if re.search(rf"(?i)\w*{re.escape(stem)}\w*\s*\(", s) or re.search(r"\b(if|while|match|&&|\|\|)\b", s):
        return 2.0   # a call or a condition: the value takes effect
    return 1.0


def sites_mode(files, prompt, root):
    if not (WHERE.search(prompt) and SUBJECT.search(prompt)):
        return None
    ncode = max(1, sum(files.code(f) for f in files.tracked))
    keep = {}
    stems = stems_of(prompt, files)
    if not stems:
        return None
    found = [h.split(":", 2) for h in rg(root, "-i", "-F", *[a for stem in stems for a in ("-e", stem)])]
    found = [(h[0], int(h[1]) - 1, h[2]) for h in found if len(h) == 3 and files.code(h[0])]
    for stem in stems:
        hits = [h for h in found if stem in h[2].lower()]
        hits = [h for h in hits if not is_comment(h[2]) and h[1] < len(files.lines(h[0])) and not files.is_test(h[0], h[1])
                and (stem in parts_of(h[2]) or stem + "s" in parts_of(h[2]) or stem + "ed" in parts_of(h[2]))]
        nfiles = len({h[0] for h in hits})
        declared = re.compile(rf"(?i)\b(?:fn|struct|enum|trait|class|def|const|static|let|var|type|func|function)\s+(?:mut\s+)?\w*{re.escape(stem)}|"
                              rf"^\s*(?:pub(?:\([^)]*\))?\s+)?\w*{re.escape(stem)}\w*\s*:\s*[A-Za-z&]")
        if not any(declared.search(h[2]) for h in hits):
            continue
        if 2 <= len(hits) and 1 <= nfiles <= max(4, ncode * 0.15):
            keep[stem] = hits
    if not keep:
        return None
    for stem, hits in sorted(keep.items()):
        hop = set()
        for path, i, text in hits:
            for name, args in re.findall(r"\b([a-z_]\w*)\s*\(([^()]*)\)", re.sub(r'"[^"]*"', '""', text)):
                if re.search(rf"(?i)(?<![A-Za-z0-9_]){re.escape(stem)}(?![A-Za-z0-9_])", args):
                    hop.add(name)
        for name in sorted(hop):
            extra = [h for h in rg(root, "-w", "-F", name) if files.code(h.split(":", 2)[0])]
            extra = [(h.split(":", 2)[0], int(h.split(":", 2)[1]) - 1, h.split(":", 2)[2]) for h in extra]
            extra = [h for h in extra if not is_comment(h[2]) and h[1] < len(files.lines(h[0])) and not files.is_test(h[0], h[1])]
            keep.setdefault("%" + name, [])
            keep["%" + name] += extra
    regions = {}
    for stem, hits in keep.items():
        weight = 1.0
        for path, i, text in hits:
            stem = stem.lstrip("%")
            lines = files.lines(path)
            decls, ends = decls_of(lines), {}
            cs = chain(lines, decls, ends, i)
            if not cs:
                continue
            pick = cs[0]
            for d in reversed(cs):   # the outermost definition that names the stem and is small enough
                if stem in lines[d].lower() and ends[d] - d + 1 <= 48:
                    pick = d
                    break
            r = regions.setdefault((path, pick), {"hits": set(), "stems": set(), "end": ends[pick], "named": False})
            r["hits"].add(i)
            r["stems"].add(stem)
            r["w"] = r.get("w", 0.0) + weight * hit_weight(text, stem)
            if stem in lines[pick].lower():
                r["named"] = True
                r["type"] = bool(re.match(r"\s*(pub(\([^)]*\))?\s+)?(struct|enum|impl|trait|class|interface|object)\b", lines[pick]))
    ranked = sorted(regions.items(), key=lambda kv: (-(kv[1]["w"] - (3 if kv[1]["end"] - kv[0][1] < 10 and not kv[1].get("type") else 0) + (3 if kv[1].get("type") else 0) + 0.5 * len(kv[1]["stems"])), kv[0]))
    blocks, perfile, used = [], {}, 0
    if os.environ.get("K_DEBUG"):
        for (path, d), r in ranked[:22]:
            sys.stderr.write(f"{r['w']:.1f} {r.get('type')} {r['named']} {sorted(r['stems'])} {path}:{d + 1}-{r['end'] + 1} {sorted(h + 1 for h in r['hits'])}\n")
    for (path, d), r in ranked:
        if perfile.get(path, 0) >= 3 or len(blocks) >= 8 or r["end"] - d < 2:
            continue
        lines = files.lines(path)
        lo, hi = window(with_type(lines, with_docs(lines, d)), r["end"], sorted(r["hits"]), 40 if r["named"] else SITE_REGION if len(blocks) < 4 else 16)
        b = block(files, path, lo, hi, f"names {'/'.join(sorted(r['stems']))}")
        if used + size(b) > BUDGET_SITES:
            continue
        used += size(b)
        perfile[path] = perfile.get(path, 0) + 1
        blocks.append(b)
    return blocks


def main():
    req = json.load(sys.stdin)
    root, prompt = req["repo_root"], req["prompt"]
    files = Files(root)
    env = env_mode(files, prompt, root)
    sites = None if env else sites_mode(files, prompt, root)
    blocks = env or sites
    if not blocks:
        return
    if env:
        keep_ids, used = set(), 0
        for n, (prio, b) in sorted(enumerate(blocks), key=lambda x: (x[1][0], x[0])):
            if used + size(b) <= BUDGET_ENV:
                keep_ids.add(n)
                used += size(b)
        blocks = [b for n, (_, b) in enumerate(blocks) if n in keep_ids]
        shown_paths = sorted({b[0][4:].split(":")[0] for b in blocks})
        print("drop: " + DOCY.pattern)
        for path in shown_paths:
            print("drop: ^" + re.escape(path) + r":\d+-\d+ — (file named|whole file)")
    if sites and not env:
        stems = sorted({w for b in blocks for w in re.findall(r"names (\S+)", b[0])[0].replace("%", "").split("/")})
        print("drop: ^config registry|^(?!.*(?:" + "|".join(re.escape(x) for x in stems) + "))")
        print("drop: " + DOCY.pattern)
    for b in blocks:
        print("\n".join(b))


main()
