"""workspace-overview: two questions a manifest answers in a few lines.

* "What does X do and which crates/packages make up the workspace?": one line per workspace member (path, package
  name when it differs, one-line description) and the README's lead paragraph, cut to a few sentences.
* "<member> questions": that member's description, its
  internal and external dependency names (names only) and its tracked source files.

Workspaces are read from the manifests when the probe runs: Cargo `[workspace].members`, package.json
`workspaces`, `pnpm-workspace.yaml`, `go.work` (or several `go.mod`), pyproject `[tool.uv.workspace]`. No name is
written here. Read-only (tracked files via `git ls-files`), no network, sorted output, nothing printed when the
repository is no workspace or the prompt asks about neither."""
import fnmatch
import json
import re
import subprocess
import sys

try:
    import tomllib
except ImportError:   # python < 3.11: nothing to say rather than a guess
    sys.exit(0)

MAX_MEMBERS = 40
DESC_CHARS = 80
LEAD_CHARS = 380
NAMES_PER_LINE = 14
SRC_NAMES = 16
MEMBER_NOUNS = r"(?:crates?|packages?|modules?|libraries|library|libs?|members?|workspaces?)"
OVERVIEW = re.compile(r"(?i)\b(workspaces?|monorepo|crates|packages|members|made up|make up|consists?|"
                      r"overview|layout|structure)\b")


def git_files(root):
    done = subprocess.run(["git", "-C", root, "ls-files", "-z"], capture_output=True, timeout=10)
    return sorted(f for f in done.stdout.decode(errors="replace").split("\0") if f)


def read(root, rel):
    try:
        with open(f"{root}/{rel}", encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return ""


def toml(root, rel):
    try:
        return tomllib.loads(read(root, rel))
    except tomllib.TOMLDecodeError:
        return {}


def one_line(text, limit=DESC_CHARS):
    text = " ".join(str(text or "").split())
    if len(text) <= limit:
        return text
    cut = text[:limit].rsplit(" ", 1)[0].rstrip(",;:-")
    return cut + "..."


def expand(patterns, dirs):
    """The directories (of `dirs`) matching workspace globs; `!x` excludes."""
    keep, drop = [], []
    for pattern in patterns:
        negated = pattern.startswith("!")
        glob = pattern.lstrip("!").strip("/").removeprefix("./").replace("**", "*")
        (drop if negated else keep).append(glob)
    return [d for d in dirs if any(fnmatch.fnmatchcase(d, g) for g in keep)
            and not any(fnmatch.fnmatchcase(d, g) for g in drop)]


def yaml_list(text, key):
    out, inside = [], False
    for line in text.splitlines():
        if re.match(rf"^{key}\s*:", line):
            inside = True
        elif inside and re.match(r"^\s*-\s*", line):
            out.append(re.sub(r"^\s*-\s*", "", line).split(" #")[0].strip().strip("'\""))
        elif inside and line.strip() and not line.startswith((" ", "#")):
            inside = False
    return out


def dep_name(spec):
    return re.split(r"[\s<>=!~;\[(@]", spec.strip(), maxsplit=1)[0]



def cargo_member(root, rel, ws_package):
    doc = toml(root, f"{rel}/Cargo.toml" if rel else "Cargo.toml")
    package = doc.get("package")
    if not package:
        return None
    desc = package.get("description")
    if isinstance(desc, dict):
        desc = ws_package.get("description")
    deps, dev = {}, {}
    for table, into in (("dependencies", deps), ("build-dependencies", deps), ("dev-dependencies", dev)):
        for key, value in (doc.get(table) or {}).items():
            internal = isinstance(value, dict) and "path" in value
            into[key] = internal
    return {"path": rel or ".", "name": package.get("name", rel), "desc": desc, "deps": deps, "dev": dev}


def npm_member(root, rel):
    doc = json.loads(read(root, f"{rel}/package.json" if rel else "package.json") or "{}")
    if not doc.get("name"):
        return None
    deps = {k: False for k in list(doc.get("dependencies") or {}) + list(doc.get("peerDependencies") or {})
            + list(doc.get("optionalDependencies") or {})}
    dev = {k: False for k in (doc.get("devDependencies") or {})}
    return {"path": rel or ".", "name": doc["name"], "desc": doc.get("description"), "deps": deps, "dev": dev}


def go_member(root, rel):
    text = read(root, f"{rel}/go.mod" if rel else "go.mod")
    module = re.search(r"^module\s+(\S+)", text, re.M)
    if not module:
        return None
    deps = {}
    for block in re.findall(r"^require\s*\((.*?)^\)", text, re.M | re.S):
        for line in block.splitlines():
            if line.strip() and "// indirect" not in line:
                deps[line.split()[0]] = False
    for line in re.findall(r"^require\s+([^\s(]\S*)\s+\S+(?!.*// indirect)", text, re.M):
        deps[line] = False
    return {"path": rel or ".", "name": module.group(1), "desc": None, "deps": deps, "dev": {}}


def py_member(root, rel):
    doc = toml(root, f"{rel}/pyproject.toml" if rel else "pyproject.toml")
    project = doc.get("project")
    if not project or not project.get("name"):
        return None
    deps = {dep_name(s): False for s in project.get("dependencies") or []}
    dev = {}
    for group in (doc.get("dependency-groups") or {}).values():
        dev.update({dep_name(s): False for s in group if isinstance(s, str)})
    return {"path": rel or ".", "name": project["name"], "desc": project.get("description"), "deps": deps, "dev": dev}


def discover(root, files):
    """``(ecosystem, [member dict])`` of the repository's workspace, or ``("", [])``."""
    dirs = lambda manifest: sorted({f.rsplit("/", 1)[0] if "/" in f else "" for f in files
                                    if f == manifest or f.endswith("/" + manifest)} - {""})
    cargo = toml(root, "Cargo.toml").get("workspace")
    if cargo and cargo.get("members"):
        ws_package = cargo.get("package") or {}
        picked = expand(cargo["members"], dirs("Cargo.toml"))
        picked = [d for d in picked if not any(fnmatch.fnmatchcase(d, e.strip("/")) for e in cargo.get("exclude") or [])]
        members = [cargo_member(root, d, ws_package) for d in picked[:MAX_MEMBERS]]
        top = cargo_member(root, "", ws_package)
        return "cargo", ([top] if top else []) + [m for m in members if m]
    try:
        npm = json.loads(read(root, "package.json") or "{}").get("workspaces")
    except ValueError:
        npm = None
    if isinstance(npm, dict):
        npm = npm.get("packages")
    npm = npm or yaml_list(read(root, "pnpm-workspace.yaml"), "packages")
    if npm:
        members = [npm_member(root, d) for d in expand(npm, dirs("package.json"))[:MAX_MEMBERS]]
        return "npm", [m for m in members if m]
    uv = (toml(root, "pyproject.toml").get("tool") or {}).get("uv", {}).get("workspace")
    if uv and uv.get("members"):
        picked = expand(uv["members"], dirs("pyproject.toml"))
        picked = [d for d in picked if not any(fnmatch.fnmatchcase(d, e.strip("/")) for e in uv.get("exclude") or [])]
        members = [py_member(root, d) for d in picked[:MAX_MEMBERS]]
        top = py_member(root, "")
        return "python", ([top] if top else []) + [m for m in members if m]
    work = read(root, "go.work")
    uses = re.findall(r"^use\s+(\S+)$", work, re.M)
    for block in re.findall(r"^use\s*\((.*?)^\)", work, re.M | re.S):
        uses += [line.split("//")[0].strip() for line in block.splitlines() if line.split("//")[0].strip()]
    if uses:
        members = [go_member(root, u.removeprefix("./").strip("/").replace(".", "")) for u in uses[:MAX_MEMBERS]]
        return "go", [m for m in members if m]
    return "", []



def readme_lead(root, files):
    names = [f for f in files if "/" not in f and re.match(r"(?i)readme(\.(md|markdown|rst|txt))?$", f)]
    if not names:
        return ""
    lines = read(root, names[0]).splitlines()
    para, started = [], False
    for index, line in enumerate(lines):
        text = line.strip()
        nxt = lines[index + 1].strip() if index + 1 < len(lines) else ""
        title = bool(re.fullmatch(r"[=\-~]{3,}", nxt)) and not para
        skip = (not text or text.startswith(("#", "![", "[![", "<", ">", "|", "```", "* ", "- ", "["))
                or re.fullmatch(r"[=\-~*_]{3,}", text) or title or re.match(r"(?i)(dual-)?licensed", text))
        if skip:
            if started:
                break
            continue
        started = True
        para.append(text)
    text = " ".join(para)
    if len(text) > LEAD_CHARS:
        cut = text[:LEAD_CHARS]
        end = max(cut.rfind(". "), cut.rfind("? "))
        text = cut[:end + 1] if end > 120 else cut.rsplit(" ", 1)[0] + "..."
    return text


def names_line(label, names, internal=None):
    if not names:
        return ""
    names = sorted(names)
    shown = ", ".join(names[:NAMES_PER_LINE]) + (f" +{len(names) - NAMES_PER_LINE} more" if len(names) > NAMES_PER_LINE else "")
    return f"{label}: {shown}"


def member_block(root, member, members, files):
    member_names = {m["name"].replace("_", "-").lower() for m in members}
    split = lambda table: (sorted(n for n, internal in table.items() if internal or n.replace("_", "-").lower() in member_names),
                           sorted(n for n, internal in table.items() if not (internal or n.replace("_", "-").lower() in member_names)))
    inner, outer = split(member["deps"])
    dev_inner, dev_outer = split(member["dev"])
    where = member["path"]
    title = where if member["name"] == where.rsplit("/", 1)[-1] else f"{where} [{member['name']}]"
    out = [f"### {title}" + (f" — {one_line(member['desc'], 100)}" if member["desc"] else "")]
    for line in (names_line("depends on (workspace)", inner), names_line("depends on (external)", outer),
                 names_line("dev (workspace)", dev_inner), names_line("dev (external)", dev_outer)):
        if line:
            out.append(line)
    prefix = "" if where == "." else where + "/"
    src = [f[len(prefix):] for f in files if f.startswith(prefix) and not f[len(prefix):].startswith(("tests/", "test/", "benches/", "examples/"))
           and re.search(r"\.(rs|py|go|ts|tsx|js|jsx|mjs|rb|java|kt|c|h|cc|cpp|hpp)$", f)]
    if where == ".":
        src = [f for f in src if f.count("/") <= 1]
    if src:
        shown = ", ".join(src[:SRC_NAMES]) + (f" +{len(src) - SRC_NAMES} more" if len(src) > SRC_NAMES else "")
        out.append(f"files: {shown}")
    return out


def named_members(prompt, members):
    """Members the prompt names: the full package name (`grep-cli`, `@scope/pkg`), or a short name beside a noun
    such as crate or package (`the grep crate`, `crate grep`)."""
    found = []
    for member in members:
        if member["path"] == ".":
            continue
        base = member["path"].rsplit("/", 1)[-1]
        shorts = {member["name"], base}
        hit = False
        for short in shorts:
            pat = re.escape(short)
            if re.search(rf"(?<![\w/@.-]){pat}(?![\w-])", prompt) and short == member["name"] and (
                    "-" in short or "/" in short or "_" in short):
                hit = True
            if re.search(rf"(?i)(?<![\w-]){pat}(?:'s)?\s+{MEMBER_NOUNS}\b|\b{MEMBER_NOUNS}\s+[`'\"]?{pat}(?![\w-])", prompt):
                hit = True
        if hit:
            found.append(member)
    return found


def main():
    req = json.load(sys.stdin)
    root, prompt = req["repo_root"], req["prompt"]
    try:
        files = git_files(root)
        kind, members = discover(root, files)
    except (OSError, subprocess.SubprocessError, ValueError):
        return
    if len([m for m in members if m["path"] != "."]) < 2:
        return
    named = named_members(prompt, members)
    if named:
        for member in named[:2]:
            print("\n".join(member_block(root, member, members, files)))
        return
    if not OVERVIEW.search(prompt):
        return
    print(f"### workspace — {len([m for m in members if m['path'] != '.'])} members ({kind})")
    for member in members:
        base = member["path"].rsplit("/", 1)[-1]
        tag = f" [{member['name']}]" if member["name"] != base and member["path"] != "." else ""
        desc = member["desc"]
        if member["path"] == ".":
            print(f". [{member['name']}] (root)" + (f" — {one_line(desc, 70)}" if desc else ""))
            continue
        print(f"{member['path']}{tag}" + (f" — {one_line(desc)}" if desc else ""))
    lead = readme_lead(root, files)
    if lead:
        print("### README — lead")
        print(lead)


main()
