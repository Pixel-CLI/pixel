"""name-files: two locators the brief lacks. (a) Adjacent prompt words joined into a code name ("smart case" ->
SmartCase, smart_case, smart-case) located with one ripgrep pass over every compound, the definition shown.
(b) Source files whose stem is a word of the prompt ("config" -> flags/config.rs), shown whole when short.
Blocks of the brief that share no content word with the prompt are dropped. Read-only (rg, file reads),
deterministic."""
import concurrent.futures
import json
import os
import re
import selectors
import stat
import subprocess
import sys
import time
from pathlib import Path

STOP = {"what", "where", "which", "that", "this", "with", "from", "does", "the", "and", "how", "is", "a", "of", "it",
        "defined", "define", "number", "returns", "return", "set", "get", "use", "used", "make", "could", "there"}
GENERIC = {"for", "to", "in", "on", "my", "its", "keep", "file", "line", "code", "thing", "error", "change", "nothing",
           "make", "read", "ignored", "get", "files", "lines", "work", "works", "happens", "nothing", "time"}
SRC = ("*.rs", "*.ts", "*.tsx", "*.js", "*.py", "*.go", "*.rb")
FILE_LINES, DEFINITION_LINES, MAX_FILE_LINES = 180, 60, 220
MODULE_FILE_LINES, MAX_MODULES, MAX_MODULE_REFS = 24, 2, 8
MODULE_SCAN_MS, MODULE_SCAN_ROWS, MODULE_SCAN_BYTES, MODULE_OUT_CHARS = 700, 400, 250_000, 3_000
TRACKED_MAX_BYTES, TRACKED_MAX_FILES, MODULE_FILE_MAX_BYTES = 2_000_000, 20_000, 250_000
MODULE_INTENT = re.compile(r"\b(?:parts?|functions?|modules?|files?|depend(?:s|ed|ing)?)\b", re.I)
MODULE_REFERENCE = re.compile(r"\b(?:mod|use|import|from|require|include)\b|::", re.I)
TEST_PATH = re.compile(r"(?:^|/)(?:tests?|__tests__|spec)(?:/|$)|(?:^|/)(?:test|spec)[^/]*\.", re.I)


def stem(word):
    word = word.lower()
    for suffix in ("ing", "es", "s"):
        if len(word) > 4 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def words(text):
    parts = re.findall(r"[A-Za-z][a-z]+|[A-Z]+(?![a-z])", text)
    return {stem(p) for p in parts if len(p) > 2 and p.lower() not in STOP and p.lower() not in GENERIC}


def identifier_parts(text):
    """Tokenize an identifier or phrase, normalizing ordinary English plurals consistently."""
    out = []
    for raw in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", text):
        word = raw.lower()
        if len(word) > 4 and word.endswith("ies"):
            word = word[:-3] + "y"
        elif len(word) > 5 and word.endswith(("ches", "shes", "sses", "xes", "zes")):
            word = word[:-2]
        elif len(word) > 3 and word.endswith("s") and not word.endswith("ss"):
            word = word[:-1]
        if len(word) > 2:
            out.append(word)
    return out


def safe_source(root, rel):
    """A tracked regular source file whose resolved path stays under the repository root."""
    base = Path(root).resolve()
    relative = Path(rel)
    if relative.is_absolute() or ".." in relative.parts:
        return False
    try:
        path = base
        for part in relative.parts:
            path = path / part
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode):
                return False
        return stat.S_ISREG(info.st_mode)
    except OSError:
        return False


def tracked_stage_rows(root):
    """Read a bounded prefix of git's index records; no worktree/untracked paths are admitted."""
    proc = selector = None
    try:
        proc = subprocess.Popen(["git", "ls-files", "--stage", "-z"], cwd=root, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)
        os.set_blocking(proc.stdout.fileno(), False)
        raw = bytearray()
        deadline = time.monotonic() + 0.5
        while time.monotonic() < deadline and len(raw) < TRACKED_MAX_BYTES:
            ready = selector.select(max(0.0, min(0.05, deadline - time.monotonic())))
            if not ready:
                if proc.poll() is not None:
                    break
                continue
            chunk = os.read(proc.stdout.fileno(), min(65_536, TRACKED_MAX_BYTES - len(raw)))
            if not chunk:
                break
            raw.extend(chunk)
        records = bytes(raw).split(b"\0")
        if not raw.endswith(b"\0"):
            records.pop()
        return records[:TRACKED_MAX_FILES]
    except (OSError, subprocess.SubprocessError):
        return []
    finally:
        if proc is not None:
            if proc.poll() is None:
                proc.kill()
            try:
                proc.wait(timeout=0.1)
            except subprocess.SubprocessError:
                pass
            if proc.stdout is not None:
                proc.stdout.close()
        if selector is not None:
            selector.close()


def module_paths(root, prompt, stage_rows):
    """Tracked source filenames sharing at least two prompt words, for explicit module/use questions."""
    if not MODULE_INTENT.search(prompt):
        return []
    prompt_words = set(identifier_parts(prompt)) - STOP
    if len(prompt_words) < 2:
        return []
    candidates = []
    for row in stage_rows:
        if not row:
            continue
        meta, sep, raw_path = row.partition(b"\t")
        if not sep or not meta.startswith((b"100644 ", b"100755 ")):
            continue
        try:
            rel = raw_path.decode("utf-8")
        except UnicodeDecodeError:
            continue
        path = Path(rel)
        if path.suffix.lower() not in {ext[1:] for ext in SRC} or TEST_PATH.search(rel):
            continue
        parts = set(identifier_parts(path.stem))
        shared = parts & prompt_words
        if len(parts) >= 2 and len(shared) >= 2 and safe_source(root, rel):
            candidates.append((-len(shared), len(parts) - len(shared), rel, path.stem))
    candidates.sort()
    return [(rel, name) for _overlap, _extra, rel, name in candidates[:MAX_MODULES]]


def module_references(root, modules, tracked_sources):
    """Bounded rg search over tracked regular source paths for actual module imports/uses."""
    if not modules or not tracked_sources:
        return []
    args = ["rg", "--sort", "path", "-j", "1", "-n", "--no-heading", "--color", "never", "-F", "-m", "2",
            "-M", "1200", "--no-max-columns-preview"]
    for name in modules:
        args.extend(("-e", name))
    started = time.monotonic()
    proc = selector = None
    try:
        proc = subprocess.Popen(args + ["--", *tracked_sources], cwd=root, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)
        os.set_blocking(proc.stdout.fileno(), False)
        rows, buffer, count = [], bytearray(), 0
        deadline = started + MODULE_SCAN_MS / 1000
        while time.monotonic() < deadline and len(rows) < MODULE_SCAN_ROWS and count < MODULE_SCAN_BYTES:
            ready = selector.select(max(0.0, min(0.05, deadline - time.monotonic())))
            if not ready:
                if proc.poll() is not None:
                    break
                continue
            chunk = os.read(proc.stdout.fileno(), min(65_536, MODULE_SCAN_BYTES - count))
            if not chunk:
                break
            count += len(chunk)
            buffer.extend(chunk)
            while b"\n" in buffer and len(rows) < MODULE_SCAN_ROWS:
                raw, _, remain = buffer.partition(b"\n")
                buffer = bytearray(remain)
                if len(raw) <= 1_300:
                    rows.append(raw.decode("utf-8", errors="replace"))
        if proc.poll() is None:
            proc.kill()
        proc.wait(timeout=0.1)
    except (OSError, subprocess.SubprocessError):
        return []
    finally:
        if proc is not None:
            if proc.poll() is None:
                proc.kill()
            try:
                proc.wait(timeout=0.1)
            except subprocess.SubprocessError:
                pass
            if proc.stdout is not None:
                proc.stdout.close()
        if selector is not None:
            selector.close()
    refs = []
    for row in rows:
        parts = row.split(":", 2)
        if len(parts) != 3 or not parts[1].isdigit():
            continue
        rel, number, text = parts[0].removeprefix("./"), int(parts[1]), parts[2]
        module = next((name for name in modules if name in text), None)
        if not module or TEST_PATH.search(rel) or not MODULE_REFERENCE.search(text) or not safe_source(root, rel):
            continue
        refs.append((rel, number, text, module))
    refs.sort(key=lambda ref: (ref[0], ref[1]))
    selected = []
    paths = set()
    for ref in refs:
        if ref[0] in paths:
            continue
        selected.append(ref)
        paths.add(ref[0])
        if len(selected) == MAX_MODULE_REFS:
            break
    return selected


def module_evidence(root, prompt, stage_rows, tracked_sources):
    """A short source excerpt and exact tracked imports for a module named in the prompt."""
    candidates = module_paths(root, prompt, stage_rows)
    if not candidates:
        return []
    modules = [name for _path, name in candidates]
    refs = module_references(root, modules, tracked_sources)
    out, used = [], 0

    def add(block):
        nonlocal used
        text = "\n".join(block)
        cost = len(text) + 1
        if used + cost > MODULE_OUT_CHARS:
            return
        out.extend(block)
        used += cost

    for rel, name in candidates:
        if not safe_source(root, rel):
            continue
        source = bounded_lines(root, rel)
        if source is None:
            continue
        hi = min(len(source), MODULE_FILE_LINES)
        add([f"### {rel}:1-{hi} — module named by the prompt",
             *[f"{i}| {line[:160]}" for i, line in enumerate(source[:hi], 1)]])
    for rel, number, _text, name in refs:
        source = bounded_lines(root, rel)
        if source is None or number > len(source):
            continue
        add([f"### {rel}:{number}-{number} — source reference to {name}",
             f"{number}| {source[number - 1][:160]}"])
    return out


def bounded_lines(root, rel):
    """Read only a small regular tracked file, checking size before reading its contents."""
    if not safe_source(root, rel):
        return None
    path = Path(root) / rel
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MODULE_FILE_MAX_BYTES:
            os.close(fd)
            return None
        with os.fdopen(fd, "rb") as source:
            raw = source.read(MODULE_FILE_MAX_BYTES + 1)
        if len(raw) > MODULE_FILE_MAX_BYTES:
            return None
        return raw.decode("utf-8", errors="replace").splitlines()
    except OSError:
        return None


def rg(root, *args):
    """Lines of `rg`; without ripgrep (or past its time) the probe has nothing to say."""
    try:
        return subprocess.run(["rg", "--sort", "path", "--glob", "!.pixel", *args], cwd=root,
                              capture_output=True, text=True, timeout=10).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []


def body(path, lo, count):
    try:
        source = Path(path).read_text(errors="replace").splitlines()
    except OSError:
        return []
    hi = min(len(source), lo + count - 1)
    return [f"{i}| {source[i - 1][:160]}" for i in range(lo, hi + 1)]


def common_dirs(a, b):
    """Leading directories two paths share: a file named by a prompt word is a lead only beside what the brief shows."""
    shared = 0
    for x, y in zip(Path(a).parent.parts, Path(b).parent.parts):
        if x != y:
            break
        shared += 1
    return shared


def compounds(prompt):
    tokens = re.findall(r"[a-z]+", prompt.lower())
    out = []
    for a, b in zip(tokens, tokens[1:]):
        if {a, b} & (STOP | GENERIC) or len(a) < 3 or len(b) < 3:
            continue
        out.append((a.capitalize() + b.capitalize(), f"{a}_{b}", f"{a}-{b}"))
    return out


def definitions(root, pairs, globs):
    """One ripgrep pass for every compound's definition, grouped by pair index.

    The old loop spawned one `rg` per compound, each scanning the whole tree: five compounds paid five
    scans. Every camel and snake spelling joins one alternation here, and the hit is attributed to the
    pair whose spelling it carries (longest spelling first, so `BookingAvailability` wins over a prefix).
    """
    spellings = [(index, word) for index, (camel, snake, _) in enumerate(pairs) for word in (camel, snake)]
    if not spellings:
        return {}
    ordered = sorted({word for _, word in spellings}, key=len, reverse=True)
    pattern = rf"(struct|class|fn|def|const|enum|interface|type)\s+({'|'.join(ordered)})\b"
    found = {}
    for hit in rg(root, "-n", "--no-heading", *globs, pattern, "."):
        parts = hit.split(":", 2)
        if len(parts) < 3:
            continue
        text = parts[2]
        for word in ordered:
            if re.search(rf"\b{re.escape(word)}\b", text):
                for index, spelling in spellings:
                    if spelling == word:
                        found.setdefault(index, []).append((parts[0], parts[1]))
                break
    return found


def main():
    req = json.load(sys.stdin)
    root, prompt, brief = req["repo_root"], req["prompt"], req.get("brief", "")
    globs = sum((["-g", g] for g in SRC), [])
    pairs = compounds(prompt)
    # The two searches are independent scans of one tree; run them together so their I/O overlaps
    # instead of paying the second after the first. The file list is only read for its stems.
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        files = pool.submit(rg, root, "--files", *globs, ".")
        defs = definitions(root, pairs, globs)
        listing = files.result()
    found = []
    for index, (camel, snake, kebab) in enumerate(pairs):
        for path, line in defs.get(index, [])[:2]:
            found.append(f"### {path.lstrip('./')}:{line} — {camel} definition (named by the prompt: '{kebab.replace('-', ' ')}')")
            found += body(Path(root) / path, max(1, int(line) - 3), DEFINITION_LINES)
    stage_rows = tracked_stage_rows(root)
    tracked_sources = []
    for row in stage_rows:
        meta, sep, raw_path = row.partition(b"\t")
        if not sep or not meta.startswith((b"100644 ", b"100755 ")):
            continue
        try:
            rel = raw_path.decode("utf-8")
        except UnicodeDecodeError:
            continue
        if Path(rel).suffix.lower() in {ext[1:] for ext in SRC} and safe_source(root, rel):
            tracked_sources.append(rel)
    found += module_evidence(root, prompt, stage_rows, tracked_sources)
    stems = {w for w in re.findall(r"[a-z]{4,}", prompt.lower()) if w not in STOP and w not in GENERIC}
    near = [h.split(":")[0].split(" ")[0] for h in re.findall(r"^### (\S+)", brief, re.M)]
    candidates = []
    for name in sorted(f.lstrip("./") for f in listing):
        if Path(name).stem.lower() not in stems or "test" in name.lower():
            continue
        shared = max((common_dirs(name, other) for other in near), default=0)
        if shared:
            candidates.append((-shared, name))
    for _, name in sorted(candidates)[:1]:
        path = Path(root) / name
        count = sum(1 for _ in path.open(errors="replace"))
        if count > MAX_FILE_LINES:
            continue
        found.append(f"### {name}:1-{min(count, FILE_LINES)} — file named '{path.stem}' (a word of the prompt)")
        found += body(path, 1, FILE_LINES)
    if not found:
        return
    want = words(prompt)
    added = [h[4:].split(":")[0] for h in found if h.startswith("### ")]
    for block in brief.split("\n### ")[1:]:
        header = block.split("\n", 1)[0]
        path = header.split(":")[0].split(" ")[0]
        # Noise is a block that names none of the prompt's words and lies away from what was just located.
        if not want & words(header) and not any(common_dirs(path, other) for other in added):
            print(f"drop: ^{re.escape(header)}$")
    print("\n".join(found))


main()
