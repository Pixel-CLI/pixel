flowchart TD
    Ask(["🧑 'sync my branch'"])
    Ask --> w1
    Ask --> p1
    w1 ~~~ p1

    subgraph W ["❌ Without pixel — illustrative"]
        direction TB
        w1["🧠 runs git fetch<br/>reasons about ahead/behind<br/>manually merges or rebases<br/>runs git push, handles failure"] --> w5["😬 maybe a merge commit,<br/>maybe a mishandled conflict"]
    end

    subgraph P ["✅ With pixel"]
        direction TB
        p1["⚡ pixel reconcile"] --> p3["✅ classified and acted,<br/>or a clear conflict report<br/>~64ms · ~68 tok (measured)"]
    end

    style W fill:#3a1a1a,stroke:#e05555,color:#fff
    style P fill:#123a1e,stroke:#33c76a,color:#fff
    style w5 fill:#5c1f1f,stroke:#e05555,color:#fff
    style p3 fill:#155229,stroke:#33c76a,color:#fff
    linkStyle 2 stroke-width:0px
