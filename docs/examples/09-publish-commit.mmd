flowchart TD
    Ask(["🧑 'commit this'"])
    Ask --> w1
    Ask --> p1
    w1 ~~~ p1

    subgraph W ["❌ Without pixel — illustrative"]
        direction TB
        w1["🧠 runs git add -A<br/>runs git commit"] --> w5["⚠️ unrelated changes swept in"]
    end

    subgraph P ["✅ With pixel"]
        direction TB
        p1["⚡ pixel publish --files ..."] --> p3["✅ exactly the named files — crash-safe<br/>correctness win, not a speed win"]
    end

    style W fill:#3a1a1a,stroke:#e05555,color:#fff
    style P fill:#123a1e,stroke:#33c76a,color:#fff
    style w5 fill:#5c1f1f,stroke:#e0a555,color:#fff
    style p3 fill:#155229,stroke:#33c76a,color:#fff
    linkStyle 2 stroke-width:0px
