{
  "build": {
    "argv": [
      "$CARGO_REAL",
      "build",
      "--locked",
      "--profile",
      "dev-release",
      "-p",
      "pixel-cli"
    ],
    "env": {
      "CARGO_TARGET_DIR": "$BUILD_DIR",
      "RUSTC_WRAPPER": "",
      "RUSTC_WORKSPACE_WRAPPER": ""
    },
    "exit": 0
  },
  "repeat": {
    "argv": [
      "python3",
      "run.py",
      "--source",
      "$SOURCE",
      "--binary",
      "$BINARY",
      "--home",
      "$PROBE_HOME",
      "--state",
      "$STATE",
      "--out",
      "$FRESH_OUT"
    ],
    "exit": 0
  },
  "under_shared_lock": {
    "argv": [
      "python3",
      "-I",
      "$SOURCE/scripts/bench/tool-census/score_brief.py",
      "pinned",
      "--base",
      "$BINARY",
      "--head",
      "$BINARY",
      "--probe-home",
      "$PROBE_HOME",
      "--questions",
      "$SOURCE/eval/brief-bench/questions.jsonl",
      "--route",
      "hook",
      "--root",
      "$STATE",
      "--out",
      "$FRESH_OUT",
      "--label",
      "integration"
    ],
    "exit": 0
  },
  "expanded_command_sha256": "b49bf317bbe14d938364d2c8005e997ce3722af281073f456757757d2fe9a54a",
  "comparison": {
    "argv": [
      "python3",
      "$REPORT_DIR/compare.py",
      "--source",
      "$SOURCE",
      "--reference",
      "$SOURCE/docs/bench/scorer-protocol-v4-2026-10-19",
      "--pair",
      "$FRESH_OUT",
      "--out",
      "$COMPARISON_OUT"
    ],
    "exit": 0
  }
}
