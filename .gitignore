/target
**/*.rs.bk
.DS_Store
.pixel/
# Legacy RTO repository state stays ignored during the identity transition.
.rto/
.pixel-graph-head
.pi-ultimate/
.devin/

# tool-local agent config dirs
# Tool-local config stays out, the committed rules symlink stays in.
.claude/*
!.claude/rules
!.claude/skills
.codex/
.cursor/*
!.cursor/rules/
.gemini/
.pi/
.zcode/

# python
__pycache__/
*.pyc

# node
**/node_modules/

# coverage / bench dumps
coverage*.txt
*.lcov
docs/pixel-line-ascii.ppm

# cargo-mutants scratch output
/mutants.out*
# Artifacts the competitor tools write into this tree when scripts/bench-vs runs
# them here. Ignoring them is necessary but not sufficient: pixel's overlay picks up
# files created since the last full build whatever git's ignore rules say, so run
# `pixel build-index` after a bench run to evict them.
.gitnexus/
stacklit.json
stacklit.html
DEPENDENCIES.md
run-artifacts/

# Ad-hoc probe-loop questions, traces and answers stay local.
eval/brief-bench/adhoc/

# The private tool census (#905): its 20 prompts and its database stay on the maintainer's machine.
scripts/bench/tool-census/manifest.json
census.db*

/.arena-reports/
